# SHACL 규칙: 전력설비 자산관리 온톨로지 (examples/asset)
# 실행: python examples/asset/build_asset_ontology.py
# 자산 온톨로지 + examples/power-grid-sample.ttl 을 함께 검증한다 (기능 위치는 CIM 설비).

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix cim:  <http://iec.ch/TC57/CIM100#> .
@prefix pam:  <https://1004aiteam-power.github.io/ontology-space/asset#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix as:   <https://1004aiteam-power.github.io/ontology-space/asset-shapes#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

as:prefixes a owl:Ontology ;
    sh:declare [ sh:prefix "pam" ; sh:namespace "https://1004aiteam-power.github.io/ontology-space/asset#"^^xsd:anyURI ] ,
               [ sh:prefix "cim" ; sh:namespace "http://iec.ch/TC57/CIM100#"^^xsd:anyURI ] .

# ---- 1. 기능 위치마다 지금 설치된 자산이 있어야 한다 (경고) ------------------------
as:LocationHasAssetShape a sh:NodeShape ;
    sh:targetClass cim:PowerTransformer, cim:Breaker, cim:ACLineSegment, cim:BusbarSection ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "설비 자리에 현재 설치된 자산 기록이 없습니다 / no asset is currently installed at this location"@ko ;
        sh:prefixes as:prefixes ;
        sh:select """
            SELECT $this WHERE {
              FILTER NOT EXISTS { ?d pam:atLocation $this . FILTER NOT EXISTS { ?d pam:validTo ?to } }
            }""" ;
    ] .

# ---- 2. 운전 중인 자산은 설치 위치가 정확히 1개 ----------------------------------
as:InServiceAssetShape a sh:NodeShape ;
    sh:targetClass pam:Asset ;
    sh:sparql [
        sh:message "운전 중인 자산은 현재 설치 위치가 정확히 1개여야 합니다 / an in-service asset needs exactly one current location"@ko ;
        sh:prefixes as:prefixes ;
        sh:select """
            SELECT $this WHERE {
              $this pam:status ?s . FILTER(STR(?s) = "운전")
              { SELECT $this (COUNT(?d) AS ?n) WHERE {
                  OPTIONAL { ?d pam:deployedAsset $this . FILTER NOT EXISTS { ?d pam:validTo ?to } } } GROUP BY $this }
              FILTER(?n != 1)
            }""" ;
    ] ;
    sh:property [ sh:path pam:eamNumber ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^EQ-[A-Z]{2}-[0-9]{4}-[0-9]{4}$" ;
                  sh:message "EAM 설비번호는 1개, EQ-종류-연도-번호 형식 / one EAM number in EQ-XX-YYYY-NNNN form"@ko ] .

# ---- 3. 한 위치에 설치 기간이 겹치면 안 된다 ------------------------------------
as:DeploymentShape a sh:NodeShape ;
    sh:targetClass pam:Deployment ;
    sh:property [ sh:path pam:deployedAsset ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pam:Asset ] ;
    sh:property [ sh:path pam:atLocation ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path pam:validFrom ; sh:minCount 1 ; sh:datatype xsd:date ] ;
    sh:sparql [
        sh:message "같은 위치에 설치 기간이 겹치는 다른 자산이 있습니다 / overlapping deployment at the same location"@ko ;
        sh:prefixes as:prefixes ;
        sh:select """
            SELECT $this WHERE {
              $this pam:atLocation ?loc ; pam:validFrom ?f1 . OPTIONAL { $this pam:validTo ?t1 }
              ?o pam:atLocation ?loc ; pam:validFrom ?f2 . OPTIONAL { ?o pam:validTo ?t2 }
              FILTER(?o != $this)
              FILTER((!BOUND(?t2) || ?f1 <= ?t2) && (!BOUND(?t1) || ?f2 <= ?t1))
            }""" ;
    ] .

# ---- 4. 진단 기록은 대상·방법·날짜·판정이 모두 있어야 하고, 방법은 점검이어야 한다 ----------
as:DiagnosisShape a sh:NodeShape ;
    sh:targetClass pam:Diagnosis ;
    sh:property [ sh:path pam:onAsset ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pam:Asset ] ;
    sh:property [ sh:path pam:usesMethod ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pam:InspectionTask ;
                  sh:message "진단 방법은 점검 업무(InspectionTask)여야 합니다 / method must be an inspection task"@ko ] ;
    sh:property [ sh:path pam:date ; sh:minCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path pam:judgement ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( pam:Normal pam:Caution pam:Abnormal ) ] .

# ---- 5. 작업지시: 근거 진단이 있어야 하고, 완료면 완료일이 있어야 한다 -------------------
as:WorkOrderShape a sh:NodeShape ;
    sh:targetClass pam:WorkOrder ;
    sh:property [ sh:path pam:onAsset ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pam:Asset ] ;
    sh:property [ sh:path pam:performs ; sh:minCount 1 ; sh:maxCount 1 ; sh:class pam:MaintenanceTask ] ;
    sh:property [ sh:path pam:triggeredBy ; sh:minCount 1 ; sh:class pam:Diagnosis ;
                  sh:message "작업지시에는 근거가 된 진단 기록이 있어야 합니다 / a work order needs the diagnosis that triggered it"@ko ] ;
    sh:sparql [
        sh:message "완료된 작업지시에 완료일이 없습니다 / completed work order without a completion date"@ko ;
        sh:prefixes as:prefixes ;
        sh:select """SELECT $this WHERE { $this pam:workStatus ?s . FILTER(STR(?s) = "완료") FILTER NOT EXISTS { $this pam:completedDate ?d } }""" ;
    ] .
