    rdfs:label "순천"@ko, "Suncheon"@en ;
    hw:servesZone hw:Z_SUNCHEON ;
    geo:hasGeometry [ geo:asWKT "POINT(127.49 34.95)"^^geo:wktLiteral ] ;
    hw:connectsRoute hw:R_HONAM, hw:R_NAMHAE, hw:R_NR17, hw:R_NR2 ;
    hw:adjacentTo hw:N_GWANGJU, hw:N_JINJU, hw:N_MOKPO, hw:N_NAMWON .
hw:Z_SUNCHEON a hw:Zone ; rdfs:label "순천 존"@ko ; hw:zoneWeight 28 .
hw:N_JINJU a hw:Interchange, hw:Junction ;
    hw:code "JINJU" ;
