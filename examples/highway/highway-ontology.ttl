hw:R_JUNGBU a hw:Expressway ; hw:code "JUNGBU" ; rdfs:label "중부선"@ko, "Jungbu"@en .
hw:R_JUNGBU_NAERYUK a hw:Expressway ; hw:code "JUNGBU_NAERYUK" ; rdfs:label "중부내륙선"@ko, "Jungbu Inland"@en .
hw:R_HONAM a hw:Expressway ; hw:code "HONAM" ; rdfs:label "호남선"@ko, "Honam"@en .
hw:R_NONSAN_CHEONAN a hw:Expressway ; hw:code "NONSAN_CHEONAN" ; rdfs:label "논산천안선"@ko, "Nonsan–Cheonan"@en .
hw:R_NAMHAE a hw:Expressway ; hw:code "NAMHAE" ; rdfs:label "남해선"@ko, "Namhae"@en .
hw:R_TONGYEONG_DAEJEON a hw:Expressway ; hw:code "TONGYEONG_DAEJEON" ; rdfs:label "통영대전선"@ko, "Tongyeong–Daejeon"@en .
hw:R_GWANGJU_DAEGU a hw:Expressway ; hw:code "GWANGJU_DAEGU" ; rdfs:label "광주대구선"@ko, "Gwangju–Daegu"@en .
hw:R_JUNGANG a hw:Expressway ; hw:code "JUNGANG" ; rdfs:label "중앙선"@ko, "Jungang"@en .
hw:R_DONGHAE a hw:Expressway ; hw:code "DONGHAE" ; rdfs:label "동해선"@ko, "Donghae"@en .
hw:R_DAEGU_POHANG a hw:Expressway ; hw:code "DAEGU_POHANG" ; rdfs:label "대구포항선"@ko, "Daegu–Pohang"@en .
hw:R_DANGJIN_YEONGDEOK a hw:Expressway ; hw:code "DANGJIN_YEONGDEOK" ; rdfs:label "당진영덕선"@ko, "Dangjin–Yeongdeok"@en .
hw:R_PYEONGTAEK_JECHEON a hw:Expressway ; hw:code "PYEONGTAEK_JECHEON" ; rdfs:label "평택제천선"@ko, "Pyeongtaek–Jecheon"@en .
hw:R_SEOUL_YANGYANG a hw:Expressway ; hw:code "SEOUL_YANGYANG" ; rdfs:label "서울양양선"@ko, "Seoul–Yangyang"@en .
hw:R_NR1 a hw:NationalRoad ; hw:code "NR1" ; rdfs:label "국도 1호선"@ko, "National Route 1"@en ; hw:routeNumber 1 .
hw:R_NR2 a hw:NationalRoad ; hw:code "NR2" ; rdfs:label "국도 2호선"@ko, "National Route 2"@en ; hw:routeNumber 2 .
hw:R_NR3 a hw:NationalRoad ; hw:code "NR3" ; rdfs:label "국도 3호선"@ko, "National Route 3"@en ; hw:routeNumber 3 .
hw:R_NR4 a hw:NationalRoad ; hw:code "NR4" ; rdfs:label "국도 4호선"@ko, "National Route 4"@en ; hw:routeNumber 4 .
hw:R_NR5 a hw:NationalRoad ; hw:code "NR5" ; rdfs:label "국도 5호선"@ko, "National Route 5"@en ; hw:routeNumber 5 .
hw:R_NR6 a hw:NationalRoad ; hw:code "NR6" ; rdfs:label "국도 6호선"@ko, "National Route 6"@en ; hw:routeNumber 6 .
hw:R_NR7 a hw:NationalRoad ; hw:code "NR7" ; rdfs:label "국도 7호선"@ko, "National Route 7"@en ; hw:routeNumber 7 .
hw:R_NR17 a hw:NationalRoad ; hw:code "NR17" ; rdfs:label "국도 17호선"@ko, "National Route 17"@en ; hw:routeNumber 17 .
hw:R_NR21 a hw:NationalRoad ; hw:code "NR21" ; rdfs:label "국도 21호선"@ko, "National Route 21"@en ; hw:routeNumber 21 .
hw:R_NR38 a hw:NationalRoad ; hw:code "NR38" ; rdfs:label "국도 38호선"@ko, "National Route 38"@en ; hw:routeNumber 38 .
hw:R_NR46 a hw:NationalRoad ; hw:code "NR46" ; rdfs:label "국도 46호선"@ko, "National Route 46"@en ; hw:routeNumber 46 .

### 노드와 존
hw:N_SEOUL a hw:Interchange, hw:Junction ;
    hw:code "SEOUL" ;
    rdfs:label "서울"@ko, "Seoul"@en ;
    hw:servesZone hw:Z_SEOUL ;
    geo:hasGeometry [ geo:asWKT "POINT(127.05 37.50)"^^geo:wktLiteral ] ;
    hw:connectsRoute hw:R_GYEONGBU, hw:R_GYEONGIN, hw:R_JUNGBU, hw:R_NR1, hw:R_NR3, hw:R_NR6, hw:R_SEOHAEAN, hw:R_SEOUL_YANGYANG ;
    hw:adjacentTo hw:N_CHUNCHEON, hw:N_INCHEON, hw:N_PYEONGTAEK, hw:N_SUWON, hw:N_WONJU, hw:N_YEOJU .
hw:Z_SEOUL a hw:Zone ; rdfs:label "서울 존"@ko ; hw:zoneWeight 950 .
hw:N_INCHEON a hw:Interchange, hw:Junction ;
    hw:code "INCHEON" ;
    rdfs:label "인천"@ko, "Incheon"@en ;
    hw:servesZone hw:Z_INCHEON ;
    geo:hasGeometry [ geo:asWKT "POINT(126.70 37.46)"^^geo:wktLiteral ] ;
    hw:connectsRoute hw:R_GYEONGIN, hw:R_YEONGDONG ;
    hw:adjacentTo hw:N_SEOUL, hw:N_SUWON .
hw:Z_INCHEON a hw:Zone ; rdfs:label "인천 존"@ko ; hw:zoneWeight 300 .
hw:N_SUWON a hw:Interchange, hw:Junction ;
