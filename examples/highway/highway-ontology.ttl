    hw:adjacentTo hw:N_DAEGU, hw:N_JEONGEUP, hw:N_JEONJU, hw:N_MOKPO, hw:N_SUNCHEON .
hw:Z_GWANGJU a hw:Zone ; rdfs:label "광주 존"@ko ; hw:zoneWeight 145 .
hw:N_MOKPO a hw:Interchange, hw:Junction ;
    hw:code "MOKPO" ;
    rdfs:label "목포"@ko, "Mokpo"@en ;
    hw:servesZone hw:Z_MOKPO ;
    geo:hasGeometry [ geo:asWKT "POINT(126.40 34.80)"^^geo:wktLiteral ] ;
    hw:connectsRoute hw:R_NAMHAE, hw:R_NR1, hw:R_NR2, hw:R_SEOHAEAN ;
