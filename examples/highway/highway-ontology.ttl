    hw:connectsRoute hw:R_NR1, hw:R_NR38, hw:R_PYEONGTAEK_JECHEON, hw:R_SEOHAEAN ;
    hw:adjacentTo hw:N_CHEONAN, hw:N_CHUNGJU, hw:N_SEOSAN, hw:N_SEOUL, hw:N_SUWON .
