    hw:connectsRoute hw:R_GYEONGBU, hw:R_NR1, hw:R_YEONGDONG ;
    hw:adjacentTo hw:N_CHEONAN, hw:N_INCHEON, hw:N_PYEONGTAEK, hw:N_SEOUL, hw:N_YEOJU .
hw:Z_SUWON a hw:Zone ; rdfs:label "수원·신갈 존"@ko ; hw:zoneWeight 120 .
