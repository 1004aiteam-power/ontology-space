pam:WF_01 a pam:WorkflowStep ;
    pam:code "WF-01" ;
    rdfs:label "작업 요청 등록"@ko ;
    pam:precedes pam:WF_02 .
pam:WF_02 a pam:WorkflowStep ;
    pam:code "WF-02" ;
    rdfs:label "위험도 평가·우선순위 결정"@ko ;
    pam:precedes pam:WF_03 .
