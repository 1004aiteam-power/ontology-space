pam:DEP_05 a pam:Deployment ; pam:deployedAsset pam:AS_LN_0031 ; pam:atLocation ex:ACLS_1 ; pam:validFrom "2008-11-20"^^xsd:date .

### 점검·정비 업무 유형과 정비 업무 흐름
pam:IN_01 a pam:InspectionTask ;
    pam:code "IN-01" ;
    rdfs:label "순시점검"@ko ;
    pam:requiresOutage false ;
    pam:strategy pam:TBM ;
    pam:cycleMonths 1 .
