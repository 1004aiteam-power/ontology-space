# VPP 가상 전력시장 — 개체 데이터. 만든 곳: examples/vpp/build_vpp.mjs (원본: assets/vpp/vpp-graph.js)
# VPP 10 · DER 81 · 배전선로 15 · 시장 시간대 24 · 입찰 168 · 정산 168 · 출력제한 지시 7. 스키마는 vpp-schema.ttl
# 변전소(tw:)는 디지털 트윈(examples/twin/korea_virtual_grid.ttl)의 개체를 그대로 가리킵니다.
# ⚠ 가상 데이터입니다. 회사 · 설비 · 배전선로 · 가격 · 정산 규칙은 개념 설명용이며 실제 제도와 다릅니다.
@prefix vpp: <https://1004aiteam-power.github.io/ontology-space/vpp#> .
@prefix cim: <http://iec.ch/TC57/CIM100#> .
@prefix tw: <http://example.org/kr-twin#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

vpp:MarketOperator a vpp:MarketOperator ;
    rdfs:label "가상 시장운영자"@ko ;
    rdfs:label "Virtual market operator"@en .

vpp:DSO a vpp:DistributionOperator ;
    rdfs:label "가상 배전운영자 (DERMS)"@ko ;
    rdfs:label "Virtual distribution operator (DERMS)"@en .

vpp:DayAheadMarket a vpp:Market ;
    rdfs:label "가상 하루 전 전력시장"@ko ;
    rdfs:label "Virtual day-ahead market"@en ;
    vpp:operatedBy vpp:MarketOperator ;
    vpp:tolerancePct 8.0 .

vpp:Hour00 a vpp:MarketInterval ;
    vpp:hour 0 ;
    vpp:smp 118.0 ;
    rdfs:label "00:00–01:00" ;
    vpp:inMarket vpp:DayAheadMarket .

