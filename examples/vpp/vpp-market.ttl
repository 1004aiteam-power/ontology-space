vpp:AGG_01 a vpp:Aggregator ;
    rdfs:label "햇살모아에너지"@ko ;
    rdfs:label "Haetsal Energy"@en .

vpp:VPP01 a vpp:VirtualPowerPlant ;
    vpp:vppId "VPP01" ;
    rdfs:label "햇살모아 VPP"@ko ;
    rdfs:label "Sunshine VPP"@en ;
    vpp:strategy "태양광만 묶음 (가장 단순)"@ko ;
    vpp:strategy "Solar only (simplest)"@en ;
    vpp:operatedBy vpp:AGG_01 ;
    vpp:participatesIn vpp:DayAheadMarket .

