// VPP 가상 전력시장 — Neo4j 적재 (⚠ 가상 데이터)
// 생성: examples/vpp/build_vpp.mjs  ← 이 파일을 직접 고치지 말 것
// 온톨로지(vpp-schema.ttl + vpp-market.ttl)를 이 사이트의 규칙(rdf:type → 라벨 + 상위 클래스 라벨, 값 → 속성, 개체 연결 → 관계)으로 바꾼 결과입니다.
// Neo4j Browser나 cypher-shell에 그대로 붙여 넣으면 웹페이지(vpp-market.html)의 그래프와 같은 노드 · 관계가 만들어집니다.
// 변전소 5곳은 디지털 트윈(korea_virtual_grid.ttl)의 개체라 이름과 uri만 가져왔습니다.
CREATE CONSTRAINT resource_uri IF NOT EXISTS FOR (r:Resource) REQUIRE r.uri IS UNIQUE;

// DistributionOperator (1)
UNWIND [
  {uri: 'https://1004aiteam-power.github.io/ontology-space/vpp#DSO', label: '가상 배전운영자 (DERMS)', label_en: 'Virtual distribution operator (DERMS)'}
] AS p
MERGE (n:Resource {uri: p.uri}) SET n += p, n:`DistributionOperator`;

// Market (1)
UNWIND [
  {uri: 'https://1004aiteam-power.github.io/ontology-space/vpp#DayAheadMarket', label: '가상 하루 전 전력시장', label_en: 'Virtual day-ahead market', operatedBy: 'MarketOperator', tolerancePct: 8}
] AS p
MERGE (n:Resource {uri: p.uri}) SET n += p, n:`Market`;

