// AI추진부 업무 온톨로지 v0.2 — Neo4j 적재 스크립트
// Neo4j Browser나 cypher-shell에 그대로 붙여 넣어 실행한다(외부 파일 불필요).
// 다시 실행해도 MERGE라 중복이 생기지 않는다. 처음부터 다시 하려면: MATCH (n) DETACH DELETE n;

CREATE CONSTRAINT task_code IF NOT EXISTS FOR (t:Task) REQUIRE t.code IS UNIQUE;
CREATE CONSTRAINT domain_code IF NOT EXISTS FOR (d:Domain) REQUIRE d.code IS UNIQUE;
CREATE CONSTRAINT sub_code IF NOT EXISTS FOR (s:SubDomain) REQUIRE s.code IS UNIQUE;
CREATE CONSTRAINT role_name IF NOT EXISTS FOR (r:Role) REQUIRE r.name IS UNIQUE;
CREATE CONSTRAINT risk_name IF NOT EXISTS FOR (r:Risk) REQUIRE r.name IS UNIQUE;

// 1. 대분류
UNWIND [
  {code: 'ST', name: '전략·기획'},
  {code: 'BD', name: '사업개발·확산'},
  {code: 'TD', name: 'AI 기술개발'},
  {code: 'DM', name: '데이터 관리'},
  {code: 'PM', name: '과제·프로젝트 관리'},
  {code: 'GV', name: 'AI 거버넌스·리스크'},
  {code: 'OC', name: '조직·역량'},
  {code: 'MS', name: '경영지원'},
  {code: 'OP', name: '운영·유지보수'}
] AS row
MERGE (d:Domain {code: row.code}) SET d.name = row.name;

// 2. 중분류
UNWIND [
