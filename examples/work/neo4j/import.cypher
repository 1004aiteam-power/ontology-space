  {code: 'TD-3-2', name: '프롬프트 엔지니어링', domain: 'TD', sub: 'TD-3', lifecycle: '실행', nature: '과제성', cycle: '과제별', condition: '항상', owner: 'AI엔지니어', collab: ['현업'], output: '프롬프트 라이브러리', kpi: '응답 품질 점수', risk: '프롬프트 인젝션', note: ''},
  {code: 'TD-3-3', name: 'RAG 구축', domain: 'TD', sub: 'TD-3', lifecycle: '실행', nature: '과제성', cycle: '과제별', condition: '항상', owner: 'AI엔지니어', collab: ['데이터엔지니어'], output: 'RAG 시스템', kpi: '검색 정확도', risk: '환각', note: ''},
  {code: 'TD-3-4', name: 'AI 에이전트 개발', domain: 'TD', sub: 'TD-3', lifecycle: '실행', nature: '과제성', cycle: '과제별', condition: '다단계 자동화 필요 시', owner: 'AI엔지니어', collab: ['현업'], output: 'AI 에이전트', kpi: '업무 자동화율', risk: '오작동·권한 남용', note: ''},
  {code: 'TD-3-5', name: '파인튜닝', domain: 'TD', sub: 'TD-3', lifecycle: '실행', nature: '과제성', cycle: '과제별', condition: '범용 모델 성능 부족 시', owner: 'AI엔지니어', collab: ['데이터엔지니어'], output: '파인튜닝 모델', kpi: '성능 개선폭', risk: '학습데이터 개인정보', note: ''},
  {code: 'TD-4-1', name: 'ML 파이프라인 구축', domain: 'TD', sub: 'TD-4', lifecycle: '실행', nature: '과제성', cycle: '과제별', condition: '항상', owner: 'AI엔지니어', collab: ['데이터엔지니어'], output: 'ML 파이프라인', kpi: '자동화 단계 비율', risk: '', note: '경계③: 구축은 TD, 운영 중 반복 실행은 OP-3-3'},
  {code: 'TD-4-2', name: '모델 최초 배포', domain: 'TD', sub: 'TD-4', lifecycle: '실행', nature: '과제성', cycle: '과제별', condition: '항상', owner: 'AI엔지니어', collab: ['운영'], output: '배포 기록', kpi: '배포 리드타임', risk: '배포 장애', note: '경계③: 최초 배포까지 TD, 이후 운영 이관'},
  {code: 'TD-4-3', name: '모델 레지스트리·버전관리', domain: 'TD', sub: 'TD-4', lifecycle: '운영', nature: '정기', cycle: '상시', condition: '항상', owner: 'AI엔지니어', collab: [], output: '모델 레지스트리', kpi: '등록률', risk: '추적성 상실', note: ''},
  {code: 'TD-4-4', name: '실험관리', domain: 'TD', sub: 'TD-4', lifecycle: '실행', nature: '정기', cycle: '상시', condition: '항상', owner: 'AI엔지니어', collab: [], output: '실험 로그', kpi: '재현 가능률', risk: '', note: ''},
  {code: 'TD-5-1', name: '신기술 리서치', domain: 'TD', sub: 'TD-5', lifecycle: '기획', nature: '정기', cycle: '월', condition: '항상', owner: 'AI엔지니어', collab: ['전략기획'], output: '리서치 노트', kpi: '리서치 건수', risk: '', note: ''},
  {code: 'TD-5-2', name: '벤치마크 검증', domain: 'TD', sub: 'TD-5', lifecycle: '점검', nature: '수시', cycle: '수시', condition: '항상', owner: 'AI엔지니어', collab: [], output: '벤치마크 결과', kpi: '검증 건수', risk: '', note: ''},
  {code: 'TD-5-3', name: '특허·논문', domain: 'TD', sub: 'TD-5', lifecycle: '종료', nature: '수시', cycle: '수시', condition: '항상', owner: 'AI엔지니어', collab: ['법무'], output: '특허 출원서·논문', kpi: '출원·게재 건수', risk: '', note: ''}
] AS row
MATCH (s:SubDomain {code: row.sub})
MERGE (t:Task {code: row.code})
SET t.name = row.name, t.lifecycle = row.lifecycle, t.nature = row.nature, t.cycle = row.cycle,
    t.condition = row.condition, t.kpi = row.kpi, t.note = row.note
MERGE (t)-[:BELONGS_TO]->(s)
WITH t, row
MATCH (o:Role {name: row.owner})
MERGE (t)-[:OWNED_BY]->(o)
WITH t, row
FOREACH (c IN row.collab | MERGE (r:Role {name: c}) MERGE (t)-[:COLLABORATES_WITH]->(r))
MERGE (a:Artifact {name: row.output})
MERGE (t)-[:PRODUCES]->(a)
FOREACH (_ IN CASE WHEN row.risk <> '' THEN [1] ELSE [] END |
  MERGE (k:Risk {name: row.risk}) MERGE (t)-[:HAS_RISK]->(k));

