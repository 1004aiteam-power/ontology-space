  {code: 'DM-3', name: '데이터 품질', domain: 'DM'},
  {code: 'DM-4', name: '데이터 거버넌스(운영)', domain: 'DM'},
  {code: 'PM-1', name: '착수', domain: 'PM'},
  {code: 'PM-2', name: '계획', domain: 'PM'},
  {code: 'PM-3', name: '실행·통제', domain: 'PM'},
  {code: 'PM-4', name: '종료', domain: 'PM'},
  {code: 'PM-5', name: '포트폴리오(과제 단위)', domain: 'PM'},
  {code: 'GV-1', name: '정책·규정', domain: 'GV'},
  {code: 'GV-2', name: '법규 준수', domain: 'GV'},
  {code: 'GV-3', name: '리스크 관리', domain: 'GV'},
  {code: 'GV-4', name: '보안(정책·통제)', domain: 'GV'},
  {code: 'GV-5', name: '검증·감사', domain: 'GV'},
  {code: 'OC-1', name: '조직설계', domain: 'OC'},
  {code: 'OC-2', name: '인력관리', domain: 'OC'},
  {code: 'OC-3', name: '교육', domain: 'OC'},
  {code: 'OC-4', name: '변화관리', domain: 'OC'},
  {code: 'OC-5', name: '지식관리', domain: 'OC'},
  {code: 'MS-1', name: '예산·재무', domain: 'MS'},
  {code: 'MS-2', name: '구매·계약', domain: 'MS'},
  {code: 'MS-3', name: '벤더관리', domain: 'MS'},
  {code: 'MS-4', name: '회의·보고', domain: 'MS'},
  {code: 'MS-5', name: '문서·행정', domain: 'MS'},
  {code: 'OP-1', name: '서비스 운영', domain: 'OP'},
  {code: 'OP-2', name: '모니터링', domain: 'OP'},
  {code: 'OP-3', name: '장애·변경(운영)', domain: 'OP'},
  {code: 'OP-4', name: '사용자 지원', domain: 'OP'},
  {code: 'OP-5', name: '폐기', domain: 'OP'}
] AS row
MATCH (d:Domain {code: row.domain})
MERGE (s:SubDomain {code: row.code}) SET s.name = row.name
MERGE (s)-[:PART_OF]->(d);

// 3. 역할 (내부 역할 8개 + 협업 외부 조직)
UNWIND [
  {name: '부서장', internal: 'true'},
  {name: '전략기획', internal: 'true'},
  {name: 'PM', internal: 'true'},
  {name: 'AI엔지니어', internal: 'true'},
  {name: '데이터엔지니어', internal: 'true'},
  {name: '거버넌스', internal: 'true'},
  {name: '경영지원', internal: 'true'},
  {name: '운영', internal: 'true'},
  {name: '법무', internal: 'false'},
  {name: '보안팀', internal: 'false'},
  {name: '외주', internal: 'false'},
  {name: '인사팀', internal: 'false'},
  {name: '현업', internal: 'false'},
  {name: '홍보팀', internal: 'false'}
] AS row
MERGE (r:Role {name: row.name}) SET r.internal = (row.internal = 'true');

