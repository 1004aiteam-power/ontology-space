UNWIND [
  {f: 'OP-2-1', t: 'ST-4-1', why: '운영 성능 지표가 부서 성과 점검 입력'},
  {f: 'OP-4-3', t: 'ST-4-1', why: '사용자 만족도가 성과 점검 입력'},
  {f: 'OP-2-3', t: 'MS-1-3', why: '실제 운영비가 투자효과 분석 입력'},
  {f: 'PM-4-4', t: 'MS-1-3', why: '실현 효과가 ROI 분석 입력'},
  {f: 'MS-1-3', t: 'ST-3-3', why: 'ROI 결과가 다음 우선순위 평가에 반영'},
  {f: 'ST-4-3', t: 'ST-2-2', why: '전략 조정이 로드맵 롤링에 반영'},
  {f: 'PM-4-2', t: 'PM-2-4', why: '교훈이 다음 과제 위험 계획에 반영'},
  {f: 'OP-4-2', t: 'ST-3-2', why: '개선 요청이 신규 과제 후보가 됨'},
  {f: 'GV-4-3', t: 'GV-1-3', why: '보안사고 원인이 규정 개정으로 이어짐'},
  {f: 'GV-5-2', t: 'GV-3-4', why: '감사 지적이 리스크 대응 과제가 됨'},
  {f: 'OC-3-4', t: 'OC-3-1', why: '교육 효과가 다음 교육체계에 반영'},
  {f: 'MS-3-1', t: 'MS-2-2', why: '벤더 평가가 다음 선정에 반영'},
  {f: 'OP-3-1', t: 'GV-3-4', why: '반복 장애가 리스크 대응 대상이 됨'},
  {f: 'BD-2-5', t: 'ST-3-2', why: '보류 PoC가 과제 풀로 복귀'}
] AS row
MATCH (a:Task {code: row.f}), (b:Task {code: row.t})
MERGE (a)-[r:FEEDS_BACK_TO]->(b) SET r.description = row.why;
