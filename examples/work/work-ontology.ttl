@prefix aipd: <https://example.org/ai-promotion-dept/ontology#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .

<https://example.org/ai-promotion-dept/ontology> a owl:Ontology ;
    rdfs:label "AI추진부 업무 온톨로지"@ko ;
    owl:versionInfo "0.2" ;
    dct:created "2026-11-03"^^xsd:date ;
    rdfs:comment "가상의 AI추진부 업무를 9개 대분류, 43개 중분류, 149개 단위업무로 분류하고 역할·산출물·리스크·업무 간 선행/환류 관계를 정의한다."@ko .

### 클래스
aipd:Task a owl:Class ; rdfs:label "단위업무"@ko .
aipd:Domain a owl:Class ; rdfs:label "대분류"@ko .
aipd:SubDomain a owl:Class ; rdfs:label "중분류"@ko .
aipd:Role a owl:Class ; rdfs:label "역할"@ko .
aipd:InternalRole a owl:Class ; rdfs:subClassOf aipd:Role ; rdfs:label "부서 내부 역할"@ko .
aipd:ExternalParty a owl:Class ; rdfs:subClassOf aipd:Role ; rdfs:label "협업 외부 조직"@ko ; owl:disjointWith aipd:InternalRole .
aipd:Artifact a owl:Class ; rdfs:label "산출물"@ko .
aipd:Risk a owl:Class ; rdfs:label "리스크"@ko .
aipd:LifecycleStage a owl:Class ; rdfs:label "생애주기 단계"@ko .
aipd:TaskNature a owl:Class ; rdfs:label "업무 성격"@ko .
aipd:Task owl:disjointWith aipd:Domain, aipd:SubDomain, aipd:Role, aipd:Artifact, aipd:Risk .

### 객체 속성
aipd:belongsTo a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain aipd:Task ; rdfs:range aipd:SubDomain ; rdfs:label "소속 중분류"@ko .
aipd:partOf a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain aipd:SubDomain ; rdfs:range aipd:Domain ; rdfs:label "소속 대분류"@ko .
aipd:ownedBy a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain aipd:Task ; rdfs:range aipd:InternalRole ; rdfs:label "주관 역할"@ko .
aipd:collaboratesWith a owl:ObjectProperty ; rdfs:domain aipd:Task ; rdfs:range aipd:Role ; rdfs:label "협업 역할"@ko .
aipd:produces a owl:ObjectProperty ; rdfs:domain aipd:Task ; rdfs:range aipd:Artifact ; owl:inverseOf aipd:producedBy ; rdfs:label "산출"@ko .
aipd:producedBy a owl:ObjectProperty ; rdfs:label "산출 업무"@ko .
aipd:hasRisk a owl:ObjectProperty ; rdfs:domain aipd:Task ; rdfs:range aipd:Risk ; rdfs:label "관련 리스크"@ko .
aipd:inStage a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain aipd:Task ; rdfs:range aipd:LifecycleStage ; rdfs:label "생애주기"@ko .
aipd:hasNature a owl:ObjectProperty, owl:FunctionalProperty ; rdfs:domain aipd:Task ; rdfs:range aipd:TaskNature ; rdfs:label "업무 성격"@ko .
aipd:precedesTransitive a owl:ObjectProperty, owl:TransitiveProperty ; rdfs:domain aipd:Task ; rdfs:range aipd:Task ; rdfs:label "선행(전이)"@ko ;
    rdfs:comment "precedes의 전이 폐포. 추론기를 돌리면 간접 선행 업무가 모두 도출된다."@ko .
aipd:precedes a owl:ObjectProperty, owl:AsymmetricProperty, owl:IrreflexiveProperty ; rdfs:subPropertyOf aipd:precedesTransitive ;
    rdfs:domain aipd:Task ; rdfs:range aipd:Task ; owl:inverseOf aipd:dependsOn ; rdfs:label "직접 선행"@ko ;
    rdfs:comment "주어 업무가 끝나야 목적어 업무를 시작할 수 있다. 순환이 없어야 한다."@ko .
aipd:dependsOn a owl:ObjectProperty ; rdfs:label "선행 필요"@ko .
aipd:feedsBackTo a owl:ObjectProperty ; rdfs:domain aipd:Task ; rdfs:range aipd:Task ; rdfs:label "환류"@ko ;
    rdfs:comment "주어 업무의 결과가 목적어 업무의 다음 회차 입력이 된다. 순서를 강제하지 않으므로 순환을 허용한다."@ko .

### 데이터 속성
aipd:code a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "코드"@ko .
aipd:cycle a owl:DatatypeProperty ; rdfs:domain aipd:Task ; rdfs:range xsd:string ; rdfs:label "주기"@ko .
aipd:condition a owl:DatatypeProperty ; rdfs:domain aipd:Task ; rdfs:range xsd:string ; rdfs:label "적용 조건"@ko .
aipd:kpi a owl:DatatypeProperty ; rdfs:domain aipd:Task ; rdfs:range xsd:string ; rdfs:label "KPI"@ko .
aipd:note a owl:DatatypeProperty ; rdfs:domain aipd:Task ; rdfs:range xsd:string ; rdfs:label "비고"@ko .
aipd:feedbackReason a owl:AnnotationProperty ; rdfs:label "환류 사유"@ko .

### 생애주기·업무 성격
aipd:Stage_Plan a aipd:LifecycleStage ; rdfs:label "기획"@ko .
aipd:Stage_Initiate a aipd:LifecycleStage ; rdfs:label "착수"@ko .
aipd:Stage_Execute a aipd:LifecycleStage ; rdfs:label "실행"@ko .
aipd:Stage_Review a aipd:LifecycleStage ; rdfs:label "점검"@ko .
aipd:Stage_Close a aipd:LifecycleStage ; rdfs:label "종료"@ko .
aipd:Stage_Operate a aipd:LifecycleStage ; rdfs:label "운영"@ko .
aipd:Nature_Recurring a aipd:TaskNature ; rdfs:label "정기"@ko .
aipd:Nature_ProjectBased a aipd:TaskNature ; rdfs:label "과제성"@ko .
aipd:Nature_AdHoc a aipd:TaskNature ; rdfs:label "수시"@ko .

### 대분류·중분류
aipd:Domain_ST a aipd:Domain ; aipd:code "ST" ; rdfs:label "전략·기획"@ko ; rdfs:comment "StrategyPlanning"@en .
aipd:Domain_BD a aipd:Domain ; aipd:code "BD" ; rdfs:label "사업개발·확산"@ko ; rdfs:comment "BusinessDevelopment"@en .
aipd:Domain_TD a aipd:Domain ; aipd:code "TD" ; rdfs:label "AI 기술개발"@ko ; rdfs:comment "AITechDevelopment"@en .
aipd:Domain_DM a aipd:Domain ; aipd:code "DM" ; rdfs:label "데이터 관리"@ko ; rdfs:comment "DataManagement"@en .
aipd:Domain_PM a aipd:Domain ; aipd:code "PM" ; rdfs:label "과제·프로젝트 관리"@ko ; rdfs:comment "ProjectManagement"@en .
aipd:Domain_GV a aipd:Domain ; aipd:code "GV" ; rdfs:label "AI 거버넌스·리스크"@ko ; rdfs:comment "AIGovernanceRisk"@en .
aipd:Domain_OC a aipd:Domain ; aipd:code "OC" ; rdfs:label "조직·역량"@ko ; rdfs:comment "OrgCapability"@en .
aipd:Domain_MS a aipd:Domain ; aipd:code "MS" ; rdfs:label "경영지원"@ko ; rdfs:comment "ManagementSupport"@en .
aipd:Domain_OP a aipd:Domain ; aipd:code "OP" ; rdfs:label "운영·유지보수"@ko ; rdfs:comment "Operations"@en .
aipd:Sub_ST_1 a aipd:SubDomain ; aipd:code "ST-1" ; rdfs:label "환경분석"@ko ; aipd:partOf aipd:Domain_ST .
aipd:Sub_ST_2 a aipd:SubDomain ; aipd:code "ST-2" ; rdfs:label "비전·중장기전략"@ko ; aipd:partOf aipd:Domain_ST .
aipd:Sub_ST_3 a aipd:SubDomain ; aipd:code "ST-3" ; rdfs:label "연간 사업계획"@ko ; aipd:partOf aipd:Domain_ST .
aipd:Sub_ST_4 a aipd:SubDomain ; aipd:code "ST-4" ; rdfs:label "성과관리(부서 단위)"@ko ; aipd:partOf aipd:Domain_ST .
aipd:Sub_BD_1 a aipd:SubDomain ; aipd:code "BD-1" ; rdfs:label "수요발굴"@ko ; aipd:partOf aipd:Domain_BD .
aipd:Sub_BD_2 a aipd:SubDomain ; aipd:code "BD-2" ; rdfs:label "PoC·파일럿"@ko ; aipd:partOf aipd:Domain_BD .
aipd:Sub_BD_3 a aipd:SubDomain ; aipd:code "BD-3" ; rdfs:label "사업화·확산"@ko ; aipd:partOf aipd:Domain_BD .
aipd:Sub_BD_4 a aipd:SubDomain ; aipd:code "BD-4" ; rdfs:label "대외협력"@ko ; aipd:partOf aipd:Domain_BD .
aipd:Sub_BD_5 a aipd:SubDomain ; aipd:code "BD-5" ; rdfs:label "홍보"@ko ; aipd:partOf aipd:Domain_BD .
aipd:Sub_TD_1 a aipd:SubDomain ; aipd:code "TD-1" ; rdfs:label "아키텍처·플랫폼"@ko ; aipd:partOf aipd:Domain_TD .
