# 배전공사 안전 온톨로지 — 개체 데이터. 만든 곳: examples/safety/build_safety.mjs (원본: assets/safety/safety.js)
# 시나리오 5 · 작업 단계 62 · 수칙 11 · 위험요인 9 · 역할 17 · 잘못된 선택 124. 스키마는 safety-schema.ttl
# ⚠ 교육용 가상 현장입니다. 설비 · 선로 구간은 가상 데이터이며, 실제 작업은 소속 기관의 작업기준·안전수칙을 따르세요.
@prefix sf: <https://1004aiteam-power.github.io/ontology-space/safety#> .
@prefix aipd: <https://example.org/ai-promotion-dept/ontology#> .
@prefix pam: <https://1004aiteam-power.github.io/ontology-space/asset#> .
@prefix ex: <http://example.org/grid#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sf:HazardShock a sf:Hazard ;
    rdfs:label "감전"@ko ;
    rdfs:label "Electric shock"@en .
sf:HazardArc a sf:Hazard ;
    rdfs:label "아크·화상"@ko ;
    rdfs:label "Arc flash & burns"@en .
sf:HazardFall a sf:Hazard ;
    rdfs:label "추락"@ko ;
    rdfs:label "Fall from height"@en .
sf:HazardStruck a sf:Hazard ;
    rdfs:label "낙하물·인양물에 맞음"@ko ;
    rdfs:label "Struck by falling objects"@en .
sf:HazardTipOver a sf:Hazard ;
    rdfs:label "작업차 전도"@ko ;
    rdfs:label "Work vehicle tipping over"@en .
sf:HazardRollaway a sf:Hazard ;
    rdfs:label "작업차 밀림"@ko ;
    rdfs:label "Work vehicle rolling away"@en .
sf:HazardVehicle a sf:Hazard ;
    rdfs:label "차량 충돌·끼임"@ko ;
    rdfs:label "Struck or caught by a vehicle"@en .
sf:HazardAsphyxia a sf:Hazard ;
    rdfs:label "산소결핍·유해가스"@ko ;
    rdfs:label "Oxygen deficiency & toxic gas"@en .
sf:HazardMiscoordination a sf:Hazard ;
    rdfs:label "작업 착오 (계획·소통 부재)"@ko ;
    rdfs:label "Miscoordination (no plan, no briefing)"@en .
sf:Rule01 a sf:SafetyRule ;
    sf:ruleNo 1 ;
    rdfs:label "개인 안전장구 착용"@ko ;
    rdfs:label "Wear personal protective equipment"@en ;
    sf:controls sf:HazardStruck ;
    sf:controls sf:HazardShock ;
    sf:controls sf:HazardAsphyxia ;
    sf:controls sf:HazardFall .
sf:Rule02 a sf:SafetyRule ;
    sf:ruleNo 2 ;
    rdfs:label "고임목 4개 이상 설치"@ko ;
    rdfs:label "Place 4 or more wheel chocks"@en ;
    sf:controls sf:HazardRollaway .
sf:Rule03 a sf:SafetyRule ;
    sf:ruleNo 3 ;
    rdfs:label "작업계획서·TBM 작성 필수, 공법 임의변경 금지"@ko ;
    rdfs:label "Work plan and TBM required; no ad-hoc method changes"@en ;
    sf:controls sf:HazardMiscoordination .
sf:Rule04 a sf:SafetyRule ;
    sf:ruleNo 4 ;
    rdfs:label "작업차량 전도방지 조치"@ko ;
    rdfs:label "Prevent the work vehicle from tipping over"@en ;
    sf:controls sf:HazardTipOver .
sf:Rule05 a sf:SafetyRule ;
    sf:ruleNo 5 ;
    rdfs:label "작업반경 출입금지, 후진 시 전담유도자 배치"@ko ;
    rdfs:label "Keep out of the work radius; a dedicated guide when reversing"@en ;
    sf:controls sf:HazardVehicle ;
    sf:controls sf:HazardStruck .
sf:Rule06 a sf:SafetyRule ;
    sf:ruleNo 6 ;
    rdfs:label "인양물 고정장치, 하부 출입금지"@ko ;
    rdfs:label "Secure lifted loads; nobody beneath them"@en ;
    sf:controls sf:HazardStruck .
sf:Rule07 a sf:SafetyRule ;
    sf:ruleNo 7 ;
    rdfs:label "안전대 착용, 안전고리 체결"@ko ;
    rdfs:label "Wear a safety harness and clip the lanyard"@en ;
    sf:controls sf:HazardFall .
sf:Rule08 a sf:SafetyRule ;
    sf:ruleNo 8 ;
    rdfs:label "검전, 접지, 충전부 방호"@ko ;
    rdfs:label "Test for voltage, earth, cover live parts"@en ;
    sf:controls sf:HazardShock .
sf:Rule09 a sf:SafetyRule ;
    sf:ruleNo 9 ;
    rdfs:label "밀폐공간 작업 허가절차 준수"@ko ;
    rdfs:label "Follow the confined-space permit procedure"@en ;
    sf:controls sf:HazardAsphyxia .
sf:Rule10 a sf:SafetyRule ;
    sf:ruleNo 10 ;
    rdfs:label "맨홀 내 작업 시 작업반경 출입금지"@ko ;
    rdfs:label "Keep out of the work radius during manhole work"@en ;
    sf:controls sf:HazardFall ;
    sf:controls sf:HazardVehicle .
sf:Rule11 a sf:SafetyRule ;
    sf:ruleNo 11 ;
    rdfs:label "분야별 수칙 (배전: 적정공구 사용 · 토목: 개구부 추락방지 등)"@ko ;
    rdfs:label "Field rules (distribution: proper tools · civil: guard openings, etc.)"@en ;
    sf:controls sf:HazardShock ;
    sf:controls sf:HazardArc ;
    sf:controls sf:HazardFall .
sf:RoleSupervisor a sf:CrewRole ;
    rdfs:label "작업책임자"@ko ;
    rdfs:label "Supervisor"@en .
sf:RoleBucketLineworker a sf:CrewRole ;
    rdfs:label "버킷 작업자"@ko ;
    rdfs:label "Bucket lineworker"@en .
sf:RoleGroundWorkerDriver a sf:CrewRole ;
    rdfs:label "지상 작업자·운전원"@ko ;
    rdfs:label "Ground worker / driver"@en .
sf:RoleTestingEarthing a sf:CrewRole ;
    rdfs:label "검전·접지 담당"@ko ;
    rdfs:label "Testing & earthing"@en .
sf:RoleSignaller a sf:CrewRole ;
    rdfs:label "신호수(유도자)"@ko ;
    rdfs:label "Signaller (guide)"@en .
sf:RoleEarthingGroundHelper a sf:CrewRole ;
    rdfs:label "접지·지상 보조"@ko ;
    rdfs:label "Earthing & ground helper"@en .
sf:RoleClimber a sf:CrewRole ;
    rdfs:label "승탑 작업자"@ko ;
    rdfs:label "Climber"@en .
sf:RoleGroundHelper a sf:CrewRole ;
    rdfs:label "지상 보조(달줄)"@ko ;
    rdfs:label "Ground helper (hand line)"@en .
sf:RoleSafetyWatcher a sf:CrewRole ;
    rdfs:label "안전 감시자"@ko ;
    rdfs:label "Safety watcher"@en .
sf:RoleAccessControl a sf:CrewRole ;
    rdfs:label "출입 통제"@ko ;
    rdfs:label "Access control"@en .
sf:RoleBucketLineworker a sf:CrewRole ;
    rdfs:label "버킷 작업자 (0번 전주)"@ko ;
    rdfs:label "Bucket lineworker (pole 0)"@en .
sf:RoleGroundWorkerTruckDriver a sf:CrewRole ;
    rdfs:label "지상 작업자·1호차 운전원"@ko ;
    rdfs:label "Ground worker / truck 1 driver"@en .
sf:RoleTruckDriverTestingEarthing a sf:CrewRole ;
    rdfs:label "2호차 운전원·검전·접지"@ko ;
    rdfs:label "Truck 2 driver · testing & earthing"@en .
sf:RoleBucketLineworker a sf:CrewRole ;
    rdfs:label "버킷 작업자 (35번 전주)"@ko ;
    rdfs:label "Bucket lineworker (pole 35)"@en .
sf:RoleEntrant a sf:CrewRole ;
    rdfs:label "입조 작업자"@ko ;
    rdfs:label "Entrant"@en .
sf:RoleAttendant a sf:CrewRole ;
    rdfs:label "감시인"@ko ;
    rdfs:label "Attendant"@en .
sf:RoleGasTestingVentilation a sf:CrewRole ;
    rdfs:label "가스 측정·환기 담당"@ko ;
    rdfs:label "Gas testing & ventilation"@en .
sf:CT_Insulator a pam:ComponentType .
sf:CT_Crossarm a pam:ComponentType .
sf:CT_Insulator rdfs:label "Insulator" .
sf:CT_Crossarm rdfs:label "Crossarm" .
sf:Scenario_pole a sf:WorkScenario ;
    sf:scenarioId "pole" ;
    rdfs:label "가공 배전 애자·완금 교체 (정전 작업)"@ko ;
    rdfs:label "Overhead line: replace insulators & crossarm (de-energised)"@en .
sf:AS_PL_0601 a sf:PoleAsset ;
    pam:code "AS-PL-0601" ;
    rdfs:label "D/L #1 6구간 전주 (가상)"@ko ;
    rdfs:label "Pole on D/L #1 section 6 (virtual)"@en ;
    pam:installedAt ex:_756664b6-b373-5677-98ab-854ba7714b9f ;
    pam:hasComponent sf:CP_PL0601_INS .
sf:CP_PL0601_INS a pam:Component ;
    rdfs:label "현수애자"@ko ;
    rdfs:label "Suspension insulators"@en ;
    pam:componentType sf:CT_Insulator .
sf:Scenario_pole sf:replacesComponent sf:CP_PL0601_INS .
sf:AS_PL_0601 pam:hasComponent sf:CP_PL0601_ARM .
sf:CP_PL0601_ARM a pam:Component ;
    rdfs:label "완금"@ko ;
    rdfs:label "Crossarm"@en ;
    pam:componentType sf:CT_Crossarm .
sf:Scenario_pole sf:replacesComponent sf:CP_PL0601_ARM ;
    sf:targetAsset sf:AS_PL_0601 ;
    sf:maintenanceTask pam:MT_10 ;
    sf:workSection ex:_756664b6-b373-5677-98ab-854ba7714b9f ;
    sf:isolatedBy ex:_a1e1b903-48f9-5256-8862-92c891050074 ;
    sf:lineDeEnergised true ;
    sf:firstStep sf:pole_tbm .
sf:pole_tbm a sf:WorkStep ;
    sf:inScenario sf:Scenario_pole ;
    sf:stepId "tbm" ;
    sf:stepNo 1 ;
    rdfs:label "작업 전 TBM · 작업계획서 확인"@ko ;
    rdfs:label "Pre-work TBM · check the work plan"@en ;
    sf:instruction "작업책임자가 작업계획서로 작업 내용·순서·정전 구간·위험요인을 설명하고 각자 역할을 확인합니다. 계획서에 없는 방법으로 바꾸지 않습니다."@ko ;
    sf:instruction "The supervisor walks the crew through the plan: task, sequence, outage section and hazards, then confirms each role. No method outside the plan."@en ;
    sf:reason "감전·추락·전도 사고 대부분은 \"계획에 없던 즉흥 작업\"에서 시작됩니다."@ko ;
    sf:reason "Most shock, fall and tip-over accidents begin with an improvised step that was not in the plan."@en ;
    sf:appliesRule sf:Rule03 ;
    aipd:hasRisk sf:HazardMiscoordination ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleGroundWorkerDriver ;
    sf:involves sf:RoleTestingEarthing ;
    sf:involves sf:RoleSignaller ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Plan ;
    aipd:precedes sf:pole_ppe .
sf:pole_tbm_x1 a sf:UnsafeChoice ;
    rdfs:label "시간이 없으니 TBM은 생략하고 바로 작업차를 진입시킨다"@ko ;
    rdfs:label "Skip the TBM to save time and bring the truck in"@en ;
    sf:explanation "작업자마다 정전 구간·역할을 다르게 알고 있으면 충전부 접촉 같은 치명적 실수로 이어집니다. (수칙 3)"@ko ;
    sf:explanation "If people hold different ideas of the outage section and roles, someone touches a live part. (Rule 3)"@en ;
    sf:mistakeAt sf:pole_tbm ;
    sf:violates sf:Rule03 .
sf:pole_tbm_x2 a sf:UnsafeChoice ;
    rdfs:label "현장 상황이 다르니 작업 방법은 각자 판단해서 바꾼다"@ko ;
    rdfs:label "The site looks different, so each person adapts the method as they see fit"@en ;
    sf:explanation "공법 임의변경 금지. 현장이 계획과 다르면 작업을 멈추고 계획을 다시 세웁니다. (수칙 3)"@ko ;
    sf:explanation "No ad-hoc method changes. If the site differs from the plan, stop and re-plan. (Rule 3)"@en ;
    sf:mistakeAt sf:pole_tbm ;
    sf:violates sf:Rule03 .
sf:pole_ppe a sf:WorkStep ;
    sf:inScenario sf:Scenario_pole ;
    sf:stepId "ppe" ;
    sf:stepNo 2 ;
    rdfs:label "개인 안전장구 착용"@ko ;
    rdfs:label "Put on personal protective equipment"@en ;
    sf:instruction "안전모(턱끈 체결)·절연장갑·안전화·반사조끼를 착용하고, 버킷 작업자는 그네식 안전대를 맵니다. 작업책임자가 서로의 착용 상태를 확인합니다."@ko ;
    sf:instruction "Hard hat with chin strap, insulating gloves, safety boots, hi-vis vest; the bucket worker puts on a full-body harness. The supervisor checks everyone."@en ;
    sf:reason "장구는 사고가 났을 때 생사를 가르는 마지막 방어선입니다."@ko ;
    sf:reason "PPE is the last line of defence when everything else has failed."@en ;
    sf:appliesRule sf:Rule01 ;
    aipd:hasRisk sf:HazardStruck ;
    aipd:hasRisk sf:HazardShock ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleGroundWorkerDriver ;
    sf:involves sf:RoleTestingEarthing ;
    sf:involves sf:RoleSignaller ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:pole_zone .
sf:pole_ppe_x1 a sf:UnsafeChoice ;
    rdfs:label "지상 작업자는 높은 곳에 안 올라가니 안전모를 쓰지 않는다"@ko ;
    rdfs:label "Ground workers stay low, so they skip the hard hat"@en ;
    sf:explanation "지상 작업자는 위에서 떨어지는 공구·자재에 가장 많이 다칩니다. (수칙 1)"@ko ;
    sf:explanation "Ground workers are the ones hit by dropped tools and parts. (Rule 1)"@en ;
    sf:mistakeAt sf:pole_ppe ;
    sf:violates sf:Rule01 .
sf:pole_ppe_x2 a sf:UnsafeChoice ;
    rdfs:label "정전 작업이니 절연장갑은 필요 없다"@ko ;
    rdfs:label "It is a dead-line job, so insulating gloves are unnecessary"@en ;
    sf:explanation "검전 전에는 충전 상태로 간주합니다. 역송전·오조작도 있습니다. (수칙 1, 8)"@ko ;
    sf:explanation "Treat it as live until tested; back-feed and wrong switching happen. (Rules 1, 8)"@en ;
    sf:mistakeAt sf:pole_ppe ;
    sf:violates sf:Rule01 ;
    sf:violates sf:Rule08 .
sf:pole_zone a sf:WorkStep ;
    sf:inScenario sf:Scenario_pole ;
    sf:stepId "zone" ;
    sf:stepNo 3 ;
    rdfs:label "작업구역 설정 · 출입금지 · 보행 통로 확보"@ko ;
    rdfs:label "Set up the work zone · keep out · keep a walkway"@en ;
    sf:instruction "라바콘과 안전띠로 작업차·전주 주변을 막아 작업반경 출입을 금지합니다. 보도는 바깥쪽에 보행 통로를 남겨 시민이 작업구역에 들어오지 않게 합니다."@ko ;
    sf:instruction "Cones and tape close off the truck and pole area. A walkway stays open on the outer sidewalk so the public never enters the zone."@en ;
    sf:reason "붐 회전·낙하물 반경 안에 사람이 있으면 아무리 조심해도 사고가 납니다."@ko ;
    sf:reason "Anyone inside the boom-swing or drop radius will eventually be hit."@en ;
    sf:appliesRule sf:Rule05 ;
    aipd:hasRisk sf:HazardVehicle ;
    aipd:hasRisk sf:HazardStruck ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleTestingEarthing ;
    sf:involves sf:RoleSignaller ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:pole_reverse .
sf:pole_zone_x1 a sf:UnsafeChoice ;
    rdfs:label "작업이 금방 끝나니 라바콘 없이 시작한다"@ko ;
    rdfs:label "It will be quick — start without cones"@en ;
    sf:explanation "작업 시간과 상관없이 붐 회전·낙하 반경 안으로 사람·차량이 들어옵니다. (수칙 5)"@ko ;
    sf:explanation "Short or not, people and cars wander into the swing and drop radius. (Rule 5)"@en ;
    sf:mistakeAt sf:pole_zone ;
    sf:violates sf:Rule05 .
sf:pole_zone_x2 a sf:UnsafeChoice ;
    rdfs:label "보도 전체를 막고 시민에게 차도로 돌아가라고 한다"@ko ;
    rdfs:label "Close the whole sidewalk and send pedestrians onto the road"@en ;
    sf:explanation "보행자를 차도로 내보내면 교통사고 위험이 생깁니다. 안전한 보행 통로를 남깁니다."@ko ;
    sf:explanation "Sending pedestrians into traffic creates a new hazard. Keep a safe walkway."@en ;
    sf:mistakeAt sf:pole_zone ;
    sf:violates sf:Rule05 .
sf:pole_reverse a sf:WorkStep ;
    sf:inScenario sf:Scenario_pole ;
    sf:stepId "reverse" ;
    sf:stepNo 4 ;
    rdfs:label "작업차 진입 · 후진 시 전담 유도자"@ko ;
    rdfs:label "Bring in the truck · dedicated guide when reversing"@en ;
    sf:instruction "운전원이 작업차를 전주 옆으로 몰고 와 후진으로 위치를 맞춥니다. 신호수(전담 유도자)는 운전석에서 보이는 차량 뒤쪽 옆에 서서 신호봉으로 유도하고, 운전원은 유도자가 보이지 않으면 즉시 멈춥니다."@ko ;
    sf:instruction "The driver brings the truck alongside the pole and reverses into position. The dedicated guide stands behind and to the side, visible from the cab, signalling with a baton; if the guide is out of sight the driver stops."@en ;
    sf:reason "후진 차량의 사각지대는 차량 뒤 수 m에 이릅니다. 끼임·충돌 사고의 대표 원인입니다."@ko ;
    sf:reason "A reversing truck has a blind zone several metres long — a top cause of crush and strike accidents."@en ;
    sf:appliesRule sf:Rule05 ;
    aipd:hasRisk sf:HazardVehicle ;
    aipd:hasRisk sf:HazardStruck ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleGroundWorkerDriver ;
    sf:involves sf:RoleSignaller ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:pole_chocks .
sf:pole_reverse_x1 a sf:UnsafeChoice ;
    rdfs:label "후사경과 후방카메라만 보고 혼자 후진한다"@ko ;
    rdfs:label "Reverse alone using mirrors and the rear camera"@en ;
    sf:explanation "카메라·거울에는 사각지대가 있습니다. 후진 시에는 반드시 전담 유도자를 배치합니다. (수칙 5)"@ko ;
    sf:explanation "Mirrors and cameras have blind spots. Reversing needs a dedicated guide. (Rule 5)"@en ;
    sf:mistakeAt sf:pole_reverse ;
    sf:violates sf:Rule05 .
sf:pole_reverse_x2 a sf:UnsafeChoice ;
    rdfs:label "유도자가 차량 바로 뒤 가운데에 서서 신호한다"@ko ;
    rdfs:label "The guide stands directly behind the truck, in the middle"@en ;
    sf:explanation "차량 바로 뒤는 운전석에서 보이지 않는 끼임 위치입니다. 운전원이 볼 수 있는 옆쪽에 섭니다."@ko ;
    sf:explanation "Dead centre behind is invisible from the cab and a crush point. Stand to the side, in view."@en ;
    sf:mistakeAt sf:pole_reverse ;
    sf:violates sf:Rule05 .
sf:pole_chocks a sf:WorkStep ;
    sf:inScenario sf:Scenario_pole ;
    sf:stepId "chocks" ;
    sf:stepNo 5 ;
    rdfs:label "고임목 4개 이상 설치"@ko ;
    rdfs:label "Place 4 or more wheel chocks"@en ;
    sf:instruction "주차 브레이크를 채운 뒤 앞·뒤 바퀴 양쪽에 고임목을 받쳐 차량이 밀리지 않게 합니다."@ko ;
    sf:instruction "With the parking brake on, chock front and rear wheels on both sides so the truck cannot roll."@en ;
    sf:reason "붐을 올리면 무게중심이 바뀌어 경사가 거의 없는 도로에서도 차량이 밀릴 수 있습니다."@ko ;
    sf:reason "Raising the boom shifts the centre of gravity; even a gentle slope can make the truck creep."@en ;
    sf:appliesRule sf:Rule02 ;
    aipd:hasRisk sf:HazardRollaway ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleGroundWorkerDriver ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:pole_outrig .
sf:pole_chocks_x1 a sf:UnsafeChoice ;
    rdfs:label "평지이니 고임목 없이 주차 브레이크만 채운다"@ko ;
    rdfs:label "The road is flat, so the parking brake is enough"@en ;
    sf:explanation "붐 하중으로 무게중심이 바뀌면 브레이크만으로는 밀림을 막지 못합니다. (수칙 2)"@ko ;
    sf:explanation "Boom loads shift the centre of gravity; the brake alone will not stop creep. (Rule 2)"@en ;
    sf:mistakeAt sf:pole_chocks ;
    sf:violates sf:Rule02 .
sf:pole_chocks_x2 a sf:UnsafeChoice ;
    rdfs:label "뒷바퀴 한쪽에만 고임목 2개를 받친다"@ko ;
    rdfs:label "Put two chocks under one rear wheel only"@en ;
    sf:explanation "앞·뒤 양쪽 4개 이상을 받쳐야 어느 방향으로도 밀리지 않습니다. (수칙 2)"@ko ;
    sf:explanation "Four or more, front and rear on both sides, stop movement in any direction. (Rule 2)"@en ;
    sf:mistakeAt sf:pole_chocks ;
    sf:violates sf:Rule02 .
sf:pole_outrig a sf:WorkStep ;
    sf:inScenario sf:Scenario_pole ;
    sf:stepId "outrig" ;
    sf:stepNo 6 ;
    rdfs:label "아웃트리거 전개 · 받침판 설치 (전도방지)"@ko ;
    rdfs:label "Deploy outriggers on pads (anti-tip)"@en ;
    sf:instruction "받침판을 깔고 아웃트리거를 끝까지 펼쳐 바퀴가 들릴 정도로 차체를 받칩니다. 수평계로 기울기를 확인합니다."@ko ;
    sf:instruction "Lay outrigger pads, extend the outriggers fully and take the weight off the wheels. Check the level gauge."@en ;
    sf:reason "아웃트리거를 덜 펴거나 연약지반에 그대로 내리면 붐이 기울 때 차량이 넘어갑니다."@ko ;
    sf:reason "Half-extended outriggers, or feet on soft ground, let the truck roll over when the boom leans out."@en ;
    sf:appliesRule sf:Rule04 ;
    aipd:hasRisk sf:HazardTipOver ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleGroundWorkerDriver ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:pole_switch .
sf:pole_outrig_x1 a sf:UnsafeChoice ;
    rdfs:label "자리가 좁으니 아웃트리거를 반만 펴고 작업한다"@ko ;
    rdfs:label "Space is tight — extend the outriggers halfway"@en ;
    sf:explanation "반만 펴면 전도 한계가 크게 줄어듭니다. 공간이 없으면 작업 위치·방법을 다시 정합니다. (수칙 4)"@ko ;
    sf:explanation "Half extension slashes the tip limit. If there is no room, re-plan the position or method. (Rule 4)"@en ;
    sf:mistakeAt sf:pole_outrig ;
    sf:violates sf:Rule04 .
sf:pole_outrig_x2 a sf:UnsafeChoice ;
    rdfs:label "받침판 없이 보도블록 위에 아웃트리거를 바로 내린다"@ko ;
    rdfs:label "Lower the outriggers straight onto paving blocks, no pads"@en ;
    sf:explanation "보도블록·맨홀 뚜껑·연약지반은 꺼질 수 있습니다. 받침판으로 하중을 분산합니다. (수칙 4)"@ko ;
    sf:explanation "Paving, covers and soft ground can sink. Pads spread the load. (Rule 4)"@en ;
    sf:mistakeAt sf:pole_outrig ;
    sf:violates sf:Rule04 .
sf:pole_switch a sf:WorkStep ;
    sf:inScenario sf:Scenario_pole ;
    sf:stepId "switch" ;
    sf:stepNo 7 ;
    rdfs:label "개폐기 개방 — 절연 조작봉 사용"@ko ;
    rdfs:label "Open the switch with an insulated hot stick"@en ;
    sf:instruction "작업책임자가 정전 구간 전원측 개폐기(-70 전주)를 절연장갑을 끼고 절연 조작봉으로 개방하고, \"작업 중 조작금지\" 표찰을 겁니다."@ko ;
    sf:instruction "The supervisor opens the source-side switch on pole -70 with insulating gloves and an insulated hot stick, then hangs a \"Do not operate — work in progress\" tag."@en ;
    sf:reason "맨손이나 아무 막대로 조작하면 아크·감전 위험이 있습니다. 표찰이 없으면 다른 사람이 다시 투입할 수 있습니다."@ko ;
    sf:reason "Bare hands or improvised poles risk arc and shock. Without a tag someone may close it again."@en ;
    sf:appliesRule sf:Rule11 ;
    aipd:hasRisk sf:HazardShock ;
    aipd:hasRisk sf:HazardArc ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleTestingEarthing ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:pole_earth .
sf:pole_switch_x1 a sf:UnsafeChoice ;
    rdfs:label "가까이 있는 일반 막대로 개폐기 손잡이를 당긴다"@ko ;
    rdfs:label "Pull the switch handle with any pole lying around"@en ;
    sf:explanation "적정 공구(절연 조작봉)가 아니면 감전·아크에 노출됩니다. (수칙 11 배전)"@ko ;
    sf:explanation "Without the proper insulated tool you are exposed to shock and arc. (Rule 11, distribution)"@en ;
    sf:mistakeAt sf:pole_switch ;
    sf:violates sf:Rule11 .
sf:pole_switch_x2 a sf:UnsafeChoice ;
    rdfs:label "개폐기를 열지 않고 활선 상태로 바로 교체 작업을 한다"@ko ;
    rdfs:label "Skip the switching and replace parts live"@en ;
    sf:explanation "계획은 정전 작업입니다. 활선 작업으로 바꾸는 것은 공법 임의변경입니다. (수칙 3, 8)"@ko ;
    sf:explanation "The plan is dead-line work. Working live is an unauthorised method change. (Rules 3, 8)"@en ;
    sf:mistakeAt sf:pole_switch ;
    sf:violates sf:Rule03 ;
    sf:violates sf:Rule08 .
sf:pole_earth a sf:WorkStep ;
    sf:inScenario sf:Scenario_pole ;
    sf:stepId "earth" ;
    sf:stepNo 8 ;
    rdfs:label "검전 → 접지 (작업장소에서 1경간 이상 떨어진 곳)"@ko ;
    rdfs:label "Test, then earth (at least one span from the work)"@en ;
    sf:instruction "-35 전주에서 접지봉을 박고 접지선의 대지측을 먼저 연결합니다. 검전기로 세 상 모두 무전압을 확인한 뒤, 절연봉으로 접지 클램프를 선로 측에 겁니다."@ko ;
    sf:instruction "At pole -35: drive the earth rod and connect the earth end first. Prove all three phases dead with a voltage detector, then clamp the earth onto the line with an insulated stick."@en ;
    sf:reason "검전 없이 접지하면 충전 선로를 단락시킵니다. 접지는 오조작·역송전·유도전압이 와도 작업자를 지켜 줍니다."@ko ;
    sf:reason "Earthing a live line is a short circuit; test first. The earth protects you from wrong switching, back-feed and induced voltage."@en ;
    sf:appliesRule sf:Rule08 ;
    aipd:hasRisk sf:HazardShock ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleTestingEarthing ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:pole_harness .
sf:pole_earth_x1 a sf:UnsafeChoice ;
    rdfs:label "개폐기를 열었으니 검전 없이 바로 접지 클램프를 건다"@ko ;
    rdfs:label "The switch is open, so clamp the earth without testing"@en ;
    sf:explanation "다른 전원·오조작으로 살아 있을 수 있습니다. 검전 → 접지 순서는 바꿀 수 없습니다. (수칙 8)"@ko ;
    sf:explanation "Another source or wrong switching may keep it live. Test before earth, always. (Rule 8)"@en ;
    sf:mistakeAt sf:pole_earth ;
    sf:violates sf:Rule08 .
sf:pole_earth_x2 a sf:UnsafeChoice ;
    rdfs:label "선로 측 클램프를 먼저 걸고 대지측을 나중에 연결한다"@ko ;
    rdfs:label "Clamp the line end first, connect the earth end later"@en ;
    sf:explanation "선로가 살아 있으면 접지선을 든 사람이 대지 역할을 합니다. 대지측을 먼저, 뗄 때는 선로 측을 먼저."@ko ;
    sf:explanation "If the line is live, the person holding the lead becomes the earth path. Earth end first on, last off."@en ;
    sf:mistakeAt sf:pole_earth ;
    sf:violates sf:Rule08 .
sf:pole_harness a sf:WorkStep ;
    sf:inScenario sf:Scenario_pole ;
    sf:stepId "harness" ;
    sf:stepNo 9 ;
    rdfs:label "안전대 안전고리 체결 → 버킷 상승"@ko ;
    rdfs:label "Clip the harness lanyard → raise the bucket"@en ;
    sf:instruction "버킷 작업자가 버킷에 탑승해 안전대 고리를 버킷 지지점에 걸고, 작업책임자가 확인한 뒤에 붐을 올립니다. 버킷은 충전부와 거리를 둔 위치에 먼저 세웁니다."@ko ;
    sf:instruction "The bucket worker steps in and clips the lanyard to the bucket anchor; only after the supervisor checks does the boom go up — first to a spot well clear of the conductors."@en ;
    sf:reason "고리를 걸지 않은 안전대는 아무 소용이 없습니다. 버킷 흔들림·충격으로 튕겨 나가는 추락 사고가 납니다."@ko ;
    sf:reason "An unclipped harness does nothing. Jolts of the bucket throw people out."@en ;
    sf:appliesRule sf:Rule07 ;
    aipd:hasRisk sf:HazardFall ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:pole_test .
sf:pole_harness_x1 a sf:UnsafeChoice ;
    rdfs:label "버킷 안이니 안전고리는 위에 올라가서 건다"@ko ;
    rdfs:label "Clip the lanyard once the bucket is up"@en ;
    sf:explanation "붐이 움직이는 순간이 가장 흔들립니다. 탑승 즉시, 상승 전에 체결합니다. (수칙 7)"@ko ;
    sf:explanation "The bucket jolts most when the boom starts. Clip in on boarding, before lifting. (Rule 7)"@en ;
    sf:mistakeAt sf:pole_harness ;
    sf:violates sf:Rule07 .
sf:pole_harness_x2 a sf:UnsafeChoice ;
    rdfs:label "허리에 차는 벨트식 안전대를 쓴다"@ko ;
    rdfs:label "Use a waist-belt type safety belt"@en ;
    sf:explanation "추락을 멈출 때 충격이 허리에 집중됩니다. 그네식(전신) 안전대를 씁니다. (수칙 7, 11)"@ko ;
    sf:explanation "Arresting a fall with a waist belt injures the spine. Use a full-body harness. (Rules 7, 11)"@en ;
    sf:mistakeAt sf:pole_harness ;
    sf:violates sf:Rule07 ;
    sf:violates sf:Rule11 .
sf:pole_test a sf:WorkStep ;
    sf:inScenario sf:Scenario_pole ;
    sf:stepId "test" ;
    sf:stepNo 10 ;
    rdfs:label "작업 개소 검전"@ko ;
    rdfs:label "Test for voltage at the work point"@en ;
    sf:instruction "버킷 작업자가 작업 전주에서도 검전기로 세 상을 다시 확인합니다. 무전압이 확인되어야 작업 위치로 다가갑니다."@ko ;
    sf:instruction "At the work pole the bucket worker tests all three phases again. Only when they are proven dead does the bucket move in."@en ;
    sf:reason "접지 지점과 작업 지점 사이에 다른 회선·분기·역송전이 있을 수 있습니다."@ko ;
    sf:reason "Between the earth and the work point there may be another feed, a tap or back-feed."@en ;
    sf:appliesRule sf:Rule08 ;
    aipd:hasRisk sf:HazardShock ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:pole_cover .
sf:pole_test_x1 a sf:UnsafeChoice ;
    rdfs:label "-35 전주에서 검전했으니 여기서는 생략한다"@ko ;
    rdfs:label "Already tested at pole -35, skip it here"@en ;
    sf:explanation "작업 위치에서 다시 확인해야 다른 전원이 없음을 알 수 있습니다. (수칙 8)"@ko ;
    sf:explanation "Only a test at the work point proves no other source reaches it. (Rule 8)"@en ;
    sf:mistakeAt sf:pole_test ;
    sf:violates sf:Rule08 .
sf:pole_test_x2 a sf:UnsafeChoice ;
    rdfs:label "장갑 낀 손등으로 전선을 살짝 대 본다"@ko ;
    rdfs:label "Touch the conductor lightly with the back of a gloved hand"@en ;
    sf:explanation "사람은 검전기가 아닙니다. 반드시 정격 검전기를 쓰고, 쓰기 전에 검전기 자체를 점검합니다."@ko ;
    sf:explanation "People are not voltage detectors. Use a rated detector and check the detector itself first."@en ;
    sf:mistakeAt sf:pole_test ;
    sf:violates sf:Rule08 .
sf:pole_cover a sf:WorkStep ;
    sf:inScenario sf:Scenario_pole ;
    sf:stepId "cover" ;
    sf:stepNo 11 ;
    rdfs:label "방호: 중성선·인접 상에 절연 커버"@ko ;
    rdfs:label "Cover the neutral and adjacent phase"@en ;
    sf:instruction "검전·접지가 끝났어도, 작업 중 몸이 닿을 수 있는 중성선과 가까운 상에 절연 방호관·커버를 씌웁니다. 버킷을 조금 내려 중성선부터 덮고, 바로 옆 상을 덮은 뒤 작업 위치로 올라갑니다."@ko ;
    sf:instruction "Even after testing and earthing, fit insulating hoses and covers on the neutral and the nearby phase you could touch while working. Lower the bucket a little, cover the neutral, then the adjacent phase, and move up to the work position."@en ;
    sf:reason "오조작·역송전·유도전압으로 선로에 다시 전기가 올 수 있습니다. 접지는 사고 전류를 흘려 줄 뿐이라, 그 순간 몸이 선에 닿아 있으면 위험이 남습니다."@ko ;
    sf:reason "Wrong switching, back-feed or induced voltage can re-energise the line. The earth only carries the fault current; if your body is touching a conductor at that moment, you are still at risk."@en ;
    sf:appliesRule sf:Rule08 ;
    aipd:hasRisk sf:HazardShock ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:pole_lift .
sf:pole_cover_x1 a sf:UnsafeChoice ;
    rdfs:label "정전·접지를 했으니 방호관 없이 바로 작업한다"@ko ;
    rdfs:label "It is dead and earthed, so start without covers"@en ;
    sf:explanation "오조작·역송전·유도전압으로 다시 전기가 올 수 있습니다. 몸이 닿을 수 있는 중성선·인접 상은 방호합니다. (수칙 8)"@ko ;
    sf:explanation "Wrong switching, back-feed or induced voltage can bring the line back. Cover the neutral and adjacent phase within reach. (Rule 8)"@en ;
    sf:mistakeAt sf:pole_cover ;
    sf:violates sf:Rule08 .
sf:pole_cover_x2 a sf:UnsafeChoice ;
    rdfs:label "방호관 대신 몸을 피해서 조심히 작업한다"@ko ;
    rdfs:label "Skip the hoses and just be careful not to touch"@en ;
    sf:explanation "작업에 집중하면 몸의 위치를 놓칩니다. \"조심\"은 방호가 아닙니다. (수칙 8)"@ko ;
    sf:explanation "Focused on the task, you lose track of your body. Care is not cover. (Rule 8)"@en ;
    sf:mistakeAt sf:pole_cover ;
    sf:violates sf:Rule08 .
sf:pole_lift a sf:WorkStep ;
    sf:inScenario sf:Scenario_pole ;
    sf:stepId "lift" ;
    sf:stepNo 12 ;
    rdfs:label "인양물 고정 · 하부 출입금지"@ko ;
    rdfs:label "Secure the load · nobody beneath it"@en ;
    sf:instruction "새 애자·완금을 버킷 지브 훅으로 올립니다. 훅 해지장치를 확인하고 유도 로프를 단 뒤, 지상 작업자는 낙하 반경 밖에서 로프만 잡습니다. 낡은 자재도 같은 방법으로 내립니다."@ko ;
    sf:instruction "The new insulators and crossarm go up on the jib hook. Check the hook latch and attach a tag line; the ground worker holds only the tag line, outside the drop radius. The old parts come down the same way."@en ;
    sf:reason "매단 자재는 언제든 떨어질 수 있다고 봅니다. 아래에 사람이 없으면 떨어져도 사고가 아닙니다."@ko ;
    sf:reason "Assume a hanging load can drop at any moment. If nobody is under it, a drop is not an injury."@en ;
    sf:appliesRule sf:Rule06 ;
    aipd:hasRisk sf:HazardStruck ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleGroundWorkerDriver ;
    sf:inWorkflow pam:WF_05 ;
    aipd:inStage aipd:Stage_Execute ;
    aipd:precedes sf:pole_finish .
sf:pole_lift_x1 a sf:UnsafeChoice ;
    rdfs:label "빨리 받으려고 지상 작업자가 인양물 바로 아래에서 기다린다"@ko ;
    rdfs:label "The ground worker waits right under the load to grab it"@en ;
    sf:explanation "훅·슬링이 풀리면 바로 아래 사람이 맞습니다. 유도 로프로 낙하 반경 밖에서 잡습니다. (수칙 6)"@ko ;
    sf:explanation "If the hook or sling lets go, whoever is underneath is hit. Use a tag line from outside the radius. (Rule 6)"@en ;
    sf:mistakeAt sf:pole_lift ;
    sf:violates sf:Rule06 .
sf:pole_lift_x2 a sf:UnsafeChoice ;
    rdfs:label "해지장치가 고장 난 훅에 자재를 걸어 그대로 올린다"@ko ;
    rdfs:label "Lift on a hook whose safety latch is broken"@en ;
    sf:explanation "해지장치가 없으면 흔들릴 때 슬링이 빠집니다. 고정장치를 확인한 뒤 올립니다. (수칙 6)"@ko ;
    sf:explanation "Without a latch the sling can jump off when it swings. Check the securing device first. (Rule 6)"@en ;
    sf:mistakeAt sf:pole_lift ;
    sf:violates sf:Rule06 .
sf:pole_finish a sf:WorkStep ;
    sf:inScenario sf:Scenario_pole ;
    sf:stepId "finish" ;
    sf:stepNo 13 ;
    rdfs:label "작업 완료 · 역순 철수 (방호 → 접지 → 개폐기 투입)"@ko ;
    rdfs:label "Finish · tear down in reverse (cover → earth → switch)"@en ;
    sf:instruction "방호관 제거 → 버킷 하강·하차 → 접지 제거(선로 측 먼저, 대지측 나중) → 인원·공구 확인 후 개폐기 투입 → 아웃트리거·고임목·라바콘 회수 → 유도자 신호로 출발."@ko ;
    sf:instruction "Remove hoses → lower and leave the bucket → remove the earth (line end first, earth end last) → count people and tools, then close the switch → stow outriggers, chocks, cones → leave under the guide’s signal."@en ;
    sf:reason "송전 전 인원·접지 확인을 빠뜨리면 접지를 단 채 송전하거나 작업자가 남은 상태로 송전합니다."@ko ;
    sf:reason "Skip the count and you may re-energise with the earth on or a worker still on the line."@en ;
    sf:appliesRule sf:Rule08 ;
    sf:appliesRule sf:Rule05 ;
    sf:appliesRule sf:Rule02 ;
    sf:appliesRule sf:Rule04 ;
    aipd:hasRisk sf:HazardShock ;
    aipd:hasRisk sf:HazardVehicle ;
    aipd:hasRisk sf:HazardStruck ;
    aipd:hasRisk sf:HazardRollaway ;
    aipd:hasRisk sf:HazardTipOver ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleGroundWorkerDriver ;
    sf:involves sf:RoleTestingEarthing ;
    sf:involves sf:RoleSignaller ;
    sf:inWorkflow pam:WF_07 ;
    aipd:inStage aipd:Stage_Close .
sf:pole_finish_x1 a sf:UnsafeChoice ;
    rdfs:label "작업이 끝났으니 접지를 단 채로 먼저 개폐기를 투입한다"@ko ;
    rdfs:label "Work is done — close the switch first, remove the earth later"@en ;
    sf:explanation "접지를 단 채 송전하면 지락·아크 사고가 납니다. 접지 제거와 인원 확인 후에 송전합니다. (수칙 8)"@ko ;
    sf:explanation "Re-energising into an earth causes a fault and arc. Remove earths and count people first. (Rule 8)"@en ;
    sf:mistakeAt sf:pole_finish ;
    sf:violates sf:Rule08 .
sf:pole_finish_x2 a sf:UnsafeChoice ;
    rdfs:label "붐을 올린 채로 아웃트리거부터 거둔다"@ko ;
    rdfs:label "Retract the outriggers while the boom is still up"@en ;
    sf:explanation "붐이 펼쳐진 상태에서 아웃트리거를 거두면 바로 전도됩니다. 붐 수납이 먼저입니다. (수칙 4)"@ko ;
    sf:explanation "Retracting with the boom out tips the truck immediately. Stow the boom first. (Rule 4)"@en ;
    sf:mistakeAt sf:pole_finish ;
    sf:violates sf:Rule04 .
sf:Scenario_tx a sf:WorkScenario ;
    sf:scenarioId "tx" ;
    rdfs:label "배전 변압기 교체 (COS 개방, 본선 활선)"@ko ;
    rdfs:label "Distribution: replace a pole transformer (cut-out open, main line live)"@en .
sf:AS_TR_P0021 a pam:TransformerAsset ;
    pam:code "AS-TR-P0021" ;
    rdfs:label "주상변압기 (분기선 2, 가상)"@ko ;
    rdfs:label "Pole transformer on branch 2 (virtual)"@en ;
    pam:installedAt ex:_c8cfbc2d-15f4-5ce1-9862-3e1a8efb577d .
sf:Scenario_tx sf:targetAsset sf:AS_TR_P0021 ;
    sf:maintenanceTask pam:MT_10 ;
