sf:tx_tbm a sf:WorkStep ;
    sf:inScenario sf:Scenario_tx ;
    sf:stepId "tbm" ;
    sf:stepNo 1 ;
    rdfs:label "작업 전 TBM · 작업계획서 확인"@ko ;
    rdfs:label "Pre-work TBM · check the work plan"@en ;
    sf:instruction "작업책임자가 작업 내용(0번 전주 주상변압기 교체), COS로 끊는 정전 범위, 계속 살아 있는 본선 고압선, 역할을 설명합니다."@ko ;
    sf:instruction "The supervisor explains the job (replace the pole-mounted transformer on pole 0), the outage limited by the cut-out, the main HV line that stays live, and each role."@en ;
    sf:reason "본선이 살아 있는 작업은 \"어디까지가 죽어 있나\"를 모두가 같게 알아야 합니다."@ko ;
    sf:reason "With the main line still live, everyone must share the same picture of what is dead and what is not."@en ;
    sf:appliesRule sf:Rule03 ;
    aipd:hasRisk sf:HazardMiscoordination ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleGroundWorkerDriver ;
    sf:involves sf:RoleEarthingGroundHelper ;
    sf:involves sf:RoleSignaller ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Plan ;
    aipd:precedes sf:tx_ppe .
sf:tx_tbm_x1 a sf:UnsafeChoice ;
    rdfs:label "변압기만 바꾸는 간단한 작업이니 TBM 없이 시작한다"@ko ;
    rdfs:label "Only a transformer swap — start without a TBM"@en ;
    sf:explanation "본선은 살아 있습니다. 정전 범위를 모르는 사람이 한 명이라도 있으면 감전 사고로 이어집니다. (수칙 3)"@ko ;
    sf:explanation "The main line is live. One person unsure of the outage limits is enough for a shock accident. (Rule 3)"@en ;
    sf:mistakeAt sf:tx_tbm ;
    sf:violates sf:Rule03 .
sf:tx_tbm_x2 a sf:UnsafeChoice ;
    rdfs:label "현장에서 보고 COS 대신 본선을 활선 상태로 작업하기로 바꾼다"@ko ;
    rdfs:label "On site, switch to working the main line live instead of using the cut-out"@en ;
    sf:explanation "공법 임의변경 금지. 계획과 다르게 해야 하면 작업을 멈추고 다시 계획합니다. (수칙 3)"@ko ;
    sf:explanation "No ad-hoc method changes. If the plan does not fit, stop and re-plan. (Rule 3)"@en ;
    sf:mistakeAt sf:tx_tbm ;
    sf:violates sf:Rule03 .
sf:tx_ppe a sf:WorkStep ;
    sf:inScenario sf:Scenario_tx ;
    sf:stepId "ppe" ;
    sf:stepNo 2 ;
    rdfs:label "개인 안전장구 착용"@ko ;
    rdfs:label "Put on personal protective equipment"@en ;
    sf:instruction "안전모(턱끈 체결)·절연장갑·안전화·반사조끼를 착용하고, 버킷 작업자는 그네식 안전대를 맵니다. 작업책임자가 서로의 착용 상태를 확인합니다."@ko ;
    sf:instruction "Hard hat with chin strap, insulating gloves, safety boots, hi-vis vest; the bucket worker puts on a full-body harness. The supervisor checks everyone."@en ;
    sf:reason "장구는 사고가 났을 때 생사를 가르는 마지막 방어선입니다."@ko ;
    sf:reason "PPE is the last line of defence when everything else has failed."@en ;
    sf:appliesRule sf:Rule01 ;
    aipd:hasRisk sf:HazardStruck ;
    aipd:hasRisk sf:HazardShock ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleGroundWorkerDriver ;
    sf:involves sf:RoleEarthingGroundHelper ;
    sf:involves sf:RoleSignaller ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:tx_zone .
sf:tx_ppe_x1 a sf:UnsafeChoice ;
    rdfs:label "지상 작업자는 높은 곳에 안 올라가니 안전모를 쓰지 않는다"@ko ;
    rdfs:label "Ground workers stay low, so they skip the hard hat"@en ;
    sf:explanation "지상 작업자는 위에서 떨어지는 공구·자재에 가장 많이 다칩니다. (수칙 1)"@ko ;
    sf:explanation "Ground workers are the ones hit by dropped tools and parts. (Rule 1)"@en ;
    sf:mistakeAt sf:tx_ppe ;
    sf:violates sf:Rule01 .
sf:tx_ppe_x2 a sf:UnsafeChoice ;
    rdfs:label "정전 작업이니 절연장갑은 필요 없다"@ko ;
    rdfs:label "It is a dead-line job, so insulating gloves are unnecessary"@en ;
    sf:explanation "검전 전에는 충전 상태로 간주합니다. 역송전·오조작도 있습니다. (수칙 1, 8)"@ko ;
    sf:explanation "Treat it as live until tested; back-feed and wrong switching happen. (Rules 1, 8)"@en ;
    sf:mistakeAt sf:tx_ppe ;
    sf:violates sf:Rule01 ;
    sf:violates sf:Rule08 .
sf:tx_zone a sf:WorkStep ;
    sf:inScenario sf:Scenario_tx ;
    sf:stepId "zone" ;
    sf:stepNo 3 ;
    rdfs:label "작업구역 설정 · 출입금지 · 보행 통로 확보"@ko ;
    rdfs:label "Set up the work zone · keep out · keep a walkway"@en ;
    sf:instruction "라바콘과 안전띠로 작업차·전주 주변을 막아 작업반경 출입을 금지합니다. 보도는 바깥쪽에 보행 통로를 남겨 시민이 작업구역에 들어오지 않게 합니다."@ko ;
    sf:instruction "Cones and tape close off the truck and pole area. A walkway stays open on the outer sidewalk so the public never enters the zone."@en ;
    sf:reason "붐 회전·낙하물 반경 안에 사람이 있으면 아무리 조심해도 사고가 납니다."@ko ;
    sf:reason "Anyone inside the boom-swing or drop radius will eventually be hit."@en ;
    sf:appliesRule sf:Rule05 ;
    aipd:hasRisk sf:HazardVehicle ;
    aipd:hasRisk sf:HazardStruck ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleEarthingGroundHelper ;
    sf:involves sf:RoleSignaller ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:tx_reverse .
sf:tx_zone_x1 a sf:UnsafeChoice ;
    rdfs:label "작업이 금방 끝나니 라바콘 없이 시작한다"@ko ;
    rdfs:label "It will be quick — start without cones"@en ;
    sf:explanation "작업 시간과 상관없이 붐 회전·낙하 반경 안으로 사람·차량이 들어옵니다. (수칙 5)"@ko ;
    sf:explanation "Short or not, people and cars wander into the swing and drop radius. (Rule 5)"@en ;
    sf:mistakeAt sf:tx_zone ;
    sf:violates sf:Rule05 .
sf:tx_zone_x2 a sf:UnsafeChoice ;
    rdfs:label "보도 전체를 막고 시민에게 차도로 돌아가라고 한다"@ko ;
    rdfs:label "Close the whole sidewalk and send pedestrians onto the road"@en ;
    sf:explanation "보행자를 차도로 내보내면 교통사고 위험이 생깁니다. 안전한 보행 통로를 남깁니다."@ko ;
    sf:explanation "Sending pedestrians into traffic creates a new hazard. Keep a safe walkway."@en ;
    sf:mistakeAt sf:tx_zone ;
    sf:violates sf:Rule05 .
sf:tx_reverse a sf:WorkStep ;
    sf:inScenario sf:Scenario_tx ;
    sf:stepId "reverse" ;
    sf:stepNo 4 ;
    rdfs:label "작업차 진입 · 후진 시 전담 유도자"@ko ;
    rdfs:label "Bring in the truck · dedicated guide when reversing"@en ;
    sf:instruction "운전원이 작업차를 전주 옆으로 몰고 와 후진으로 위치를 맞춥니다. 신호수(전담 유도자)는 운전석에서 보이는 차량 뒤쪽 옆에 서서 신호봉으로 유도하고, 운전원은 유도자가 보이지 않으면 즉시 멈춥니다."@ko ;
    sf:instruction "The driver brings the truck alongside the pole and reverses into position. The dedicated guide stands behind and to the side, visible from the cab, signalling with a baton; if the guide is out of sight the driver stops."@en ;
    sf:reason "후진 차량의 사각지대는 차량 뒤 수 m에 이릅니다. 끼임·충돌 사고의 대표 원인입니다."@ko ;
    sf:reason "A reversing truck has a blind zone several metres long — a top cause of crush and strike accidents."@en ;
    sf:appliesRule sf:Rule05 ;
    aipd:hasRisk sf:HazardVehicle ;
    aipd:hasRisk sf:HazardStruck ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleGroundWorkerDriver ;
    sf:involves sf:RoleSignaller ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:tx_chocks .
sf:tx_reverse_x1 a sf:UnsafeChoice ;
    rdfs:label "후사경과 후방카메라만 보고 혼자 후진한다"@ko ;
    rdfs:label "Reverse alone using mirrors and the rear camera"@en ;
    sf:explanation "카메라·거울에는 사각지대가 있습니다. 후진 시에는 반드시 전담 유도자를 배치합니다. (수칙 5)"@ko ;
    sf:explanation "Mirrors and cameras have blind spots. Reversing needs a dedicated guide. (Rule 5)"@en ;
    sf:mistakeAt sf:tx_reverse ;
    sf:violates sf:Rule05 .
sf:tx_reverse_x2 a sf:UnsafeChoice ;
    rdfs:label "유도자가 차량 바로 뒤 가운데에 서서 신호한다"@ko ;
    rdfs:label "The guide stands directly behind the truck, in the middle"@en ;
    sf:explanation "차량 바로 뒤는 운전석에서 보이지 않는 끼임 위치입니다. 운전원이 볼 수 있는 옆쪽에 섭니다."@ko ;
    sf:explanation "Dead centre behind is invisible from the cab and a crush point. Stand to the side, in view."@en ;
    sf:mistakeAt sf:tx_reverse ;
    sf:violates sf:Rule05 .
sf:tx_chocks a sf:WorkStep ;
    sf:inScenario sf:Scenario_tx ;
    sf:stepId "chocks" ;
    sf:stepNo 5 ;
    rdfs:label "고임목 4개 이상 설치"@ko ;
    rdfs:label "Place 4 or more wheel chocks"@en ;
    sf:instruction "주차 브레이크를 채운 뒤 앞·뒤 바퀴 양쪽에 고임목을 받쳐 차량이 밀리지 않게 합니다."@ko ;
    sf:instruction "With the parking brake on, chock front and rear wheels on both sides so the truck cannot roll."@en ;
    sf:reason "붐을 올리면 무게중심이 바뀌어 경사가 거의 없는 도로에서도 차량이 밀릴 수 있습니다."@ko ;
    sf:reason "Raising the boom shifts the centre of gravity; even a gentle slope can make the truck creep."@en ;
    sf:appliesRule sf:Rule02 ;
    aipd:hasRisk sf:HazardRollaway ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleGroundWorkerDriver ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:tx_outrig .
sf:tx_chocks_x1 a sf:UnsafeChoice ;
    rdfs:label "평지이니 고임목 없이 주차 브레이크만 채운다"@ko ;
    rdfs:label "The road is flat, so the parking brake is enough"@en ;
    sf:explanation "붐 하중으로 무게중심이 바뀌면 브레이크만으로는 밀림을 막지 못합니다. (수칙 2)"@ko ;
    sf:explanation "Boom loads shift the centre of gravity; the brake alone will not stop creep. (Rule 2)"@en ;
    sf:mistakeAt sf:tx_chocks ;
    sf:violates sf:Rule02 .
sf:tx_chocks_x2 a sf:UnsafeChoice ;
    rdfs:label "뒷바퀴 한쪽에만 고임목 2개를 받친다"@ko ;
    rdfs:label "Put two chocks under one rear wheel only"@en ;
    sf:explanation "앞·뒤 양쪽 4개 이상을 받쳐야 어느 방향으로도 밀리지 않습니다. (수칙 2)"@ko ;
    sf:explanation "Four or more, front and rear on both sides, stop movement in any direction. (Rule 2)"@en ;
    sf:mistakeAt sf:tx_chocks ;
    sf:violates sf:Rule02 .
sf:tx_outrig a sf:WorkStep ;
    sf:inScenario sf:Scenario_tx ;
    sf:stepId "outrig" ;
    sf:stepNo 6 ;
    rdfs:label "아웃트리거 전개 · 받침판 설치 (전도방지)"@ko ;
    rdfs:label "Deploy outriggers on pads (anti-tip)"@en ;
    sf:instruction "받침판을 깔고 아웃트리거를 끝까지 펼쳐 바퀴가 들릴 정도로 차체를 받칩니다. 수평계로 기울기를 확인합니다."@ko ;
    sf:instruction "Lay outrigger pads, extend the outriggers fully and take the weight off the wheels. Check the level gauge."@en ;
    sf:reason "아웃트리거를 덜 펴거나 연약지반에 그대로 내리면 붐이 기울 때 차량이 넘어갑니다."@ko ;
    sf:reason "Half-extended outriggers, or feet on soft ground, let the truck roll over when the boom leans out."@en ;
    sf:appliesRule sf:Rule04 ;
    aipd:hasRisk sf:HazardTipOver ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleGroundWorkerDriver ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:tx_cos .
sf:tx_outrig_x1 a sf:UnsafeChoice ;
    rdfs:label "자리가 좁으니 아웃트리거를 반만 펴고 작업한다"@ko ;
    rdfs:label "Space is tight — extend the outriggers halfway"@en ;
    sf:explanation "반만 펴면 전도 한계가 크게 줄어듭니다. 공간이 없으면 작업 위치·방법을 다시 정합니다. (수칙 4)"@ko ;
    sf:explanation "Half extension slashes the tip limit. If there is no room, re-plan the position or method. (Rule 4)"@en ;
    sf:mistakeAt sf:tx_outrig ;
    sf:violates sf:Rule04 .
sf:tx_outrig_x2 a sf:UnsafeChoice ;
    rdfs:label "받침판 없이 보도블록 위에 아웃트리거를 바로 내린다"@ko ;
    rdfs:label "Lower the outriggers straight onto paving blocks, no pads"@en ;
    sf:explanation "보도블록·맨홀 뚜껑·연약지반은 꺼질 수 있습니다. 받침판으로 하중을 분산합니다. (수칙 4)"@ko ;
    sf:explanation "Paving, covers and soft ground can sink. Pads spread the load. (Rule 4)"@en ;
    sf:mistakeAt sf:tx_outrig ;
    sf:violates sf:Rule04 .
sf:tx_cos a sf:WorkStep ;
    sf:inScenario sf:Scenario_tx ;
    sf:stepId "cos" ;
    sf:stepNo 7 ;
    rdfs:label "COS 개방 — 절연 조작봉 · 조작금지 표찰"@ko ;
    rdfs:label "Open the cut-out (COS) with a hot stick · tag it"@en ;
    sf:instruction "작업책임자가 절연장갑을 끼고 절연 조작봉으로 변압기 1차측 COS(컷아웃 스위치)를 열고 \"조작금지\" 표찰을 겁니다. 본선은 살아 있으므로 몸은 충분히 떨어져 있습니다."@ko ;
    sf:instruction "Wearing insulating gloves, the supervisor opens the transformer's cut-out with an insulated hot stick and tags it. The main line is live, so the body stays well clear."@en ;
    sf:reason "COS는 충전부 바로 옆에 있습니다. 맨손·일반 막대로 조작하면 아크·감전 사고가 납니다."@ko ;
    sf:reason "The cut-out sits right next to live parts. Bare hands or improvised poles mean arc flash and shock."@en ;
    sf:appliesRule sf:Rule11 ;
    aipd:hasRisk sf:HazardShock ;
    aipd:hasRisk sf:HazardArc ;
    sf:involves sf:RoleSupervisor ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:tx_harness .
sf:tx_cos_x1 a sf:UnsafeChoice ;
    rdfs:label "COS 퓨즈홀더를 장갑 낀 손으로 당겨 연다"@ko ;
    rdfs:label "Pull the fuse holder open with a gloved hand"@en ;
    sf:explanation "COS 투개방은 반드시 적정 공구(절연 조작봉)로 합니다. (수칙 11 배전)"@ko ;
    sf:explanation "Cut-outs are operated only with the proper tool — an insulated hot stick. (Rule 11, distribution)"@en ;
    sf:mistakeAt sf:tx_cos ;
    sf:violates sf:Rule11 .
sf:tx_cos_x2 a sf:UnsafeChoice ;
    rdfs:label "본선 개폐기를 열어 마을 전체를 정전시키고 작업한다"@ko ;
    rdfs:label "Open the main switch and black out the whole area"@en ;
    sf:explanation "계획에 없는 정전 범위 변경입니다. 계획대로 COS로 변압기만 분리합니다. (수칙 3)"@ko ;
    sf:explanation "That is an unplanned change of outage. Isolate only the transformer with its cut-out as planned. (Rule 3)"@en ;
    sf:mistakeAt sf:tx_cos ;
    sf:violates sf:Rule03 .
sf:tx_harness a sf:WorkStep ;
    sf:inScenario sf:Scenario_tx ;
    sf:stepId "harness" ;
    sf:stepNo 8 ;
    rdfs:label "안전대 안전고리 체결 → 버킷 상승"@ko ;
    rdfs:label "Clip the harness lanyard → raise the bucket"@en ;
    sf:instruction "버킷 작업자가 탑승해 안전고리를 걸고, 작업책임자가 확인한 뒤 버킷을 변압기 아래쪽, 고압선과 떨어진 위치로 올립니다."@ko ;
    sf:instruction "The bucket worker boards and clips in; after the supervisor checks, the bucket rises to a spot below the transformer and well clear of the HV line."@en ;
    sf:reason "고리를 걸지 않은 안전대는 소용이 없습니다. 붐이 움직일 때 가장 많이 흔들립니다."@ko ;
    sf:reason "An unclipped harness does nothing, and the bucket jolts most when the boom starts."@en ;
    sf:appliesRule sf:Rule07 ;
    aipd:hasRisk sf:HazardFall ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:tx_txearth .
sf:tx_harness_x1 a sf:UnsafeChoice ;
    rdfs:label "버킷 안이니 안전고리는 위에 올라가서 건다"@ko ;
    rdfs:label "Clip the lanyard once the bucket is up"@en ;
    sf:explanation "붐이 움직이는 순간이 가장 흔들립니다. 탑승 즉시, 상승 전에 체결합니다. (수칙 7)"@ko ;
    sf:explanation "The bucket jolts most when the boom starts. Clip in on boarding, before lifting. (Rule 7)"@en ;
    sf:mistakeAt sf:tx_harness ;
    sf:violates sf:Rule07 .
sf:tx_harness_x2 a sf:UnsafeChoice ;
    rdfs:label "허리에 차는 벨트식 안전대를 쓴다"@ko ;
    rdfs:label "Use a waist-belt type safety belt"@en ;
    sf:explanation "추락을 멈출 때 충격이 허리에 집중됩니다. 그네식(전신) 안전대를 씁니다. (수칙 7, 11)"@ko ;
    sf:explanation "Arresting a fall with a waist belt injures the spine. Use a full-body harness. (Rules 7, 11)"@en ;
    sf:mistakeAt sf:tx_harness ;
    sf:violates sf:Rule07 ;
    sf:violates sf:Rule11 .
sf:tx_txearth a sf:WorkStep ;
    sf:inScenario sf:Scenario_tx ;
    sf:stepId "txearth" ;
    sf:stepNo 9 ;
    rdfs:label "변압기 쪽 검전 → 접지 (대지측 먼저)"@ko ;
    rdfs:label "Test the transformer side → earth it (earth end first)"@en ;
    sf:instruction "지상 보조가 전주 아래에 접지봉을 박아 대지측을 먼저 연결하고, 버킷 작업자가 검전기로 COS 아래쪽·변압기 1차 단자의 무전압을 확인한 뒤 접지 클램프를 겁니다."@ko ;
    sf:instruction "The ground helper drives the earth rod and connects the earth end first; the bucket worker proves the cut-out's load side and the transformer primary dead with a detector, then clamps the earth on."@en ;
    sf:reason "COS가 열렸어도 퓨즈홀더가 덜 빠졌거나 저압측 역송전이 있을 수 있습니다."@ko ;
    sf:reason "An open cut-out can still be half-seated, and back-feed from the low-voltage side is possible."@en ;
    sf:appliesRule sf:Rule08 ;
    aipd:hasRisk sf:HazardShock ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleEarthingGroundHelper ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:tx_hvcover .
sf:tx_txearth_x1 a sf:UnsafeChoice ;
    rdfs:label "COS를 열었으니 검전 없이 바로 변압기 단자를 만진다"@ko ;
    rdfs:label "The cut-out is open — touch the transformer terminals without testing"@en ;
    sf:explanation "덜 빠진 퓨즈홀더, 저압측 역송전으로 살아 있을 수 있습니다. 검전·접지 후 작업합니다. (수칙 8)"@ko ;
    sf:explanation "A half-seated fuse holder or LV back-feed can keep it live. Test and earth first. (Rule 8)"@en ;
    sf:mistakeAt sf:tx_txearth ;
    sf:violates sf:Rule08 .
sf:tx_txearth_x2 a sf:UnsafeChoice ;
    rdfs:label "접지 클램프를 먼저 걸고 접지봉은 나중에 박는다"@ko ;
    rdfs:label "Clamp the earth on first, drive the rod later"@en ;
    sf:explanation "대지측이 먼저 연결되어야 선로가 살아 있어도 사람을 통해 흐르지 않습니다."@ko ;
    sf:explanation "The earth end must be connected first so a live line never discharges through a person."@en ;
    sf:mistakeAt sf:tx_txearth ;
    sf:violates sf:Rule08 .
sf:tx_hvcover a sf:WorkStep ;
    sf:inScenario sf:Scenario_tx ;
    sf:stepId "hvcover" ;
    sf:stepNo 10 ;
    rdfs:label "충전부 방호: 살아 있는 COS 전원측 · 고압 인하선"@ko ;
    rdfs:label "Cover live parts: the cut-out source side and HV drop"@en ;
    sf:instruction "COS 위쪽(전원측)과 고압선에서 내려오는 인하선은 작업 내내 살아 있습니다. 버킷 작업자가 절연봉으로 절연 커버·방호관을 씌우고, 고압선과 1.2m 이상 떨어져 작업합니다."@ko ;
    sf:instruction "The cut-out's source side and the HV drop above it stay live throughout. The bucket worker fits insulating covers with a hot stick and keeps at least 1.2 m from the HV line."@en ;
    sf:reason "같은 전주에 죽은 부분과 산 부분이 함께 있습니다. 몸이 닿을 수 있는 산 부분은 모두 덮습니다."@ko ;
    sf:reason "Dead and live parts share the same pole. Cover every live part your body could reach."@en ;
    sf:appliesRule sf:Rule08 ;
    aipd:hasRisk sf:HazardShock ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:tx_txlift .
sf:tx_hvcover_x1 a sf:UnsafeChoice ;
    rdfs:label "COS를 열었으니 전주 위는 전부 정전이라고 보고 작업한다"@ko ;
    rdfs:label "The cut-out is open, so treat the whole pole top as dead"@en ;
    sf:explanation "COS 전원측과 본선은 살아 있습니다. 산 부분은 방호합니다. (수칙 8)"@ko ;
    sf:explanation "The source side and main line are live. Cover live parts. (Rule 8)"@en ;
    sf:mistakeAt sf:tx_hvcover ;
    sf:violates sf:Rule08 .
sf:tx_hvcover_x2 a sf:UnsafeChoice ;
    rdfs:label "방호 커버는 손으로 씌우는 게 빠르다"@ko ;
    rdfs:label "Fitting the covers by hand is quicker"@en ;
    sf:explanation "살아 있는 부분에는 절연봉으로 다가갑니다. 손으로 다가가면 접근한계거리를 넘습니다."@ko ;
    sf:explanation "Approach live parts with a hot stick; reaching by hand breaks the minimum approach distance."@en ;
    sf:mistakeAt sf:tx_hvcover ;
    sf:violates sf:Rule08 .
sf:tx_txlift a sf:WorkStep ;
    sf:inScenario sf:Scenario_tx ;
    sf:stepId "txlift" ;
    sf:stepNo 11 ;
    rdfs:label "변압기 인양 교체 · 인양물 하부 출입금지"@ko ;
    rdfs:label "Swap the transformer on the hook · nobody beneath it"@en ;
    sf:instruction "리드선을 분리하고 헌 변압기를 지브 훅(해지장치 확인)에 걸어 내린 뒤, 새 변압기를 올려 고정·결선합니다. 지상 작업자는 유도 로프만 잡고 낙하 반경 밖에 섭니다."@ko ;
    sf:instruction "Disconnect the leads, lower the old transformer on the latched jib hook, then lift the new one and bolt and connect it. The ground worker holds only the tag line, outside the drop radius."@en ;
    sf:reason "변압기는 수백 kg입니다. 매달린 물건 아래는 언제나 출입금지입니다."@ko ;
    sf:reason "A transformer weighs hundreds of kilograms. Never stand under a suspended load."@en ;
    sf:appliesRule sf:Rule06 ;
    aipd:hasRisk sf:HazardStruck ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleGroundWorkerDriver ;
    sf:inWorkflow pam:WF_05 ;
    aipd:inStage aipd:Stage_Execute ;
    aipd:precedes sf:tx_txfinish .
sf:tx_txlift_x1 a sf:UnsafeChoice ;
    rdfs:label "변압기를 받으려고 지상 작업자가 전주 바로 아래에서 기다린다"@ko ;
    rdfs:label "The ground worker waits right under the pole to receive it"@en ;
    sf:explanation "훅·슬링이 풀리면 수백 kg이 떨어집니다. 유도 로프로 낙하 반경 밖에서 잡습니다. (수칙 6)"@ko ;
    sf:explanation "If the hook or sling lets go, hundreds of kilograms fall. Hold the tag line from outside the radius. (Rule 6)"@en ;
    sf:mistakeAt sf:tx_txlift ;
    sf:violates sf:Rule06 .
sf:tx_txlift_x2 a sf:UnsafeChoice ;
    rdfs:label "해지장치 없는 훅으로 빨리 내린다"@ko ;
    rdfs:label "Lower it fast on a hook without a safety latch"@en ;
    sf:explanation "흔들릴 때 슬링이 빠집니다. 고정장치를 확인한 뒤 인양합니다. (수칙 6)"@ko ;
    sf:explanation "The sling jumps off when it swings. Check the securing device first. (Rule 6)"@en ;
    sf:mistakeAt sf:tx_txlift ;
    sf:violates sf:Rule06 .
sf:tx_txfinish a sf:WorkStep ;
    sf:inScenario sf:Scenario_tx ;
    sf:stepId "txfinish" ;
    sf:stepNo 12 ;
    rdfs:label "작업 완료 · 역순 철수 (방호·접지 제거 → COS 투입)"@ko ;
    rdfs:label "Finish · tear down in reverse (covers & earth off → close the cut-out)"@en ;
    sf:instruction "방호 커버 제거 → 접지 제거(선로 측 먼저, 대지측 나중) → 버킷 하강·하차 → 인원 확인 후 절연 조작봉으로 COS 투입 → 저압 전압 확인 → 아웃트리거·고임목·라바콘 회수."@ko ;
    sf:instruction "Covers off → earth off (line end first, earth end last) → bucket down, worker out → after a headcount, close the cut-out with a hot stick → check the LV voltage → outriggers, chocks and cones in."@en ;
    sf:reason "접지를 단 채 COS를 넣으면 단락·아크가 납니다. 사람이 위에 있을 때 넣어서도 안 됩니다."@ko ;
    sf:reason "Closing the cut-out into an earth causes a fault and arc — and never with someone still aloft."@en ;
    sf:appliesRule sf:Rule08 ;
    sf:appliesRule sf:Rule11 ;
    sf:appliesRule sf:Rule05 ;
    aipd:hasRisk sf:HazardShock ;
    aipd:hasRisk sf:HazardArc ;
    aipd:hasRisk sf:HazardVehicle ;
    aipd:hasRisk sf:HazardStruck ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleGroundWorkerDriver ;
    sf:involves sf:RoleEarthingGroundHelper ;
    sf:involves sf:RoleSignaller ;
    sf:inWorkflow pam:WF_07 ;
    aipd:inStage aipd:Stage_Close .
sf:tx_txfinish_x1 a sf:UnsafeChoice ;
    rdfs:label "끝났으니 접지를 단 채로 먼저 COS를 넣어 본다"@ko ;
    rdfs:label "Done — close the cut-out first, remove the earth later"@en ;
    sf:explanation "접지에 바로 전기를 넣는 단락입니다. 접지 제거·인원 확인 후 투입합니다. (수칙 8)"@ko ;
    sf:explanation "That energises straight into the earth. Remove earths and count people first. (Rule 8)"@en ;
    sf:mistakeAt sf:tx_txfinish ;
    sf:violates sf:Rule08 .
sf:tx_txfinish_x2 a sf:UnsafeChoice ;
    rdfs:label "버킷에 작업자가 있는 채로 COS를 넣는다"@ko ;
    rdfs:label "Close the cut-out with the worker still in the bucket"@en ;
    sf:explanation "결선이 잘못됐으면 위에 있는 사람이 위험합니다. 모두 내려온 뒤 투입합니다."@ko ;
    sf:explanation "If a connection is wrong, whoever is aloft is at risk. Close only when everyone is down."@en ;
    sf:mistakeAt sf:tx_txfinish ;
    sf:violates sf:Rule08 ;
    sf:violates sf:Rule11 ;
    sf:violates sf:Rule05 .
sf:Scenario_wire a sf:WorkScenario ;
    sf:scenarioId "wire" ;
    rdfs:label "가공 배전 전선 교체 · 한 경간 (정전 작업)"@ko ;
    rdfs:label "Overhead line: replace the wire in one span (de-energised)"@en .
sf:AS_WR_0602 a sf:WireAsset ;
    pam:code "AS-WR-0602" ;
    rdfs:label "D/L #1 6구간 가공 전선 · 0↔35번 전주 한 경간 (가상)"@ko ;
    rdfs:label "Overhead conductors, one span (poles 0 to 35) on D/L #1 section 6 (virtual)"@en ;
    pam:installedAt ex:_756664b6-b373-5677-98ab-854ba7714b9f .
sf:Scenario_wire sf:targetAsset sf:AS_WR_0602 ;
    sf:maintenanceTask pam:MT_09 ;
    sf:workSection ex:_756664b6-b373-5677-98ab-854ba7714b9f ;
    sf:isolatedBy ex:_a1e1b903-48f9-5256-8862-92c891050074 ;
    sf:lineDeEnergised true ;
    sf:firstStep sf:wire_tbm .
sf:wire_tbm a sf:WorkStep ;
    sf:inScenario sf:Scenario_wire ;
    sf:stepId "tbm" ;
    sf:stepNo 1 ;
    rdfs:label "작업 전 TBM · 작업계획서 확인 (구간, 전선 규격, 이도 기준표)"@ko ;
    rdfs:label "Pre-work TBM · check the plan (section, conductor, sag table)"@en ;
    sf:instruction "작업책임자가 작업계획서로 작업 구간(0번 ↔ 35번 전주 한 경간), 교체할 전선 규격, 정전 구간, 현재 기온에 맞는 목표 이도, 각자 역할을 설명합니다. 계획서에 없는 방법으로 바꾸지 않습니다."@ko ;
    sf:instruction "The supervisor walks the crew through the plan: the span (pole 0 to pole 35), the new conductor, the outage section, the target sag for today's temperature and each role. No method outside the plan."@en ;
    sf:reason "전선 교체는 장비·인원이 양쪽 전주와 지상에 흩어져 하는 작업이라, 신호와 역할이 어긋나면 한 사람의 실수가 곧바로 사고가 됩니다."@ko ;
    sf:reason "Wire replacement spreads people and machines over two poles and the ground; a mismatch in signals or roles turns one slip into an accident."@en ;
    sf:appliesRule sf:Rule03 ;
    aipd:hasRisk sf:HazardMiscoordination ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleGroundWorkerTruckDriver ;
    sf:involves sf:RoleTruckDriverTestingEarthing ;
    sf:involves sf:RoleSignaller ;
    sf:involves sf:RoleBucketLineworker ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Plan ;
    aipd:precedes sf:wire_ppe .
sf:wire_tbm_x1 a sf:UnsafeChoice ;
    rdfs:label "경험이 많으니 계획서 없이 평소 하던 순서대로 시작한다"@ko ;
    rdfs:label "We are experienced — start in the usual order without the plan"@en ;
    sf:explanation "작업 구간과 정전 범위, 목표 이도를 모두가 같게 알고 있어야 합니다. 경험은 TBM을 생략할 이유가 아닙니다. (수칙 3)"@ko ;
    sf:explanation "Everyone must hold the same idea of the span, outage and target sag. Experience is no reason to skip the TBM. (Rule 3)"@en ;
    sf:mistakeAt sf:wire_tbm ;
    sf:violates sf:Rule03 .
sf:wire_tbm_x2 a sf:UnsafeChoice ;
    rdfs:label "이도는 현장에서 눈대중으로 맞추기로 하고 기준표는 보지 않는다"@ko ;
    rdfs:label "Judge the sag by eye on site; skip the table"@en ;
    sf:explanation "이도는 기온에 따라 달라지는 시공 품질 기준입니다. 계획서의 기준표로 맞춥니다. (수칙 3)"@ko ;
    sf:explanation "Sag is a quality limit that changes with temperature. Use the table in the plan. (Rule 3)"@en ;
    sf:mistakeAt sf:wire_tbm ;
    sf:violates sf:Rule03 .
sf:wire_ppe a sf:WorkStep ;
    sf:inScenario sf:Scenario_wire ;
    sf:stepId "ppe" ;
    sf:stepNo 2 ;
    rdfs:label "개인 안전장구 착용"@ko ;
    rdfs:label "Put on personal protective equipment"@en ;
    sf:instruction "안전모(턱끈 체결)·절연장갑·안전화·반사조끼를 착용하고, 버킷 작업자는 그네식 안전대를 맵니다. 작업책임자가 서로의 착용 상태를 확인합니다."@ko ;
    sf:instruction "Hard hat with chin strap, insulating gloves, safety boots, hi-vis vest; the bucket worker puts on a full-body harness. The supervisor checks everyone."@en ;
    sf:reason "장구는 사고가 났을 때 생사를 가르는 마지막 방어선입니다."@ko ;
    sf:reason "PPE is the last line of defence when everything else has failed."@en ;
    sf:appliesRule sf:Rule01 ;
    aipd:hasRisk sf:HazardStruck ;
    aipd:hasRisk sf:HazardShock ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleGroundWorkerTruckDriver ;
    sf:involves sf:RoleTruckDriverTestingEarthing ;
    sf:involves sf:RoleSignaller ;
    sf:involves sf:RoleBucketLineworker ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:wire_zone .
sf:wire_ppe_x1 a sf:UnsafeChoice ;
    rdfs:label "지상 작업자는 높은 곳에 안 올라가니 안전모를 쓰지 않는다"@ko ;
    rdfs:label "Ground workers stay low, so they skip the hard hat"@en ;
    sf:explanation "지상 작업자는 위에서 떨어지는 공구·자재에 가장 많이 다칩니다. (수칙 1)"@ko ;
    sf:explanation "Ground workers are the ones hit by dropped tools and parts. (Rule 1)"@en ;
    sf:mistakeAt sf:wire_ppe ;
    sf:violates sf:Rule01 .
sf:wire_ppe_x2 a sf:UnsafeChoice ;
    rdfs:label "정전 작업이니 절연장갑은 필요 없다"@ko ;
    rdfs:label "It is a dead-line job, so insulating gloves are unnecessary"@en ;
    sf:explanation "검전 전에는 충전 상태로 간주합니다. 역송전·오조작도 있습니다. (수칙 1, 8)"@ko ;
    sf:explanation "Treat it as live until tested; back-feed and wrong switching happen. (Rules 1, 8)"@en ;
    sf:mistakeAt sf:wire_ppe ;
    sf:violates sf:Rule01 ;
    sf:violates sf:Rule08 .
sf:wire_zone a sf:WorkStep ;
    sf:inScenario sf:Scenario_wire ;
    sf:stepId "zone" ;
    sf:stepNo 3 ;
    rdfs:label "작업구역 설정 · 한 경간 아래 출입금지 · 보행 통로 확보"@ko ;
    rdfs:label "Set up the work zone · keep out under the span · keep a walkway"@en ;
    sf:instruction "전선을 끌어당기는 동안 전선이 처지거나 튈 수 있는 한 경간 전체와 양쪽 작업차 주변을 라바콘과 안전띠로 막습니다. 보도 바깥쪽에 보행 통로를 남겨 시민이 작업구역에 들어오지 않게 합니다."@ko ;
    sf:instruction "Cones and tape close off the whole span, where wire may sag or whip while it is pulled, and the area around both trucks. A walkway stays open on the outer sidewalk."@en ;
    sf:reason "당기는 전선은 갑자기 걸리거나 끊어지면 반동으로 튑니다. 구간 아래에 사람이 있으면 피할 수 없습니다."@ko ;
    sf:reason "A wire under tension that snags or breaks whips back. Anyone under the span cannot get out of the way."@en ;
    sf:appliesRule sf:Rule05 ;
    aipd:hasRisk sf:HazardVehicle ;
    aipd:hasRisk sf:HazardStruck ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleTruckDriverTestingEarthing ;
    sf:involves sf:RoleSignaller ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:wire_trucks .
sf:wire_zone_x1 a sf:UnsafeChoice ;
    rdfs:label "전주 두 곳 주변만 막고 경간 가운데는 열어 둔다"@ko ;
    rdfs:label "Block only around the two poles and leave mid-span open"@en ;
    sf:explanation "전선이 처지고 튀는 곳은 전주 주변이 아니라 한 경간 전체입니다. (수칙 5)"@ko ;
    sf:explanation "The wire sags and whips along the whole span, not just at the poles. (Rule 5)"@en ;
    sf:mistakeAt sf:wire_zone ;
    sf:violates sf:Rule05 .
sf:wire_zone_x2 a sf:UnsafeChoice ;
    rdfs:label "시민이 많이 다니니 견인은 퇴근 시간 뒤로 미루고 구역은 느슨하게 둔다"@ko ;
    rdfs:label "The sidewalk is busy — keep the zone loose and pull later"@en ;
    sf:explanation "통행량 때문에 구역을 느슨하게 두면 안 됩니다. 구역은 그대로 막고 보행 통로를 안전하게 따로 둡니다. (수칙 5)"@ko ;
    sf:explanation "Heavy foot traffic is no reason for a loose zone. Close it properly and keep a separate safe walkway. (Rule 5)"@en ;
    sf:mistakeAt sf:wire_zone ;
    sf:violates sf:Rule05 .
sf:wire_trucks a sf:WorkStep ;
    sf:inScenario sf:Scenario_wire ;
    sf:stepId "trucks" ;
    sf:stepNo 4 ;
    rdfs:label "작업차 두 대 진입 · 후진은 전담 유도자"@ko ;
    rdfs:label "Bring in both trucks · dedicated guide when reversing"@en ;
    sf:instruction "2호차가 먼저 35번 전주까지 전진해 정차하고, 1호차가 이어서 0번 전주 옆으로 와 후진으로 자리를 맞춥니다. 신호수(전담 유도자)는 운전석에서 보이는 옆쪽에 서서 신호봉으로 유도합니다."@ko ;
    sf:instruction "Truck 2 drives ahead to pole 35 and stops; truck 1 follows and reverses into place at pole 0. The dedicated guide stands to the side, in the driver's view, with a baton."@en ;
    sf:reason "작업차가 두 대면 차량끼리, 차량과 사람 사이의 사각지대가 둘이 됩니다. 후진은 반드시 유도자 신호에 따릅니다."@ko ;
    sf:reason "Two trucks mean two sets of blind spots. Reversing always follows the guide's signal."@en ;
    sf:appliesRule sf:Rule05 ;
    aipd:hasRisk sf:HazardVehicle ;
    aipd:hasRisk sf:HazardStruck ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleGroundWorkerTruckDriver ;
    sf:involves sf:RoleTruckDriverTestingEarthing ;
    sf:involves sf:RoleSignaller ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:wire_chocks .
sf:wire_trucks_x1 a sf:UnsafeChoice ;
    rdfs:label "두 대 모두 운전원이 후사경만 보고 각자 알아서 자리를 잡는다"@ko ;
    rdfs:label "Both drivers set up on their own, using mirrors only"@en ;
    sf:explanation "후진에는 전담 유도자가 있어야 하고, 두 대가 같은 차로를 쓰면 순서도 정해야 합니다. (수칙 5)"@ko ;
    sf:explanation "Reversing needs a dedicated guide, and two trucks in one lane need an agreed order. (Rule 5)"@en ;
    sf:mistakeAt sf:wire_trucks ;
    sf:violates sf:Rule05 .
sf:wire_trucks_x2 a sf:UnsafeChoice ;
    rdfs:label "유도자가 두 차 사이에 서서 양쪽 차를 한꺼번에 유도한다"@ko ;
    rdfs:label "The guide stands between the trucks and signals both at once"@en ;
    sf:explanation "차 사이는 끼임 위치입니다. 차마다 운전원이 볼 수 있는 옆쪽에 서서 한 대씩 유도합니다. (수칙 5)"@ko ;
    sf:explanation "Between two trucks is a crush point. Guide one truck at a time from a visible spot at its side. (Rule 5)"@en ;
    sf:mistakeAt sf:wire_trucks ;
    sf:violates sf:Rule05 .
sf:wire_chocks a sf:WorkStep ;
    sf:inScenario sf:Scenario_wire ;
    sf:stepId "chocks" ;
    sf:stepNo 5 ;
    rdfs:label "두 작업차 모두 고임목 4개 이상 설치"@ko ;
    rdfs:label "Chock both trucks (4 or more each)"@en ;
    sf:instruction "1호차와 2호차 각각 주차 브레이크를 채우고 앞·뒤 바퀴 양쪽에 고임목을 받쳐 차량이 밀리지 않게 합니다."@ko ;
    sf:instruction "On each truck, set the parking brake and chock front and rear wheels on both sides."@en ;
    sf:reason "붐을 올리면 무게중심이 바뀌어 평지에서도 차량이 밀릴 수 있습니다. 두 번째 차도 똑같이 합니다."@ko ;
    sf:reason "Raising the boom shifts the centre of gravity, even on flat ground. The second truck is no exception."@en ;
    sf:appliesRule sf:Rule02 ;
    aipd:hasRisk sf:HazardRollaway ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleGroundWorkerTruckDriver ;
    sf:involves sf:RoleTruckDriverTestingEarthing ;
    sf:involves sf:RoleBucketLineworker ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:wire_outrig .
sf:wire_chocks_x1 a sf:UnsafeChoice ;
    rdfs:label "1호차만 고임목을 받치고 2호차는 같은 도로라 생략한다"@ko ;
    rdfs:label "Chock truck 1 only; truck 2 is on the same road"@en ;
    sf:explanation "차량마다 붐 하중이 따로 걸립니다. 작업차 한 대마다 4개 이상입니다. (수칙 2)"@ko ;
    sf:explanation "Each truck carries its own boom load. Every truck needs 4 or more. (Rule 2)"@en ;
    sf:mistakeAt sf:wire_chocks ;
    sf:violates sf:Rule02 .
sf:wire_chocks_x2 a sf:UnsafeChoice ;
    rdfs:label "시간이 없으니 고임목은 버킷을 올린 뒤에 받친다"@ko ;
    rdfs:label "No time — chock after the bucket is up"@en ;
    sf:explanation "붐이 움직이기 시작하면 가장 많이 밀립니다. 올리기 전에 받칩니다. (수칙 2)"@ko ;
    sf:explanation "The truck creeps most as the boom starts to move. Chock before lifting. (Rule 2)"@en ;
    sf:mistakeAt sf:wire_chocks ;
    sf:violates sf:Rule02 .
sf:wire_outrig a sf:WorkStep ;
    sf:inScenario sf:Scenario_wire ;
    sf:stepId "outrig" ;
    sf:stepNo 6 ;
    rdfs:label "두 작업차 아웃트리거 전개 · 받침판 설치 (전도방지)"@ko ;
    rdfs:label "Deploy outriggers on pads, both trucks (anti-tip)"@en ;
    sf:instruction "받침판을 깔고 아웃트리거를 끝까지 펼쳐 차체를 받칩니다. 수평계로 기울기를 확인합니다. 두 대 모두 같은 방법입니다."@ko ;
    sf:instruction "Lay pads, extend the outriggers fully and check the level gauge. Both trucks the same way."@en ;
    sf:reason "아웃트리거가 덜 펴지거나 받침판이 없으면 붐이 기울 때 차량이 넘어갑니다. 전선 장력이 걸리면 더 위험합니다."@ko ;
    sf:reason "Half-extended outriggers or no pads let the truck roll over when the boom leans; wire tension makes it worse."@en ;
    sf:appliesRule sf:Rule04 ;
    aipd:hasRisk sf:HazardTipOver ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleGroundWorkerTruckDriver ;
    sf:involves sf:RoleTruckDriverTestingEarthing ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:wire_switch .
sf:wire_outrig_x1 a sf:UnsafeChoice ;
    rdfs:label "2호차 자리가 좁으니 아웃트리거를 반만 펴고 작업한다"@ko ;
    rdfs:label "Truck 2 has little room — extend halfway"@en ;
    sf:explanation "반만 펴면 전도 한계가 크게 줄어듭니다. 자리가 없으면 위치·방법을 다시 정합니다. (수칙 4)"@ko ;
    sf:explanation "Half extension slashes the tip limit. If there is no room, re-plan the position. (Rule 4)"@en ;
    sf:mistakeAt sf:wire_outrig ;
    sf:violates sf:Rule04 .
sf:wire_outrig_x2 a sf:UnsafeChoice ;
    rdfs:label "받침판 없이 보도블록 위에 바로 내린다"@ko ;
    rdfs:label "Set the feet straight on paving, no pads"@en ;
    sf:explanation "보도블록·맨홀 뚜껑·연약지반은 꺼질 수 있습니다. 받침판으로 하중을 분산합니다. (수칙 4)"@ko ;
    sf:explanation "Paving, covers and soft ground can sink. Pads spread the load. (Rule 4)"@en ;
    sf:mistakeAt sf:wire_outrig ;
    sf:violates sf:Rule04 .
sf:wire_switch a sf:WorkStep ;
    sf:inScenario sf:Scenario_wire ;
    sf:stepId "switch" ;
    sf:stepNo 7 ;
    rdfs:label "개폐기 개방 — 절연 조작봉 사용"@ko ;
    rdfs:label "Open the switch with an insulated hot stick"@en ;
    sf:instruction "작업책임자가 정전 구간 전원측 개폐기(-70 전주)를 절연장갑을 끼고 절연 조작봉으로 개방하고, \"작업 중 조작금지\" 표찰을 겁니다."@ko ;
    sf:instruction "The supervisor opens the source-side switch on pole -70 with insulating gloves and an insulated hot stick, then hangs a \"Do not operate — work in progress\" tag."@en ;
    sf:reason "맨손이나 아무 막대로 조작하면 아크·감전 위험이 있습니다. 표찰이 없으면 다른 사람이 다시 투입할 수 있습니다."@ko ;
    sf:reason "Bare hands or improvised poles risk arc and shock. Without a tag someone may close it again."@en ;
    sf:appliesRule sf:Rule11 ;
    aipd:hasRisk sf:HazardShock ;
    aipd:hasRisk sf:HazardArc ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleTruckDriverTestingEarthing ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:wire_earth .
sf:wire_switch_x1 a sf:UnsafeChoice ;
    rdfs:label "가까이 있는 일반 막대로 개폐기 손잡이를 당긴다"@ko ;
    rdfs:label "Pull the switch handle with any pole lying around"@en ;
    sf:explanation "적정 공구(절연 조작봉)가 아니면 감전·아크에 노출됩니다. (수칙 11 배전)"@ko ;
    sf:explanation "Without the proper insulated tool you are exposed to shock and arc. (Rule 11, distribution)"@en ;
    sf:mistakeAt sf:wire_switch ;
    sf:violates sf:Rule11 .
sf:wire_switch_x2 a sf:UnsafeChoice ;
    rdfs:label "개폐기를 열지 않고 활선 상태로 바로 교체 작업을 한다"@ko ;
    rdfs:label "Skip the switching and replace parts live"@en ;
    sf:explanation "계획은 정전 작업입니다. 활선 작업으로 바꾸는 것은 공법 임의변경입니다. (수칙 3, 8)"@ko ;
    sf:explanation "The plan is dead-line work. Working live is an unauthorised method change. (Rules 3, 8)"@en ;
    sf:mistakeAt sf:wire_switch ;
    sf:violates sf:Rule03 ;
    sf:violates sf:Rule08 .
sf:wire_earth a sf:WorkStep ;
    sf:inScenario sf:Scenario_wire ;
    sf:stepId "earth" ;
    sf:stepNo 8 ;
    rdfs:label "원방 검전 → 접지 (작업 구간에서 한 경간 이상 떨어진 -35 전주)"@ko ;
    rdfs:label "Test, then earth at pole -35 (a span clear of the work)"@en ;
    sf:instruction "-35 전주에서 접지봉을 박고 접지선의 대지측을 먼저 연결합니다. 검전기로 세 상 모두 무전압을 확인한 뒤 접지 클램프를 선로 측에 겁니다."@ko ;
    sf:instruction "At pole -35: drive the earth rod, connect the earth end first, prove all three phases dead with a detector, then clamp the line end."@en ;
    sf:reason "검전 없이 접지하면 충전 선로를 단락시킵니다. 오조작·역송전이 와도 접지가 작업자를 지켜 줍니다."@ko ;
    sf:reason "Earthing a live line is a short circuit. The earth protects you if wrong switching or back-feed comes later."@en ;
    sf:appliesRule sf:Rule08 ;
    aipd:hasRisk sf:HazardShock ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleTruckDriverTestingEarthing ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:wire_harness .
sf:wire_earth_x1 a sf:UnsafeChoice ;
    rdfs:label "개폐기를 열었으니 검전 없이 바로 접지 클램프를 건다"@ko ;
    rdfs:label "The switch is open, so clamp the earth without testing"@en ;
    sf:explanation "다른 전원·오조작으로 살아 있을 수 있습니다. 검전 → 접지 순서는 바꿀 수 없습니다. (수칙 8)"@ko ;
    sf:explanation "Another source or wrong switching may keep it live. Test before earth, always. (Rule 8)"@en ;
    sf:mistakeAt sf:wire_earth ;
    sf:violates sf:Rule08 .
sf:wire_earth_x2 a sf:UnsafeChoice ;
    rdfs:label "작업 구간 양단은 어차피 가까우니 -35 접지만으로 충분하다고 본다"@ko ;
    rdfs:label "-35 is enough; the span ends are close anyway"@en ;
    sf:explanation "원방 접지와 별개로 작업 구간 양단에서도 검전하고 접지합니다. 이어지는 다음 단계들이 그것입니다. (수칙 8)"@ko ;
    sf:explanation "Besides this remote earth, test and earth at both span ends too, which the next steps do. (Rule 8)"@en ;
    sf:mistakeAt sf:wire_earth ;
    sf:violates sf:Rule08 .
sf:wire_harness a sf:WorkStep ;
    sf:inScenario sf:Scenario_wire ;
    sf:stepId "harness" ;
    sf:stepNo 9 ;
    rdfs:label "두 버킷 작업자 안전고리 체결 → 각 전주로 상승"@ko ;
    rdfs:label "Both bucket workers clip in → rise to their poles"@en ;
    sf:instruction "버킷 작업자(0번 쪽 B, 35번 쪽 F)가 버킷에 타 안전대 고리를 걸고, 각 차량의 담당자가 확인한 뒤에 붐을 올립니다. 먼저 충전부와 거리를 둔 위치에 세웁니다."@ko ;
    sf:instruction "Each bucket worker (B at pole 0, F at pole 35) steps in and clips the lanyard; only after the ground person at that truck checks does the boom go up, first to a spot clear of the conductors."@en ;
    sf:reason "고리를 걸지 않은 안전대는 소용이 없습니다. 두 사람 모두, 올라가기 전에 서로 다른 사람이 확인합니다."@ko ;
    sf:reason "An unclipped harness does nothing. A second person checks each worker before lifting."@en ;
    sf:appliesRule sf:Rule07 ;
    aipd:hasRisk sf:HazardFall ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleTruckDriverTestingEarthing ;
    sf:involves sf:RoleBucketLineworker ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:wire_wground .
sf:wire_harness_x1 a sf:UnsafeChoice ;
    rdfs:label "올라가서 안전고리를 걸기로 하고 먼저 상승한다"@ko ;
    rdfs:label "Go up first and clip in at height"@en ;
    sf:explanation "붐이 움직이는 순간이 가장 흔들립니다. 탑승 즉시, 상승 전에 체결합니다. (수칙 7)"@ko ;
    sf:explanation "The bucket jolts most as the boom starts. Clip in on boarding, before lifting. (Rule 7)"@en ;
    sf:mistakeAt sf:wire_harness ;
    sf:violates sf:Rule07 .
sf:wire_harness_x2 a sf:UnsafeChoice ;
    rdfs:label "한 사람이 두 전주를 오가며 안전고리를 확인한다"@ko ;
    rdfs:label "One person checks both workers, walking between the poles"@en ;
    sf:explanation "두 작업차가 35 m 떨어져 있어, 담당자가 자리를 비운 쪽은 확인 없이 올라갑니다. 차량마다 확인자를 둡니다. (수칙 7)"@ko ;
    sf:explanation "The trucks are 35 m apart, so the unattended one goes up unchecked. Each truck has its own checker. (Rule 7)"@en ;
    sf:mistakeAt sf:wire_harness ;
    sf:violates sf:Rule07 .
sf:wire_wground a sf:WorkStep ;
    sf:inScenario sf:Scenario_wire ;
    sf:stepId "wground" ;
    sf:stepNo 10 ;
    rdfs:label "작업 구간 양단 검전 → 접지 (0번 · 35번 전주)"@ko ;
    rdfs:label "Test, then earth at both span ends (poles 0 and 35)"@en ;
    sf:instruction "두 버킷 작업자가 각자 전주에서 세 상을 다시 검전하고, 무전압이면 접지 클램프를 겁니다. 두 전주가 모두 접지되어야 전선을 풀기 시작합니다."@ko ;
    sf:instruction "Each bucket worker re-tests all three phases at their own pole and, if dead, clamps the earth. Only when both poles are earthed does anyone touch the wire."@en ;
    sf:reason "작업 구간 가까이에 다른 전원이나 유도전압이 있을 수 있습니다. 양단 접지는 구간 전체를 같은 전위로 묶어 줍니다."@ko ;
    sf:reason "There may be another source or induced voltage near the span. Earthing both ends ties the whole section to the same potential."@en ;
    sf:appliesRule sf:Rule08 ;
    aipd:hasRisk sf:HazardShock ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleBucketLineworker ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:wire_pulley .
sf:wire_wground_x1 a sf:UnsafeChoice ;
    rdfs:label "한쪽 전주만 접지하고 반대쪽은 전선을 풀면서 접지하기로 한다"@ko ;
    rdfs:label "Earth one pole and earth the other while releasing the wire"@en ;
    sf:explanation "전선을 만지기 전에 양단이 모두 검전·접지되어 있어야 합니다. (수칙 8)"@ko ;
    sf:explanation "Both ends must be tested and earthed before anyone touches the wire. (Rule 8)"@en ;
    sf:mistakeAt sf:wire_wground ;
    sf:violates sf:Rule08 .
sf:wire_wground_x2 a sf:UnsafeChoice ;
    rdfs:label "-35 전주에서 검전했으니 여기서는 검전 없이 접지만 한다"@ko ;
    rdfs:label "Already tested at -35, so just clamp the earths"@en ;
    sf:explanation "작업 위치에서 다시 확인해야 다른 전원이 없음을 알 수 있습니다. (수칙 8)"@ko ;
    sf:explanation "Only a test at the work point proves no other source reaches it. (Rule 8)"@en ;
    sf:mistakeAt sf:wire_wground ;
    sf:violates sf:Rule08 .
sf:wire_pulley a sf:WorkStep ;
    sf:inScenario sf:Scenario_wire ;
    sf:stepId "pulley" ;
    sf:stepNo 11 ;
    rdfs:label "활차(풀리) 설치 — 완금에 세 상 모두"@ko ;
    rdfs:label "Fit the stringing blocks (pulleys) on the crossarm"@en ;
    sf:instruction "버킷을 작업 위치로 올려 각 전주 완금에 활차를 설치합니다. 전선이 애자에서 내려와도 활차 위에서 미끄러지며 지나가도록 하는 장치입니다."@ko ;
    sf:instruction "Raise the bucket to the work position and fit a stringing block on each phase of the crossarm. The wire will ride on it and slide through once it leaves the insulator."@en ;
    sf:reason "활차 없이 전선을 풀면 전선이 완금·전주를 긁어 손상시키고, 끌 때 걸려 튈 수 있습니다."@ko ;
    sf:reason "Without blocks the wire scrapes the arm and pole and can snag and whip when pulled."@en ;
    sf:appliesRule sf:Rule11 ;
    aipd:hasRisk sf:HazardShock ;
    aipd:hasRisk sf:HazardArc ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleBucketLineworker ;
    sf:inWorkflow pam:WF_05 ;
    aipd:inStage aipd:Stage_Execute ;
    aipd:precedes sf:wire_detach .
sf:wire_pulley_x1 a sf:UnsafeChoice ;
    rdfs:label "활차를 건너뛰고 전선을 애자 위에 얹은 채 그대로 끈다"@ko ;
    rdfs:label "Skip the blocks and drag the wire along the insulators"@en ;
    sf:explanation "애자와 완금이 상하고 전선이 걸려 튑니다. 활차를 먼저 설치합니다. (수칙 11 배전)"@ko ;
    sf:explanation "Insulators and arms get damaged and the wire can snag and whip. Fit the blocks first. (Rule 11, distribution)"@en ;
    sf:mistakeAt sf:wire_pulley ;
    sf:violates sf:Rule11 .
sf:wire_pulley_x2 a sf:UnsafeChoice ;
    rdfs:label "활차는 지상에서 던져 올려 전주 위 작업자가 받는다"@ko ;
    rdfs:label "Throw the blocks up from the ground for the worker to catch"@en ;
    sf:explanation "던진 공구는 낙하물이 됩니다. 자재는 버킷에 담거나 인양 로프로 올립니다. (수칙 6)"@ko ;
    sf:explanation "A thrown tool is a falling object. Carry it in the bucket or hoist it on a line. (Rule 6)"@en ;
    sf:mistakeAt sf:wire_pulley ;
    sf:violates sf:Rule06 .
sf:wire_detach a sf:WorkStep ;
    sf:inScenario sf:Scenario_wire ;
    sf:stepId "detach" ;
    sf:stepNo 12 ;
    rdfs:label "구전선 분리 — 바인드를 풀어 활차에 올림"@ko ;
    rdfs:label "Release the old wire: undo the ties and lay it on the blocks"@en ;
    sf:instruction "애자 목에 묶인 바인드선(또는 클램프)을 풀어 구전선을 활차 위로 옮깁니다. 활차에 올라간 전선은 양 끝 전주에서만 지지됩니다."@ko ;
    sf:instruction "Undo the ties (or clamps) on the insulator necks and lift the old wire onto the blocks. It is now held only at the two poles."@en ;
    sf:reason "활차에 올리기 전에 먼저 풀면 전선이 도로·보도 위로 늘어집니다. 활차 설치와 양단 접지가 끝난 뒤에만 합니다."@ko ;
    sf:reason "Release it before it sits on a block and it falls across the road and sidewalk. Only after blocks are fitted and both ends earthed."@en ;
    sf:appliesRule sf:Rule03 ;
    sf:appliesRule sf:Rule08 ;
    aipd:hasRisk sf:HazardMiscoordination ;
    aipd:hasRisk sf:HazardShock ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleBucketLineworker ;
    sf:inWorkflow pam:WF_05 ;
    aipd:inStage aipd:Stage_Execute ;
    aipd:precedes sf:wire_link .
sf:wire_detach_x1 a sf:UnsafeChoice ;
    rdfs:label "전선이 무거우니 한 전주의 바인드만 먼저 풀고 반대쪽은 나중에 푼다"@ko ;
    rdfs:label "Free one pole first and the other later"@en ;
    sf:explanation "한쪽만 풀리면 전선이 다른 쪽 전주를 끌어당깁니다. 양 끝을 함께 활차에 올립니다. (수칙 3)"@ko ;
    sf:explanation "With one end free the wire pulls at the other pole. Move both ends onto the blocks together. (Rule 3)"@en ;
    sf:mistakeAt sf:wire_detach ;
    sf:violates sf:Rule03 .
sf:wire_detach_x2 a sf:UnsafeChoice ;
    rdfs:label "활차 설치가 늦어지니 바인드를 먼저 풀어 두고 활차는 나중에 건다"@ko ;
    rdfs:label "Undo the ties now and fit the blocks later"@en ;
    sf:explanation "활차 없이 풀린 전선은 처져 도로를 덮습니다. 순서는 활차 → 분리입니다. (수칙 3)"@ko ;
    sf:explanation "A freed wire with no block sags over the road. The order is blocks, then release. (Rule 3)"@en ;
    sf:mistakeAt sf:wire_detach ;
    sf:violates sf:Rule03 .
sf:wire_link a sf:WorkStep ;
    sf:inScenario sf:Scenario_wire ;
    sf:stepId "link" ;
    sf:stepNo 13 ;
    rdfs:label "신전선 연결 — 드럼 스탠드, 윈치, 구전선과 신전선 연결"@ko ;
    rdfs:label "Connect the new wire: drum stand, winch, join old and new"@en ;
    sf:instruction "0번 전주 아래에 신전선 드럼을 스탠드에 걸어 제동을 겁니다. 35번 전주 너머에는 윈치를 세우고 구전선 끝을 물립니다. 0번 쪽에서 구전선 끝과 신전선 끝을 연결 그립으로 잇고, 연결부가 활차를 통과할 수 있는지 확인합니다."@ko ;
    sf:instruction "Set the new-wire drum on its stand with the brake on, below pole 0. Set the winch beyond pole 35 and attach the old wire's far end. At pole 0 join the old and new wire ends with a grip and check the joint can pass the blocks."@en ;
    sf:reason "연결 그립이 풀리거나 활차에 걸리면 견인 중에 전선이 튑니다. 견인 전에 연결부를 반드시 확인합니다."@ko ;
    sf:reason "A grip that slips or jams in a block makes the wire whip while pulled. Check the joint before any pull."@en ;
    sf:appliesRule sf:Rule03 ;
    aipd:hasRisk sf:HazardMiscoordination ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleGroundWorkerTruckDriver ;
    sf:involves sf:RoleTruckDriverTestingEarthing ;
    sf:involves sf:RoleBucketLineworker ;
    sf:inWorkflow pam:WF_05 ;
    aipd:inStage aipd:Stage_Execute ;
    aipd:precedes sf:wire_pull .
sf:wire_link_x1 a sf:UnsafeChoice ;
    rdfs:label "연결 그립은 눈으로만 대충 보고 바로 견인을 시작한다"@ko ;
    rdfs:label "Glance at the grip and start pulling"@en ;
    sf:explanation "견인 중 그립이 풀리면 전선이 반동으로 튑니다. 연결부는 손으로 당겨 확인합니다. (수칙 3)"@ko ;
    sf:explanation "A grip that opens under load lets the wire whip back. Pull-test the joint by hand. (Rule 3)"@en ;
    sf:mistakeAt sf:wire_link ;
    sf:violates sf:Rule03 .
sf:wire_link_x2 a sf:UnsafeChoice ;
    rdfs:label "드럼 제동은 견인 중에 필요할 때 걸면 된다"@ko ;
    rdfs:label "Apply the drum brake only when needed during the pull"@en ;
    sf:explanation "드럼이 제멋대로 풀리면 전선이 엉킵니다. 제동은 견인 전에 걸고 속도를 조절합니다. (수칙 11 배전)"@ko ;
    sf:explanation "A free-running drum tangles the wire. Brake first and control the speed. (Rule 11, distribution)"@en ;
    sf:mistakeAt sf:wire_link ;
    sf:violates sf:Rule03 .
sf:wire_pull a sf:WorkStep ;
    sf:inScenario sf:Scenario_wire ;
    sf:stepId "pull" ;
    sf:stepNo 14 ;
    rdfs:label "견인 가선 — 하부 출입금지 · 장력 감시 · 무전 신호"@ko ;
    rdfs:label "Pull the new wire in — keep clear below, watch tension, radio signals"@en ;
    sf:instruction "모든 지상 인원이 경간 아래에서 벗어난 것을 확인한 뒤, 윈치로 구전선을 천천히 당겨 신전선을 끌어옵니다. 버킷 작업자는 활차의 연결부 통과를 지켜보고, 이상이 있으면 무전으로 즉시 정지를 외칩니다."@ko ;
    sf:instruction "Once everyone on the ground is out from under the span, the winch slowly draws the old wire in, pulling the new one through. The bucket workers watch the joint pass each block and call \"stop\" on the radio at any sign of trouble."@en ;
    sf:reason "장력이 걸린 전선이 걸려 끊어지면 채찍처럼 튑니다. 지상 인원이 경간 아래에 없고 정지 신호가 즉시 통해야 합니다."@ko ;
    sf:reason "A wire under tension that snags and breaks whips like a lash. Nobody may be under the span, and a stop call must work at once."@en ;
    sf:appliesRule sf:Rule05 ;
    sf:appliesRule sf:Rule06 ;
    aipd:hasRisk sf:HazardVehicle ;
    aipd:hasRisk sf:HazardStruck ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleGroundWorkerTruckDriver ;
    sf:involves sf:RoleTruckDriverTestingEarthing ;
    sf:involves sf:RoleSignaller ;
    sf:involves sf:RoleBucketLineworker ;
    sf:inWorkflow pam:WF_05 ;
    aipd:inStage aipd:Stage_Execute ;
    aipd:precedes sf:wire_sag .
sf:wire_pull_x1 a sf:UnsafeChoice ;
    rdfs:label "속도를 내려고 지상 작업자가 전선을 따라 걸으며 손으로 잡아 준다"@ko ;
    rdfs:label "Ground workers walk beside the wire and steady it by hand"@en ;
    sf:explanation "전선이 걸려 끊어지면 반동에 맞습니다. 경간 아래 접근 금지, 전선은 활차와 윈치가 지나게 합니다. (수칙 5, 6)"@ko ;
    sf:explanation "If it snags and breaks, whoever is holding it is hit. Nobody under or near the span; let the blocks and winch do it. (Rules 5, 6)"@en ;
    sf:mistakeAt sf:wire_pull ;
    sf:violates sf:Rule05 ;
    sf:violates sf:Rule06 .
sf:wire_pull_x2 a sf:UnsafeChoice ;
    rdfs:label "연결부가 활차를 지나는 순간에도 속도를 줄이지 않는다"@ko ;
    rdfs:label "Keep the speed up as the joint passes the blocks"@en ;
    sf:explanation "연결부는 걸리기 쉬운 곳입니다. 통과할 때는 속도를 늦추고 버킷 작업자가 확인합니다. (수칙 3)"@ko ;
    sf:explanation "The joint is where it jams. Slow down as it passes and let the bucket worker watch it. (Rule 3)"@en ;
    sf:mistakeAt sf:wire_pull ;
    sf:violates sf:Rule03 .
sf:wire_sag a sf:WorkStep ;
    sf:inScenario sf:Scenario_wire ;
    sf:stepId "sag" ;
    sf:stepNo 15 ;
    rdfs:label "이도 조정 — 기온에 맞는 처짐 양으로"@ko ;
    rdfs:label "Adjust the sag to suit the temperature"@en ;
    sf:instruction "새 전선을 당겨 장력을 풀고 처짐(이도)을 계획서 기준표의 목표값에 맞춥니다. 기온이 높으면 전선이 늘어 더 처지게 하고, 낮으면 덜 처지게 합니다. 허용 오차 안에 들어온 뒤에 장력을 고정합니다."@ko ;
    sf:instruction "Slack the new wire off to the sag in the plan table. In warm weather the wire has stretched, so allow more sag; in cold, less. Lock the tension only once it is within tolerance."@en ;
    sf:reason "너무 팽팽하면 겨울에 끊어지거나 전주에 무리가 가고, 너무 처지면 바람에 전선끼리 닿거나 지상고가 모자랍니다."@ko ;
    sf:reason "Too tight and the wire may snap in the cold or overload the pole; too slack and wind brings the wires together or they hang too low."@en ;
    sf:appliesRule sf:Rule03 ;
    sf:appliesRule sf:Rule11 ;
    aipd:hasRisk sf:HazardMiscoordination ;
    aipd:hasRisk sf:HazardShock ;
    aipd:hasRisk sf:HazardArc ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleBucketLineworker ;
    sf:inWorkflow pam:WF_05 ;
    aipd:inStage aipd:Stage_Execute ;
    aipd:precedes sf:wire_tie .
sf:wire_sag_x1 a sf:UnsafeChoice ;
    rdfs:label "여름이든 겨울이든 같은 처짐으로 맞춘다"@ko ;
    rdfs:label "Use the same sag in summer and winter"@en ;
    sf:explanation "전선은 온도에 따라 길이가 변하므로 기온별 기준표의 이도로 맞춥니다. (수칙 3)"@ko ;
    sf:explanation "The wire changes length with temperature, so use the sag for today's temperature from the table. (Rule 3)"@en ;
    sf:mistakeAt sf:wire_sag ;
    sf:violates sf:Rule03 .
sf:wire_sag_x2 a sf:UnsafeChoice ;
    rdfs:label "팽팽할수록 안전하니 최대한 당겨서 고정한다"@ko ;
    rdfs:label "Tighter is safer — pull as hard as possible and lock it"@en ;
    sf:explanation "과장력은 겨울에 전선과 전주를 상하게 합니다. 이도는 클수록도 작을수록도 아닌 기준값입니다. (수칙 3)"@ko ;
    sf:explanation "Over-tension damages wire and pole in the cold. Sag has a target value, neither as big nor as small as possible. (Rule 3)"@en ;
    sf:mistakeAt sf:wire_sag ;
    sf:violates sf:Rule03 .
sf:wire_tie a sf:WorkStep ;
    sf:inScenario sf:Scenario_wire ;
    sf:stepId "tie" ;
    sf:stepNo 16 ;
    rdfs:label "결속 — 이도를 확인한 뒤 애자에 고정"@ko ;
    rdfs:label "Tie in: fix the wire to the insulators once the sag is checked"@en ;
    sf:instruction "이도가 확인되면 활차 위의 전선을 애자 위로 내려 바인드선(또는 클램프)으로 결속합니다. 활차는 아직 떼지 않고 결속이 끝난 뒤에 철거합니다."@ko ;
    sf:instruction "With the sag confirmed, lower the wire from the blocks onto the insulators and tie (or clamp) it. The blocks stay on until the ties are done."@en ;
    sf:reason "이도를 확인하기 전에 고정하면 다시 풀어야 하고, 그동안 전선이 풀린 채 남습니다."@ko ;
    sf:reason "Tie before the sag is checked and it has to be undone, leaving the wire loose meanwhile."@en ;
    sf:appliesRule sf:Rule11 ;
    aipd:hasRisk sf:HazardShock ;
    aipd:hasRisk sf:HazardArc ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleBucketLineworker ;
    sf:inWorkflow pam:WF_05 ;
    aipd:inStage aipd:Stage_Execute ;
    aipd:precedes sf:wire_jumper .
sf:wire_tie_x1 a sf:UnsafeChoice ;
    rdfs:label "이도 확인은 나중에 하기로 하고 일단 애자에 결속한다"@ko ;
    rdfs:label "Tie in first, check the sag later"@en ;
    sf:explanation "결속은 이도 확인 뒤입니다. 순서가 바뀌면 다시 풀고 묶는 동안 위험이 반복됩니다. (수칙 11 배전)"@ko ;
    sf:explanation "Tying comes after the sag check. Reverse it and the risk repeats while you undo and redo. (Rule 11, distribution)"@en ;
    sf:mistakeAt sf:wire_tie ;
    sf:violates sf:Rule11 .
sf:wire_tie_x2 a sf:UnsafeChoice ;
    rdfs:label "활차를 먼저 떼어 내 버리고 그다음에 결속한다"@ko ;
    rdfs:label "Remove the blocks first, then tie in"@en ;
    sf:explanation "활차를 떼면 전선이 아직 고정되지 않은 채로 매달립니다. 결속 뒤에 철거합니다. (수칙 3)"@ko ;
    sf:explanation "Take the blocks off and the wire hangs untied. Remove them after tying in. (Rule 3)"@en ;
    sf:mistakeAt sf:wire_tie ;
    sf:violates sf:Rule03 .
sf:wire_jumper a sf:WorkStep ;
    sf:inScenario sf:Scenario_wire ;
    sf:stepId "jumper" ;
    sf:stepNo 17 ;
    rdfs:label "점퍼선 접속 · 압축 슬리브 작업"@ko ;
    rdfs:label "Connect the jumpers and crimp the sleeves"@en ;
    sf:instruction "전주 위에서 새 전선과 이웃 경간 전선을 점퍼선으로 잇고, 압축 슬리브를 규정 압력으로 압축합니다. 접속 부위를 방호 커버로 덮습니다."@ko ;
    sf:instruction "At the pole top, join the new wire to the next span's wire with jumpers, crimp the sleeves to the specified pressure and cover the joints."@en ;
    sf:reason "접속부는 전선에서 가장 약한 곳입니다. 압축이 부족하면 나중에 발열·단선으로 정전이 납니다."@ko ;
    sf:reason "A joint is the weakest point of a line. An under-crimped sleeve later overheats or breaks and causes an outage."@en ;
    sf:appliesRule sf:Rule11 ;
    aipd:hasRisk sf:HazardShock ;
    aipd:hasRisk sf:HazardArc ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleBucketLineworker ;
    sf:inWorkflow pam:WF_05 ;
    aipd:inStage aipd:Stage_Execute ;
    aipd:precedes sf:wire_remove .
sf:wire_jumper_x1 a sf:UnsafeChoice ;
    rdfs:label "압축기 대신 일반 공구로 슬리브를 조여 둔다"@ko ;
    rdfs:label "Tighten the sleeves with ordinary pliers"@en ;
    sf:explanation "규정 압력으로 압축해야 접속 저항과 강도가 보장됩니다. 적정 공구를 씁니다. (수칙 11 배전)"@ko ;
    sf:explanation "Only a proper crimp at the specified pressure gives the resistance and strength. Use the right tool. (Rule 11, distribution)"@en ;
    sf:mistakeAt sf:wire_jumper ;
    sf:violates sf:Rule11 .
sf:wire_jumper_x2 a sf:UnsafeChoice ;
    rdfs:label "접속 부위는 커버 없이 두어도 전선과 같으니 그대로 둔다"@ko ;
    rdfs:label "Leave the joint uncovered, it is just wire"@en ;
    sf:explanation "접속부는 접촉·부식에 가장 약합니다. 규정대로 커버를 덮습니다. (수칙 11 배전)"@ko ;
    sf:explanation "A joint is most prone to contact and corrosion. Cover it as specified. (Rule 11, distribution)"@en ;
    sf:mistakeAt sf:wire_jumper ;
    sf:violates sf:Rule11 .
sf:wire_remove a sf:WorkStep ;
    sf:inScenario sf:Scenario_wire ;
    sf:stepId "remove" ;
    sf:stepNo 18 ;
    rdfs:label "활차 · 드럼 · 윈치 철거, 공구 회수"@ko ;
    rdfs:label "Take down the blocks, drum and winch; collect the tools"@en ;
    sf:instruction "버킷 작업자가 활차를 떼어 버킷에 담아 내리고, 지상에서는 드럼 스탠드와 윈치를 철거합니다. 전주 위에 남은 공구·바인드 조각이 없는지 확인합니다."@ko ;
    sf:instruction "The bucket workers take the blocks off and carry them down in the bucket. On the ground the drum stand and winch come away. Check nothing is left on the poles."@en ;
    sf:reason "전주 위에 남은 공구나 활차는 송전 뒤 떨어지거나 선로에 닿는 고장 원인이 됩니다."@ko ;
    sf:reason "A tool or block left on a pole falls or touches the line after the power is back on."@en ;
    sf:appliesRule sf:Rule06 ;
    aipd:hasRisk sf:HazardStruck ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleGroundWorkerTruckDriver ;
    sf:involves sf:RoleTruckDriverTestingEarthing ;
    sf:involves sf:RoleBucketLineworker ;
    sf:inWorkflow pam:WF_05 ;
    aipd:inStage aipd:Stage_Execute ;
    aipd:precedes sf:wire_finish .
sf:wire_remove_x1 a sf:UnsafeChoice ;
    rdfs:label "활차는 송전한 뒤에 다음 작업 때 떼기로 하고 그대로 둔다"@ko ;
    rdfs:label "Leave the blocks and take them off on the next job"@en ;
    sf:explanation "활차를 단 채로 송전하면 접촉·낙하 사고가 납니다. 송전 전에 모두 철거합니다. (수칙 8)"@ko ;
    sf:explanation "Energising with rigging still on the line risks contact and drops. Remove everything before power. (Rule 8)"@en ;
    sf:mistakeAt sf:wire_remove ;
    sf:violates sf:Rule08 .
sf:wire_remove_x2 a sf:UnsafeChoice ;
    rdfs:label "공구는 전주 아래로 던져 내리고 나중에 줍는다"@ko ;
    rdfs:label "Throw the tools down and pick them up later"@en ;
    sf:explanation "던진 공구는 낙하물입니다. 버킷에 담아 내립니다. (수칙 6)"@ko ;
    sf:explanation "A thrown tool is a falling object. Bring tools down in the bucket. (Rule 6)"@en ;
    sf:mistakeAt sf:wire_remove ;
    sf:violates sf:Rule06 .
sf:wire_finish a sf:WorkStep ;
    sf:inScenario sf:Scenario_wire ;
    sf:stepId "finish" ;
    sf:stepNo 19 ;
    rdfs:label "작업 완료 · 역순 철수 (양단 접지 해제 → 원방 접지 해제 → 개폐기 투입)"@ko ;
    rdfs:label "Finish · tear down in reverse (span earths → remote earth → switch)"@en ;
    sf:instruction "버킷 작업자가 양단 접지를 풀고(선로 측 먼저, 대지측 나중) 내려옵니다 → -35 전주 접지를 풉니다 → 인원·공구를 확인한 뒤 개폐기를 투입합니다 → 두 작업차의 아웃트리거와 고임목, 라바콘을 회수하고 유도자 신호로 출발합니다."@ko ;
    sf:instruction "The bucket workers remove the span earths (line end first, earth end last) and come down → the earth at -35 is removed → count people and tools, then close the switch → stow outriggers and chocks on both trucks, collect cones and leave under the guide's signal."@en ;
    sf:reason "송전 전에 인원과 접지, 남은 장비를 모두 확인하지 않으면 접지를 단 채 송전하거나 사람이 남은 채 송전합니다."@ko ;
    sf:reason "Skip the count and you may re-energise with an earth on, rigging left on the line or a worker aloft."@en ;
    sf:appliesRule sf:Rule08 ;
    sf:appliesRule sf:Rule05 ;
    sf:appliesRule sf:Rule02 ;
    sf:appliesRule sf:Rule04 ;
    aipd:hasRisk sf:HazardShock ;
    aipd:hasRisk sf:HazardVehicle ;
    aipd:hasRisk sf:HazardStruck ;
    aipd:hasRisk sf:HazardRollaway ;
    aipd:hasRisk sf:HazardTipOver ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleBucketLineworker ;
    sf:involves sf:RoleGroundWorkerTruckDriver ;
    sf:involves sf:RoleTruckDriverTestingEarthing ;
    sf:involves sf:RoleSignaller ;
    sf:involves sf:RoleBucketLineworker ;
    sf:inWorkflow pam:WF_07 ;
    aipd:inStage aipd:Stage_Close .
sf:wire_finish_x1 a sf:UnsafeChoice ;
    rdfs:label "양단 접지를 단 채로 먼저 개폐기를 투입한다"@ko ;
    rdfs:label "Close the switch while the span earths are still on"@en ;
    sf:explanation "접지를 단 채 송전하면 지락·아크 사고가 납니다. 접지 제거와 인원 확인 후에 송전합니다. (수칙 8)"@ko ;
    sf:explanation "Re-energising into an earth causes a fault and arc. Remove earths and count people first. (Rule 8)"@en ;
    sf:mistakeAt sf:wire_finish ;
    sf:violates sf:Rule08 .
sf:wire_finish_x2 a sf:UnsafeChoice ;
    rdfs:label "붐을 올린 채로 아웃트리거부터 거둔다"@ko ;
    rdfs:label "Retract the outriggers while the boom is still up"@en ;
    sf:explanation "붐이 펼쳐진 상태에서 아웃트리거를 거두면 바로 전도됩니다. 붐 수납이 먼저입니다. (수칙 4)"@ko ;
    sf:explanation "Retracting with the boom out tips the truck immediately. Stow the boom first. (Rule 4)"@en ;
    sf:mistakeAt sf:wire_finish ;
    sf:violates sf:Rule04 .
sf:Scenario_manhole a sf:WorkScenario ;
    sf:scenarioId "manhole" ;
    rdfs:label "지중 배전 맨홀 작업 (밀폐공간)"@ko ;
    rdfs:label "Underground: manhole work (confined space)"@en .
sf:AS_UG_0004 a sf:CableAsset ;
    pam:code "AS-UG-0004" ;
    rdfs:label "지중 케이블 (D/L #1 끝 → T4, 가상)"@ko ;
    rdfs:label "Underground cable, D/L #1 end → T4 (virtual)"@en ;
    pam:installedAt ex:_604bcf96-d6de-5322-b795-23b28c1f72b9 .
sf:Scenario_manhole sf:targetAsset sf:AS_UG_0004 ;
    sf:maintenanceTask pam:IN_01 ;
    sf:workSection ex:_604bcf96-d6de-5322-b795-23b28c1f72b9 ;
    sf:firstStep sf:manhole_permit .
sf:manhole_permit a sf:WorkStep ;
    sf:inScenario sf:Scenario_manhole ;
    sf:stepId "permit" ;
    sf:stepNo 1 ;
    rdfs:label "밀폐공간 작업허가서 · TBM"@ko ;
    rdfs:label "Confined-space permit · TBM"@en ;
    sf:instruction "맨홀은 밀폐공간입니다. 작업책임자가 작업허가서(측정·환기·감시인·구조장비·출입 인원)를 확인하고 TBM에서 비상 시 연락·구조 방법까지 정합니다."@ko ;
    sf:instruction "A manhole is a confined space. The supervisor checks the permit — testing, ventilation, attendant, rescue gear, entrants — and the TBM agrees how to call for help and rescue."@en ;
    sf:reason "밀폐공간 사고는 구하러 들어간 사람까지 쓰러지는 연쇄 사고가 많습니다. 허가 절차가 이를 막습니다."@ko ;
    sf:reason "Confined-space accidents often kill the would-be rescuers too. The permit procedure prevents that chain."@en ;
    sf:appliesRule sf:Rule09 ;
    sf:appliesRule sf:Rule03 ;
    aipd:hasRisk sf:HazardAsphyxia ;
    aipd:hasRisk sf:HazardMiscoordination ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleEntrant ;
    sf:involves sf:RoleAttendant ;
    sf:involves sf:RoleGasTestingVentilation ;
    sf:involves sf:RoleSignaller ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Plan ;
    aipd:precedes sf:manhole_mppe .
sf:manhole_permit_x1 a sf:UnsafeChoice ;
    rdfs:label "뚜껑만 열고 잠깐 들어갔다 나오니 허가서는 생략한다"@ko ;
    rdfs:label "It is a quick look inside — skip the permit"@en ;
    sf:explanation "짧은 출입에서도 산소결핍은 몇 번의 호흡만에 의식을 잃게 합니다. (수칙 9)"@ko ;
    sf:explanation "Even a brief entry: oxygen-poor air knocks you out within a few breaths. (Rule 9)"@en ;
    sf:mistakeAt sf:manhole_permit ;
    sf:violates sf:Rule09 .
sf:manhole_permit_x2 a sf:UnsafeChoice ;
    rdfs:label "작업자가 쓰러지면 옆 사람이 바로 들어가 구한다"@ko ;
    rdfs:label "If the entrant collapses, the nearest person goes in to rescue"@en ;
    sf:explanation "준비 없이 들어간 구조자도 같은 공기에 쓰러집니다. 삼각대·윈치로 밖에서 구조합니다."@ko ;
    sf:explanation "An unprepared rescuer breathes the same air and collapses too. Rescue from outside with the tripod winch."@en ;
    sf:mistakeAt sf:manhole_permit ;
    sf:violates sf:Rule09 ;
    sf:violates sf:Rule03 .
sf:manhole_mppe a sf:WorkStep ;
    sf:inScenario sf:Scenario_manhole ;
    sf:stepId "mppe" ;
    sf:stepNo 2 ;
    rdfs:label "개인 안전장구 · 측정기 준비"@ko ;
    rdfs:label "PPE · gas detector ready"@en ;
    sf:instruction "안전모·반사조끼·장갑을 착용하고 입조자는 그네식 안전대를 맵니다. 가스 측정기는 교정 상태와 경보를 확인합니다."@ko ;
    sf:instruction "Hard hats, vests and gloves; the entrant wears a full-body harness. Check the gas detector is calibrated and its alarm works."@en ;
    sf:reason "측정기가 고장이면 \"안전\"이라는 잘못된 숫자를 믿게 됩니다."@ko ;
    sf:reason "A faulty detector gives a false \"safe\"."@en ;
    sf:appliesRule sf:Rule01 ;
    aipd:hasRisk sf:HazardStruck ;
    aipd:hasRisk sf:HazardAsphyxia ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleEntrant ;
    sf:involves sf:RoleAttendant ;
    sf:involves sf:RoleGasTestingVentilation ;
    sf:involves sf:RoleSignaller ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:manhole_mzone .
sf:manhole_mppe_x1 a sf:UnsafeChoice ;
    rdfs:label "측정기 점검은 생략하고 바로 쓴다"@ko ;
    rdfs:label "Use the detector straight away without checking it"@en ;
    sf:explanation "교정이 안 된 측정기는 산소 부족을 정상으로 표시할 수 있습니다. (수칙 9)"@ko ;
    sf:explanation "An uncalibrated detector can show oxygen-poor air as normal. (Rule 9)"@en ;
    sf:mistakeAt sf:manhole_mppe ;
    sf:violates sf:Rule09 .
sf:manhole_mppe_x2 a sf:UnsafeChoice ;
    rdfs:label "입조자도 안전대 없이 사다리로만 오르내린다"@ko ;
    rdfs:label "The entrant uses only the ladder, no harness"@en ;
    sf:explanation "쓰러지면 밖에서 끌어올릴 방법이 없습니다. 안전대와 구명줄이 구조 수단입니다."@ko ;
    sf:explanation "If they collapse there is no way to pull them out. Harness and lifeline are the rescue path."@en ;
    sf:mistakeAt sf:manhole_mppe ;
    sf:violates sf:Rule01 .
sf:manhole_mzone a sf:WorkStep ;
    sf:inScenario sf:Scenario_manhole ;
    sf:stepId "mzone" ;
    sf:stepNo 3 ;
    rdfs:label "맨홀 작업반경 출입금지"@ko ;
    rdfs:label "Keep out of the manhole work radius"@en ;
    sf:instruction "작업 차량과 맨홀을 라바콘으로 둘러싸 차량·보행자가 들어오지 못하게 하고, 신호수가 접근 차량을 유도합니다."@ko ;
    sf:instruction "Cones surround the van and manhole so no vehicle or pedestrian enters; the signaller guides approaching traffic."@en ;
    sf:reason "열린 맨홀은 추락 위험이고, 차로 위 작업자는 차량에 치일 위험이 있습니다."@ko ;
    sf:reason "An open manhole is a fall hazard, and people on the carriageway can be struck by traffic."@en ;
    sf:appliesRule sf:Rule10 ;
    aipd:hasRisk sf:HazardFall ;
    aipd:hasRisk sf:HazardVehicle ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleGasTestingVentilation ;
    sf:involves sf:RoleSignaller ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:manhole_lid .
sf:manhole_mzone_x1 a sf:UnsafeChoice ;
    rdfs:label "맨홀 주변만 막고 작업 차량 주변은 그대로 둔다"@ko ;
    rdfs:label "Cone only the manhole, not the van"@en ;
    sf:explanation "작업자는 차량과 맨홀 사이를 계속 오갑니다. 작업반경 전체를 막습니다. (수칙 10)"@ko ;
    sf:explanation "People walk back and forth between van and manhole. Close the whole work radius. (Rule 10)"@en ;
    sf:mistakeAt sf:manhole_mzone ;
    sf:violates sf:Rule10 .
sf:manhole_mzone_x2 a sf:UnsafeChoice ;
    rdfs:label "지나가는 차가 적으니 라바콘 없이 한다"@ko ;
    rdfs:label "Little traffic — work without cones"@en ;
    sf:explanation "드문 차량일수록 속도가 빠르고 운전자가 작업을 예상하지 못합니다. (수칙 10)"@ko ;
    sf:explanation "Sparse traffic is fast traffic, and drivers do not expect you. (Rule 10)"@en ;
    sf:mistakeAt sf:manhole_mzone ;
    sf:violates sf:Rule10 .
sf:manhole_lid a sf:WorkStep ;
    sf:inScenario sf:Scenario_manhole ;
    sf:stepId "lid" ;
    sf:stepNo 4 ;
    rdfs:label "뚜껑 개방 (전용 공구) · 개구부 방호"@ko ;
    rdfs:label "Open the lid (proper tool) · guard the opening"@en ;
    sf:instruction "맨홀 뚜껑은 전용 개폐 공구로 두 사람이 엽니다. 연 즉시 개구부 주위에 안전 펜스를 세워 추락을 막습니다."@ko ;
    sf:instruction "Two people open the lid with a purpose-made lifter. A guard rail goes around the opening immediately to stop falls."@en ;
    sf:reason "무거운 뚜껑은 손·발 끼임과 허리 부상을, 열린 구멍은 추락을 부릅니다."@ko ;
    sf:reason "Heavy lids crush hands and feet and strain backs; open holes invite falls."@en ;
    sf:appliesRule sf:Rule11 ;
    aipd:hasRisk sf:HazardFall ;
    sf:involves sf:RoleEntrant ;
    sf:involves sf:RoleAttendant ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:manhole_gas1 .
sf:manhole_lid_x1 a sf:UnsafeChoice ;
    rdfs:label "드라이버를 틈에 끼워 한 사람이 들어 올린다"@ko ;
    rdfs:label "Lever it up alone with a screwdriver"@en ;
    sf:explanation "뚜껑이 미끄러지면 손발이 끼입니다. 전용 공구와 2인 작업이 원칙입니다. (수칙 11)"@ko ;
    sf:explanation "If the lid slips it crushes hands and feet. Proper lifter, two people. (Rule 11)"@en ;
    sf:mistakeAt sf:manhole_lid ;
    sf:violates sf:Rule11 .
sf:manhole_lid_x2 a sf:UnsafeChoice ;
    rdfs:label "뚜껑을 연 채 펜스 없이 다른 준비를 한다"@ko ;
    rdfs:label "Leave the hole unguarded while preparing other things"@en ;
    sf:explanation "개구부는 즉시 방호합니다. 작업자 자신도 뒷걸음질하다 떨어집니다. (수칙 11 토목)"@ko ;
    sf:explanation "Guard openings at once — workers step backwards into them too. (Rule 11, civil)"@en ;
    sf:mistakeAt sf:manhole_lid ;
    sf:violates sf:Rule11 .
sf:manhole_gas1 a sf:WorkStep ;
    sf:inScenario sf:Scenario_manhole ;
    sf:stepId "gas1" ;
    sf:stepNo 5 ;
    rdfs:label "산소·유해가스 측정 (들어가기 전)"@ko ;
    rdfs:label "Test oxygen and toxic gas (before entry)"@en ;
    sf:instruction "입구에서 측정기 호스를 내려 위·중간·바닥 세 높이에서 잽니다. 산소 18% 이상 23.5% 미만, 황화수소 10ppm 미만, 일산화탄소 30ppm 미만이어야 들어갈 수 있습니다."@ko ;
    sf:instruction "From the opening, lower the sampling hose and test at top, middle and bottom. Entry needs O₂ 18–23.5 %, H₂S under 10 ppm, CO under 30 ppm."@en ;
    sf:reason "밀폐공간의 공기는 눈으로 알 수 없습니다. 가스는 무겁거나 가벼워 높이마다 다릅니다."@ko ;
    sf:reason "You cannot see bad air, and gases layer by height."@en ;
    sf:appliesRule sf:Rule09 ;
    aipd:hasRisk sf:HazardAsphyxia ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleGasTestingVentilation ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:manhole_vent .
sf:manhole_gas1_x1 a sf:UnsafeChoice ;
    rdfs:label "냄새가 안 나니 측정 없이 들어간다"@ko ;
    rdfs:label "It does not smell, so go in without testing"@en ;
    sf:explanation "산소결핍과 일산화탄소는 냄새가 없고, 황화수소는 고농도에서 후각을 마비시킵니다. (수칙 9)"@ko ;
    sf:explanation "Oxygen deficiency and CO are odourless; high H₂S paralyses the sense of smell. (Rule 9)"@en ;
    sf:mistakeAt sf:manhole_gas1 ;
    sf:violates sf:Rule09 .
sf:manhole_gas1_x2 a sf:UnsafeChoice ;
    rdfs:label "입구에서 한 번만 재고 괜찮으면 들어간다"@ko ;
    rdfs:label "Test once at the opening and go in if it reads fine"@en ;
    sf:explanation "가스는 층을 이룹니다. 바닥까지 여러 높이에서 잽니다. (수칙 9)"@ko ;
    sf:explanation "Gases layer. Test at several heights down to the floor. (Rule 9)"@en ;
    sf:mistakeAt sf:manhole_gas1 ;
    sf:violates sf:Rule09 .
sf:manhole_vent a sf:WorkStep ;
    sf:inScenario sf:Scenario_manhole ;
    sf:stepId "vent" ;
    sf:stepNo 6 ;
    rdfs:label "강제 환기 → 재측정"@ko ;
    rdfs:label "Force-ventilate → re-test"@en ;
    sf:instruction "송풍기로 신선한 공기를 바닥까지 불어 넣고, 다시 측정해 적정 공기를 확인합니다. 환기는 작업이 끝날 때까지 계속합니다. (화면은 시간을 줄여서 보여 줍니다)"@ko ;
    sf:instruction "A blower pushes fresh air to the bottom; re-test to confirm safe air. Ventilation runs until the job is finished. (Time is compressed on screen.)"@en ;
    sf:reason "측정이 한 번 좋아도 작업 중 가스가 다시 나올 수 있어 환기를 멈추지 않습니다."@ko ;
    sf:reason "Gas can build up again during work, so ventilation never stops."@en ;
    sf:appliesRule sf:Rule09 ;
    aipd:hasRisk sf:HazardAsphyxia ;
    sf:involves sf:RoleGasTestingVentilation ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:manhole_watch .
sf:manhole_vent_x1 a sf:UnsafeChoice ;
    rdfs:label "뚜껑을 열어 두었으니 자연 환기로 충분하다"@ko ;
    rdfs:label "The lid is open — natural ventilation is enough"@en ;
    sf:explanation "깊은 맨홀은 자연 환기로 바닥 공기가 바뀌지 않습니다. 송풍기로 강제 환기합니다. (수칙 9)"@ko ;
    sf:explanation "Deep manholes do not clear naturally. Use a blower. (Rule 9)"@en ;
    sf:mistakeAt sf:manhole_vent ;
    sf:violates sf:Rule09 .
sf:manhole_vent_x2 a sf:UnsafeChoice ;
    rdfs:label "환기 후 측정 없이 바로 들어간다"@ko ;
    rdfs:label "Ventilate, then go in without re-testing"@en ;
    sf:explanation "환기가 충분한지는 측정해야만 압니다. (수칙 9)"@ko ;
    sf:explanation "Only a test tells you the ventilation worked. (Rule 9)"@en ;
    sf:mistakeAt sf:manhole_vent ;
    sf:violates sf:Rule09 .
sf:manhole_watch a sf:WorkStep ;
    sf:inScenario sf:Scenario_manhole ;
    sf:stepId "watch" ;
    sf:stepNo 7 ;
    rdfs:label "감시인 배치 · 구조장비(삼각대) 설치"@ko ;
    rdfs:label "Post an attendant · set up rescue tripod"@en ;
    sf:instruction "맨홀 위에 삼각대와 윈치를 세우고, 감시인은 입구에서 작업자와 계속 연락하며 자리를 떠나지 않습니다."@ko ;
    sf:instruction "A tripod and winch go over the opening; the attendant stays at the entrance in constant contact and never leaves."@en ;
    sf:reason "안에서 쓰러지면 감시인이 밖에서 바로 끌어올릴 수 있어야 합니다."@ko ;
    sf:reason "If the entrant collapses, the attendant must be able to winch them out from outside."@en ;
    sf:appliesRule sf:Rule09 ;
    sf:appliesRule sf:Rule10 ;
    aipd:hasRisk sf:HazardAsphyxia ;
    aipd:hasRisk sf:HazardFall ;
    aipd:hasRisk sf:HazardVehicle ;
    sf:involves sf:RoleEntrant ;
    sf:involves sf:RoleAttendant ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:manhole_enter .
sf:manhole_watch_x1 a sf:UnsafeChoice ;
    rdfs:label "감시인도 같이 들어가 작업을 돕는다"@ko ;
    rdfs:label "The attendant goes in to help"@en ;
    sf:explanation "밖에 남은 사람이 없으면 구조할 사람이 없습니다. 감시인은 밖에 있어야 합니다. (수칙 9)"@ko ;
    sf:explanation "With nobody outside, nobody can rescue. The attendant stays out. (Rule 9)"@en ;
    sf:mistakeAt sf:manhole_watch ;
    sf:violates sf:Rule09 .
sf:manhole_watch_x2 a sf:UnsafeChoice ;
    rdfs:label "구조장비는 차에 실어 두고 필요할 때 꺼낸다"@ko ;
    rdfs:label "Keep the rescue gear in the van and fetch it if needed"@en ;
    sf:explanation "산소결핍은 몇 분 안에 생명을 잃게 합니다. 구조장비는 입조 전에 설치합니다."@ko ;
    sf:explanation "Oxygen deficiency kills in minutes. Rig the rescue gear before anyone enters."@en ;
    sf:mistakeAt sf:manhole_watch ;
    sf:violates sf:Rule09 ;
    sf:violates sf:Rule10 .
sf:manhole_enter a sf:WorkStep ;
    sf:inScenario sf:Scenario_manhole ;
    sf:stepId "enter" ;
    sf:stepNo 8 ;
    rdfs:label "입조: 구명줄 체결 · 연속 측정"@ko ;
    rdfs:label "Enter: lifeline clipped · continuous testing"@en ;
    sf:instruction "입조자는 안전대 고리를 삼각대 윈치 줄에 걸고 들어갑니다. 개인 가스 측정기를 차고, 밖에서도 계속 측정하며 감시인은 정해진 간격으로 상태를 확인합니다."@ko ;
    sf:instruction "The entrant clips the harness to the tripod winch line and goes down wearing a personal gas monitor; testing continues outside and the attendant checks in at set intervals."@en ;
    sf:reason "들어갈 때 안전했던 공기도 작업 중 바뀔 수 있습니다."@ko ;
    sf:reason "Air that was safe at entry can change during the job."@en ;
    sf:appliesRule sf:Rule09 ;
    sf:appliesRule sf:Rule07 ;
    aipd:hasRisk sf:HazardAsphyxia ;
    aipd:hasRisk sf:HazardFall ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleEntrant ;
    sf:involves sf:RoleAttendant ;
    sf:involves sf:RoleGasTestingVentilation ;
    sf:inWorkflow pam:WF_05 ;
    aipd:inStage aipd:Stage_Execute ;
    aipd:precedes sf:manhole_mfinish .
sf:manhole_enter_x1 a sf:UnsafeChoice ;
    rdfs:label "입조자 혼자 들어가고 밖의 인원은 다른 일을 한다"@ko ;
    rdfs:label "The entrant goes in alone and everyone else does other work"@en ;
    sf:explanation "밖에서 아무도 지켜보지 않으면 쓰러져도 알 수 없습니다. (수칙 9, 10)"@ko ;
    sf:explanation "With nobody watching, a collapse goes unnoticed. (Rules 9, 10)"@en ;
    sf:mistakeAt sf:manhole_enter ;
    sf:violates sf:Rule09 ;
    sf:violates sf:Rule10 .
sf:manhole_enter_x2 a sf:UnsafeChoice ;
    rdfs:label "송풍기 소음이 시끄러우니 입조 후 끈다"@ko ;
    rdfs:label "The blower is noisy — switch it off once inside"@en ;
    sf:explanation "환기는 작업이 끝날 때까지 계속합니다. (수칙 9)"@ko ;
    sf:explanation "Ventilation runs until the work is finished. (Rule 9)"@en ;
    sf:mistakeAt sf:manhole_enter ;
    sf:violates sf:Rule09 .
sf:manhole_mfinish a sf:WorkStep ;
    sf:inScenario sf:Scenario_manhole ;
    sf:stepId "mfinish" ;
    sf:stepNo 9 ;
    rdfs:label "출조 · 뚜껑 복구 · 철수"@ko ;
    rdfs:label "Exit · close the lid · tear down"@en ;
    sf:instruction "입조자가 나온 것을 인원 확인한 뒤 구명줄을 풀고, 삼각대·펜스를 거두고 뚜껑을 닫습니다. 마지막으로 송풍기와 라바콘을 회수합니다."@ko ;
    sf:instruction "Confirm the entrant is out by headcount, unclip, remove tripod and guard, close the lid; finally collect the blower and cones."@en ;
    sf:reason "사람이 남았는지 확인하지 않고 뚜껑을 닫는 사고를 막기 위해 인원 확인을 먼저 합니다."@ko ;
    sf:reason "Headcount first — lids have been closed on people."@en ;
    sf:appliesRule sf:Rule09 ;
    sf:appliesRule sf:Rule10 ;
    aipd:hasRisk sf:HazardAsphyxia ;
    aipd:hasRisk sf:HazardFall ;
    aipd:hasRisk sf:HazardVehicle ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleEntrant ;
    sf:involves sf:RoleAttendant ;
    sf:involves sf:RoleGasTestingVentilation ;
    sf:involves sf:RoleSignaller ;
    sf:inWorkflow pam:WF_05 ;
    aipd:inStage aipd:Stage_Close .
sf:manhole_mfinish_x1 a sf:UnsafeChoice ;
    rdfs:label "인원 확인 없이 뚜껑부터 닫는다"@ko ;
    rdfs:label "Close the lid before the headcount"@en ;
    sf:explanation "안에 사람이 남아 있을 수 있습니다. 인원 확인이 먼저입니다. (수칙 9)"@ko ;
    sf:explanation "Someone may still be inside. Headcount first. (Rule 9)"@en ;
    sf:mistakeAt sf:manhole_mfinish ;
    sf:violates sf:Rule09 .
sf:manhole_mfinish_x2 a sf:UnsafeChoice ;
    rdfs:label "뚜껑을 닫기 전에 펜스와 라바콘부터 치운다"@ko ;
    rdfs:label "Remove the guard and cones before closing the lid"@en ;
    sf:explanation "열린 구멍이 방호 없이 남습니다. 뚜껑을 닫은 뒤에 펜스·라바콘을 거둡니다. (수칙 10, 11)"@ko ;
    sf:explanation "That leaves an open hole unguarded. Close the lid, then remove guards and cones. (Rules 10, 11)"@en ;
    sf:mistakeAt sf:manhole_mfinish ;
    sf:violates sf:Rule10 ;
    sf:violates sf:Rule11 .
sf:Scenario_tower a sf:WorkScenario ;
    sf:scenarioId "tower" ;
    rdfs:label "송전 철탑 승탑 (추락방지)"@ko ;
    rdfs:label "Transmission: climbing a tower (fall arrest)"@en .
sf:AS_TW_0017 a sf:TowerAsset ;
    pam:code "AS-TW-0017" ;
    rdfs:label "B-A 154kV 송전 철탑 No.17 (가상)"@ko ;
    rdfs:label "B-A 154 kV tower No. 17 (virtual)"@en ;
    pam:installedAt ex:ACLS_1 ;
    sf:carries pam:AS_LN_0031 .
sf:Scenario_tower sf:targetAsset sf:AS_TW_0017 ;
    sf:maintenanceTask pam:IN_01 ;
    sf:firstStep sf:tower_ttbm .
sf:tower_ttbm a sf:WorkStep ;
    sf:inScenario sf:Scenario_tower ;
    sf:stepId "ttbm" ;
    sf:stepNo 1 ;
    rdfs:label "작업 전 TBM · 작업계획서 확인"@ko ;
    rdfs:label "Pre-work TBM · check the work plan"@en ;
    sf:instruction "작업책임자가 작업 내용(철탑 부재·볼트 점검), 승탑 경로와 추락방지 설비, 낙하물 위험 구역, 기상(풍속) 조건을 설명합니다."@ko ;
    sf:instruction "The supervisor covers the job (tower member and bolt inspection), the climbing route and fall-arrest system, the dropped-object zone and the weather (wind) limits."@en ;
    sf:reason "고소 작업은 한 번의 실수가 생명과 직결됩니다. 오르기 전에 모든 것을 정합니다."@ko ;
    sf:reason "At height one mistake is fatal. Settle everything before anyone climbs."@en ;
    sf:appliesRule sf:Rule03 ;
    aipd:hasRisk sf:HazardMiscoordination ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleClimber ;
    sf:involves sf:RoleGroundHelper ;
    sf:involves sf:RoleSafetyWatcher ;
    sf:involves sf:RoleAccessControl ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Plan ;
    aipd:precedes sf:tower_tppe .
sf:tower_ttbm_x1 a sf:UnsafeChoice ;
    rdfs:label "늘 하던 점검이니 TBM 없이 바로 오른다"@ko ;
    rdfs:label "A routine inspection — climb without a TBM"@en ;
    sf:explanation "익숙한 작업일수록 절차를 건너뛰다 사고가 납니다. (수칙 3)"@ko ;
    sf:explanation "Familiar jobs are exactly where steps get skipped. (Rule 3)"@en ;
    sf:mistakeAt sf:tower_ttbm ;
    sf:violates sf:Rule03 .
sf:tower_ttbm_x2 a sf:UnsafeChoice ;
    rdfs:label "바람이 세도 계획한 날이니 그대로 진행한다"@ko ;
    rdfs:label "Windy, but it is the planned day — carry on"@en ;
    sf:explanation "강풍은 추락·낙하물 위험을 크게 높입니다. 기준을 넘으면 작업을 미룹니다."@ko ;
    sf:explanation "Strong wind multiplies fall and dropped-object risk. Postpone above the limit."@en ;
    sf:mistakeAt sf:tower_ttbm ;
    sf:violates sf:Rule03 .
sf:tower_tppe a sf:WorkStep ;
    sf:inScenario sf:Scenario_tower ;
    sf:stepId "tppe" ;
    sf:stepNo 2 ;
    rdfs:label "개인 안전장구 · 안전그네식 안전대"@ko ;
    rdfs:label "PPE · full-body harness"@en ;
    sf:instruction "안전모(턱끈)·안전화·장갑과 함께 승탑자는 안전그네식(전신) 안전대, 추락방지기, 공구 낙하방지 줄을 착용합니다. 작업책임자가 버클과 고리를 확인합니다."@ko ;
    sf:instruction "Hard hats with chin straps, boots and gloves; the climber also wears a full-body harness, a fall arrester and tool lanyards. The supervisor checks buckles and hooks."@en ;
    sf:reason "송전 철탑에서는 허리 벨트식 안전대를 쓰지 않습니다. 추락을 멈출 때 충격이 몸 전체로 나뉘어야 합니다."@ko ;
    sf:reason "Waist belts are not used on towers; arresting a fall must spread the force over the whole body."@en ;
    sf:appliesRule sf:Rule01 ;
    sf:appliesRule sf:Rule11 ;
    aipd:hasRisk sf:HazardStruck ;
    aipd:hasRisk sf:HazardFall ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleClimber ;
    sf:involves sf:RoleGroundHelper ;
    sf:involves sf:RoleSafetyWatcher ;
    sf:involves sf:RoleAccessControl ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:tower_tzone .
sf:tower_tppe_x1 a sf:UnsafeChoice ;
    rdfs:label "허리에 차는 벨트식 안전대로 오른다"@ko ;
    rdfs:label "Climb with a waist-belt type harness"@en ;
    sf:explanation "철탑 승탑에는 안전그네식 안전대가 필수입니다. (수칙 11 송전)"@ko ;
    sf:explanation "Tower climbing requires a full-body harness. (Rule 11, transmission)"@en ;
    sf:mistakeAt sf:tower_tppe ;
    sf:violates sf:Rule01 ;
    sf:violates sf:Rule11 .
sf:tower_tppe_x2 a sf:UnsafeChoice ;
    rdfs:label "공구는 주머니에 넣고 오른다"@ko ;
    rdfs:label "Put the tools in your pockets and climb"@en ;
    sf:explanation "주머니에서 떨어진 공구는 아래 사람에게 치명적입니다. 낙하방지 줄로 몸에 묶습니다."@ko ;
    sf:explanation "A tool slipping from a pocket can kill someone below. Tether tools to your body."@en ;
    sf:mistakeAt sf:tower_tppe ;
    sf:violates sf:Rule01 ;
    sf:violates sf:Rule11 .
sf:tower_tzone a sf:WorkStep ;
    sf:inScenario sf:Scenario_tower ;
    sf:stepId "tzone" ;
    sf:stepNo 3 ;
    rdfs:label "철탑 주변 낙하물 위험 구역 출입금지"@ko ;
    rdfs:label "Keep out of the dropped-object zone around the tower"@en ;
    sf:instruction "철탑 둘레에 라바콘을 둘러 낙하물 위험 구역을 정하고, 승탑 중에는 지상 인원도 다리 바로 아래에 서지 않습니다."@ko ;
    sf:instruction "Cones ring the tower to mark the dropped-object zone; while someone climbs, the ground crew keeps away from the foot of the leg."@en ;
    sf:reason "수십 m 높이에서 떨어진 볼트 하나도 안전모를 뚫을 수 있습니다."@ko ;
    sf:reason "A single bolt dropped from tens of metres can pierce a hard hat."@en ;
    sf:appliesRule sf:Rule05 ;
    aipd:hasRisk sf:HazardStruck ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleSafetyWatcher ;
    sf:involves sf:RoleAccessControl ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:tower_lifeline .
sf:tower_tzone_x1 a sf:UnsafeChoice ;
    rdfs:label "보조자는 바로 받아 주려고 다리 밑에서 대기한다"@ko ;
    rdfs:label "The helper waits at the leg foot to catch things"@en ;
    sf:explanation "떨어지는 물건을 받으려다 맞습니다. 낙하 반경 밖에서 대기합니다. (수칙 5)"@ko ;
    sf:explanation "Catching dropped objects is how people get hit. Wait outside the zone. (Rule 5)"@en ;
    sf:mistakeAt sf:tower_tzone ;
    sf:violates sf:Rule05 .
sf:tower_tzone_x2 a sf:UnsafeChoice ;
    rdfs:label "들판이라 지나가는 사람이 없으니 구역 표시는 생략한다"@ko ;
    rdfs:label "It is an open field — skip the zone markers"@en ;
    sf:explanation "농민·산책객이 들어올 수 있습니다. 구역은 언제나 표시합니다."@ko ;
    sf:explanation "Farmers and walkers do come by. Always mark the zone."@en ;
    sf:mistakeAt sf:tower_tzone ;
    sf:violates sf:Rule05 .
sf:tower_lifeline a sf:WorkStep ;
    sf:inScenario sf:Scenario_tower ;
    sf:stepId "lifeline" ;
    sf:stepNo 4 ;
    rdfs:label "추락방지 와이어(수직 구명줄) · 추락방지기 점검"@ko ;
    rdfs:label "Inspect the fall-arrest wire and arrester"@en ;
    sf:instruction "승탑자가 철탑 다리의 추락방지 와이어 고정부·장력·손상 여부를 확인하고, 추락방지기를 와이어에 걸어 아래로 당겨 잠기는지 시험합니다."@ko ;
    sf:instruction "The climber checks the fall-arrest wire's anchors, tension and damage, then fits the arrester and tugs it down to prove it locks."@en ;
    sf:reason "추락방지 설비가 고장이면 떨어지는 순간 아무것도 붙잡아 주지 않습니다."@ko ;
    sf:reason "A faulty fall-arrest system holds nothing when you fall."@en ;
    sf:appliesRule sf:Rule11 ;
    aipd:hasRisk sf:HazardFall ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleClimber ;
    sf:involves sf:RoleGroundHelper ;
    sf:inWorkflow pam:WF_04 ;
    aipd:inStage aipd:Stage_Initiate ;
    aipd:precedes sf:tower_climb .
sf:tower_lifeline_x1 a sf:UnsafeChoice ;
    rdfs:label "어제 쓴 설비라서 점검 없이 오른다"@ko ;
    rdfs:label "It was used yesterday — climb without checking"@en ;
    sf:explanation "밤사이 손상·풀림이 생길 수 있습니다. 매번 오르기 전에 점검합니다. (수칙 11 송전)"@ko ;
    sf:explanation "Damage or slack can appear overnight. Inspect before every climb. (Rule 11, transmission)"@en ;
    sf:mistakeAt sf:tower_lifeline ;
    sf:violates sf:Rule11 .
sf:tower_lifeline_x2 a sf:UnsafeChoice ;
    rdfs:label "추락방지 와이어 대신 손으로 볼트를 잡고 오른다"@ko ;
    rdfs:label "Skip the wire and climb holding the step bolts"@en ;
    sf:explanation "철탑 승탑 시 추락방지 와이어 사용은 필수입니다. (수칙 11 송전)"@ko ;
    sf:explanation "Using the fall-arrest wire is mandatory on towers. (Rule 11, transmission)"@en ;
    sf:mistakeAt sf:tower_lifeline ;
    sf:violates sf:Rule11 .
sf:tower_climb a sf:WorkStep ;
    sf:inScenario sf:Scenario_tower ;
    sf:stepId "climb" ;
    sf:stepNo 5 ;
    rdfs:label "추락방지기를 체결하고 승탑"@ko ;
    rdfs:label "Clip the arrester on and climb"@en ;
    sf:instruction "승탑자가 안전대의 추락방지기를 와이어에 체결한 상태로 천천히 오릅니다. 감시자는 아래에서 계속 지켜보고, 아무도 다리 아래로 들어가지 않습니다."@ko ;
    sf:instruction "The climber goes up slowly with the harness arrester on the wire. The watcher stays on him from below, and nobody steps under the leg."@en ;
    sf:reason "승탑 중 미끄러지면 추락방지기가 바로 잠겨 떨어지는 거리를 짧게 막아 줍니다."@ko ;
    sf:reason "If the climber slips, the arrester locks at once and limits the fall."@en ;
    sf:appliesRule sf:Rule11 ;
    sf:appliesRule sf:Rule07 ;
    aipd:hasRisk sf:HazardFall ;
    sf:involves sf:RoleClimber ;
    sf:involves sf:RoleSafetyWatcher ;
    sf:inWorkflow pam:WF_05 ;
    aipd:inStage aipd:Stage_Execute ;
    aipd:precedes sf:tower_tieoff .
sf:tower_climb_x1 a sf:UnsafeChoice ;
    rdfs:label "빨리 오르려고 추락방지기는 작업 위치에서 건다"@ko ;
    rdfs:label "Climb fast and clip the arrester on at the work position"@en ;
    sf:explanation "오르는 동안이 가장 위험합니다. 지상에서 체결한 뒤 오릅니다. (수칙 7, 11)"@ko ;
    sf:explanation "Climbing is the riskiest part. Clip on at ground level before climbing. (Rules 7, 11)"@en ;
    sf:mistakeAt sf:tower_climb ;
    sf:violates sf:Rule07 ;
    sf:violates sf:Rule11 .
sf:tower_climb_x2 a sf:UnsafeChoice ;
    rdfs:label "두 사람이 같은 와이어로 바짝 붙어 함께 오른다"@ko ;
    rdfs:label "Two people climb the same wire close together"@en ;
    sf:explanation "한 사람이 떨어지면 아래 사람을 덮칩니다. 한 번에 한 사람씩 오릅니다."@ko ;
    sf:explanation "If the upper one falls, he takes the lower one with him. One at a time."@en ;
    sf:mistakeAt sf:tower_climb ;
    sf:violates sf:Rule11 ;
    sf:violates sf:Rule07 .
sf:tower_tieoff a sf:WorkStep ;
    sf:inScenario sf:Scenario_tower ;
    sf:stepId "tieoff" ;
    sf:stepNo 6 ;
    rdfs:label "작업 위치 이중 체결 (고리 하나는 항상)"@ko ;
    rdfs:label "Tie off at the work position (always one hook on)"@en ;
    sf:instruction "작업 위치에서 먼저 안전대 고리(랜야드)를 철탑 부재에 건 뒤에 추락방지기를 쉬게 합니다. 공중에서는 어느 순간에도 고리 하나 이상이 걸려 있어야 합니다."@ko ;
    sf:instruction "At the work position the climber first clips the lanyard to a tower member, only then parks the arrester. Aloft, at least one hook is on at every moment."@en ;
    sf:reason "고리를 바꿔 거는 그 몇 초 동안의 추락 사고가 가장 많습니다."@ko ;
    sf:reason "Most falls happen in the few seconds of swapping hooks."@en ;
    sf:appliesRule sf:Rule07 ;
    aipd:hasRisk sf:HazardFall ;
    sf:involves sf:RoleClimber ;
    sf:inWorkflow pam:WF_05 ;
    aipd:inStage aipd:Stage_Execute ;
    aipd:precedes sf:tower_hoist .
sf:tower_tieoff_x1 a sf:UnsafeChoice ;
    rdfs:label "추락방지기를 먼저 풀고 랜야드를 건다"@ko ;
    rdfs:label "Unclip the arrester first, then clip the lanyard"@en ;
    sf:explanation "그 사이 아무것도 걸려 있지 않습니다. 새 고리를 먼저 걸고 헌 고리를 풉니다. (수칙 7)"@ko ;
    sf:explanation "For those seconds nothing holds you. New hook on first, then the old one off. (Rule 7)"@en ;
    sf:mistakeAt sf:tower_tieoff ;
    sf:violates sf:Rule07 .
sf:tower_tieoff_x2 a sf:UnsafeChoice ;
    rdfs:label "발판이 넓으니 작업 위치에서는 고리를 풀고 자유롭게 움직인다"@ko ;
    rdfs:label "The platform is wide — unclip and move freely at the work spot"@en ;
    sf:explanation "발판 위에서도 미끄러짐·돌풍으로 떨어집니다. 고리는 항상 체결합니다. (수칙 7)"@ko ;
    sf:explanation "Slips and gusts happen on platforms too. Stay clipped. (Rule 7)"@en ;
    sf:mistakeAt sf:tower_tieoff ;
    sf:violates sf:Rule07 .
sf:tower_hoist a sf:WorkStep ;
    sf:inScenario sf:Scenario_tower ;
    sf:stepId "hoist" ;
    sf:stepNo 7 ;
    rdfs:label "공구·자재 인양: 달줄 · 하부 출입금지"@ko ;
    rdfs:label "Hoist tools on a hand line · nobody beneath"@en ;
    sf:instruction "공구는 손에 들고 오르지 않고 달줄(도르래)로 올립니다. 지상 보조는 줄 끝을 잡고 낙하 반경 밖에 서며, 매단 가방 아래로는 아무도 들어가지 않습니다."@ko ;
    sf:instruction "Tools go up on a hand line through a pulley, not in the climber's hands. The helper holds the line end outside the drop radius and nobody walks under the bag."@en ;
    sf:reason "올리는 중 매듭이 풀리면 가방이 그대로 떨어집니다."@ko ;
    sf:reason "If the knot slips on the way up, the bag drops straight down."@en ;
    sf:appliesRule sf:Rule06 ;
    aipd:hasRisk sf:HazardStruck ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleClimber ;
    sf:involves sf:RoleGroundHelper ;
    sf:inWorkflow pam:WF_05 ;
    aipd:inStage aipd:Stage_Execute ;
    aipd:precedes sf:tower_twork .
sf:tower_hoist_x1 a sf:UnsafeChoice ;
    rdfs:label "공구를 허리에 차고 한 번에 들고 오른다"@ko ;
    rdfs:label "Carry all the tools up on your belt"@en ;
    sf:explanation "무게 때문에 균형을 잃고, 떨어진 공구는 아래 사람을 칩니다. 달줄로 올립니다. (수칙 6)"@ko ;
    sf:explanation "The weight unbalances you and dropped tools hit people below. Use a hand line. (Rule 6)"@en ;
    sf:mistakeAt sf:tower_hoist ;
    sf:violates sf:Rule06 .
sf:tower_hoist_x2 a sf:UnsafeChoice ;
    rdfs:label "보조자가 가방 바로 아래에서 줄을 당긴다"@ko ;
    rdfs:label "The helper pulls the line standing right under the bag"@en ;
    sf:explanation "매듭이 풀리면 바로 맞습니다. 줄을 비스듬히 끌어 낙하 반경 밖에 섭니다. (수칙 6)"@ko ;
    sf:explanation "If the knot fails he is hit. Pull at an angle from outside the radius. (Rule 6)"@en ;
    sf:mistakeAt sf:tower_hoist ;
    sf:violates sf:Rule06 .
sf:tower_twork a sf:WorkStep ;
    sf:inScenario sf:Scenario_tower ;
    sf:stepId "twork" ;
    sf:stepNo 8 ;
    rdfs:label "작업: 공구 줄 체결 상태로 점검"@ko ;
    rdfs:label "Work with tethered tools"@en ;
    sf:instruction "부재 변형·볼트 풀림을 점검합니다. 공구는 모두 낙하방지 줄로 몸이나 부재에 묶여 있고, 감시자는 무전으로 상태를 확인합니다."@ko ;
    sf:instruction "Inspect members for deformation and loose bolts. Every tool is tethered to the body or the tower; the watcher checks in by radio."@en ;
    sf:reason "작업에 집중하면 손에서 공구가 빠지는 것을 모릅니다."@ko ;
    sf:reason "Concentrating on the job, you do not notice a tool slipping."@en ;
    sf:appliesRule sf:Rule07 ;
    aipd:hasRisk sf:HazardFall ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleClimber ;
    sf:involves sf:RoleSafetyWatcher ;
    sf:inWorkflow pam:WF_05 ;
    aipd:inStage aipd:Stage_Execute ;
    aipd:precedes sf:tower_tdown .
sf:tower_twork_x1 a sf:UnsafeChoice ;
    rdfs:label "줄이 걸리적거려 공구 줄을 풀고 작업한다"@ko ;
    rdfs:label "The tethers get in the way — untie them"@en ;
    sf:explanation "떨어진 공구는 아래 사람에게 흉기가 됩니다. 줄은 항상 묶어 둡니다."@ko ;
    sf:explanation "A dropped tool becomes a weapon for those below. Keep tethers on."@en ;
    sf:mistakeAt sf:tower_twork ;
    sf:violates sf:Rule07 .
sf:tower_twork_x2 a sf:UnsafeChoice ;
    rdfs:label "감시자도 같이 올라가 작업을 돕는다"@ko ;
    rdfs:label "The watcher climbs up to help"@en ;
    sf:explanation "아래에서 상황을 보는 사람이 없어집니다. 감시자는 지상에 남습니다."@ko ;
    sf:explanation "Then nobody watches from below. The watcher stays on the ground."@en ;
    sf:mistakeAt sf:tower_twork ;
    sf:violates sf:Rule07 .
sf:tower_tdown a sf:WorkStep ;
    sf:inScenario sf:Scenario_tower ;
    sf:stepId "tdown" ;
    sf:stepNo 9 ;
    rdfs:label "하강 · 철수 (추락방지기 체결 후 랜야드 해제)"@ko ;
    rdfs:label "Descend and tear down (arrester on before the lanyard comes off)"@en ;
    sf:instruction "공구 가방을 달줄로 먼저 내리고, 추락방지기가 와이어에 걸린 것을 확인한 뒤에 랜야드를 풀고 천천히 내려옵니다. 지상에서 추락방지기를 풀고 라바콘을 거둡니다."@ko ;
    sf:instruction "Lower the tool bag first; make sure the arrester is on the wire, then unclip the lanyard and climb down slowly. Unclip the arrester on the ground and collect the cones."@en ;
    sf:reason "내려올 때도 올라갈 때와 같은 규칙입니다. 지친 상태라 더 위험합니다."@ko ;
    sf:reason "Coming down follows the same rules — and you are more tired."@en ;
    sf:appliesRule sf:Rule07 ;
    sf:appliesRule sf:Rule05 ;
    aipd:hasRisk sf:HazardFall ;
    aipd:hasRisk sf:HazardStruck ;
    sf:involves sf:RoleSupervisor ;
    sf:involves sf:RoleClimber ;
    sf:involves sf:RoleGroundHelper ;
    sf:involves sf:RoleAccessControl ;
    sf:inWorkflow pam:WF_05 ;
    aipd:inStage aipd:Stage_Close .
sf:tower_tdown_x1 a sf:UnsafeChoice ;
    rdfs:label "빨리 내려가려고 랜야드를 먼저 풀고 추락방지기를 건다"@ko ;
    rdfs:label "Unclip the lanyard first, then put the arrester on"@en ;
    sf:explanation "그 순간 아무것도 걸려 있지 않습니다. 언제나 새 고리 먼저. (수칙 7)"@ko ;
    sf:explanation "For that moment nothing holds you. New hook on first, always. (Rule 7)"@en ;
    sf:mistakeAt sf:tower_tdown ;
    sf:violates sf:Rule07 .
sf:tower_tdown_x2 a sf:UnsafeChoice ;
    rdfs:label "공구 가방을 들고 함께 내려온다"@ko ;
    rdfs:label "Climb down carrying the tool bag"@en ;
    sf:explanation "한 손으로 내려오면 균형을 잃습니다. 가방은 달줄로 먼저 내립니다."@ko ;
    sf:explanation "One-handed climbing loses balance. Lower the bag on the line first."@en ;
    sf:mistakeAt sf:tower_tdown ;
    sf:violates sf:Rule07 ;
    sf:violates sf:Rule05 .
